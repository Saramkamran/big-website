---
// ServiceCtaBand — dark band with a faint background image, copy, and an acid CTA.
import Button from './Button.astro';
interface Props { id: string; index?: string; eyebrow?: string; title: string; body: string; image: string; ctaLabel?: string; ctaHref?: string }
const { id, index, eyebrow, title, body, image, ctaLabel = 'Get in Touch', ctaHref = '/contact' } = Astro.props;
---
<section id={id} class="relative bg-ink overflow-hidden">
  <div class="absolute inset-0" aria-hidden="true">
    <img src={image} alt="" class="w-full h-full object-cover opacity-20" loading="lazy" />
    <div class="absolute inset-0 bg-ink/70"></div>
  </div>
  <div class="container-big relative py-20 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-8">
        <div class="flex items-center gap-3 mb-5">
          {index && <span class="font-sans text-xs font-bold tracking-[0.2em] text-white">{index}</span>}
          <span class="h-px w-10 bg-acid"></span>
        </div>
        {eyebrow && <p class="label text-acid mb-4">{eyebrow}</p>}
        <h3 class="font-serif font-normal text-white mb-6" style="font-size: clamp(26px, 2.8vw, 38px); line-height: 1.2;">
          {title}
        </h3>
        <p class="font-sans text-white/80 text-base leading-relaxed max-w-2xl">{body}</p>
      </div>
      <div class="lg:col-span-4 lg:text-right">
        <Button variant="acid" href={ctaHref}>{ctaLabel} →</Button>
      </div>
    </div>
  </div>
</section>
