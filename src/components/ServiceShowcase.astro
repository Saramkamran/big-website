---
// ServiceShowcase — variant engine for what-we-do service sections.
// SHARED FILE: workflow agents must not edit (see design/ILLUSTRATION-SPEC.md §5).
// Each service renders as its own <section id={service.id}> in one of 7 named layouts
// (design/LAYOUT-VARIANTS.md). Anchor ids are targeted by the navbar mega-menu — never change them.
import GeometricPattern from './illustrations/GeometricPattern.astro';

type LayoutVariant = 'split-left' | 'split-right' | 'band' | 'offset-card' | 'emblem' | 'mosaic' | 'ledger';
type Tone = 'paper' | 'mist' | 'ink';
type Motif = 'star8' | 'jali' | 'scallop' | 'girih';

interface SubService { title: string; body: string }
interface ServiceItem {
  id: string;
  title: string;
  body: string;
  subServices?: SubService[];
  layout: LayoutVariant;
  Art: any;              // imported illustration component
  tone?: Tone;           // default 'paper'
  motif?: Motif;         // offset-card pattern strip (default 'girih')
  note?: string;         // optional status pill (e.g. Pensions "In Development")
}
interface Props {
  pillar: string;
  headline: string;
  intro?: string;
  separator?: 'hairline' | 'double-rule' | 'none' | 'ornament' | 'heavy';
  services: ServiceItem[];
}

const { pillar, headline, intro, separator = 'hairline', services } = Astro.props;
const pillarId = pillar.toLowerCase().replace(/\s+/g, '-');

const TONES = {
  paper: { bg: 'bg-paper', head: 'text-ink',   body: 'text-stone',    art: 'text-ink',   rule: 'border-line' },
  mist:  { bg: 'bg-mist',  head: 'text-ink',   body: 'text-stone',    art: 'text-ink',   rule: 'border-line' },
  ink:   { bg: 'bg-ink',   head: 'text-paper', body: 'text-paper/70', art: 'text-paper', rule: 'border-paper/20' },
} as const;
const toneOf = (tone: Tone = 'paper') => TONES[tone];
---

<!-- ── Pillar header ─────────────────────────────────────────────────────── -->
<section class="bg-paper pt-section pb-14" id={pillarId}>
  <div class="container-big">
    <p class="label mb-4">{pillar}</p>
    <h2 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(32px, 4vw, 48px); line-height: 1.1; max-width: 680px;">
      {headline}
    </h2>
    {intro && (
      <p class="font-sans text-base text-stone leading-relaxed max-w-2xl">{intro}</p>
    )}
  </div>
</section>

{services.map((svc, i) => {
  const Art = svc.Art;
  const t = toneOf(svc.tone);
  const prev = i > 0 ? services[i - 1] : null;
  const showSep =
    separator !== 'none' && prev &&
    (prev.tone ?? 'paper') !== 'ink' && (svc.tone ?? 'paper') !== 'ink' &&
    (prev.tone ?? 'paper') === (svc.tone ?? 'paper');
  const ledgerContinues = prev?.layout === 'ledger' && svc.layout === 'ledger';
  const num = String(i + 1).padStart(2, '0');

  return (
    <Fragment>
      {/* ── separator (only between same light-tone neighbours) ── */}
      {showSep && separator === 'hairline' && (
        <div class={t.bg}><div class="container-big"><div class="border-t border-line"></div></div></div>
      )}
      {showSep && separator === 'double-rule' && (
        <div class={t.bg}><div class="container-big"><div class="border-t border-line"></div><div class="border-t border-line mt-1"></div></div></div>
      )}
      {showSep && separator === 'ornament' && (
        <div class={t.bg}><div class="container-big flex items-center gap-6" aria-hidden="true">
          <div class="flex-1 border-t border-line"></div>
          <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5 text-stone" aria-hidden="true" focusable="false">
            <path d="M7.2 7.2 H16.8 V16.8 H7.2 Z" stroke="currentColor" stroke-width="1.3" />
            <path d="M12 4.6 L19.4 12 L12 19.4 L4.6 12 Z" stroke="currentColor" stroke-width="1.3" />
          </svg>
          <div class="flex-1 border-t border-line"></div>
        </div></div>
      )}
      {showSep && separator === 'heavy' && (
        <div class={t.bg}><div class="container-big"><div class="h-1 bg-ink"></div></div></div>
      )}

      {/* ── 1/2 · split-left / split-right ── */}
      {(svc.layout === 'split-left' || svc.layout === 'split-right') && (
        <section id={svc.id} class={t.bg}>
          <div class="container-big py-20 lg:py-24 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
            <div class={`lg:col-span-5 ${svc.layout === 'split-right' ? 'lg:order-2' : ''}`}>
              <div class={`${t.art} lg:sticky lg:top-[calc(var(--header-h)+2rem)]`}>
                <Art class="w-full h-auto max-w-md mx-auto lg:mx-0" />
              </div>
            </div>
            <div class={`lg:col-span-7 ${svc.layout === 'split-right' ? 'lg:order-1' : ''}`}>
              <h3 class={`font-serif font-normal ${t.head} mb-6`} style="font-size: clamp(24px, 2.6vw, 34px); line-height: 1.2;">
                {svc.title}
              </h3>
              <p class={`font-sans text-base ${t.body} leading-relaxed`}>{svc.body}</p>
              {svc.note && (
                <p class="mt-8"><span class="inline-block bg-acid text-ink font-sans text-xs font-semibold uppercase tracking-widest px-4 py-2">{svc.note}</span></p>
              )}
              {svc.subServices && svc.subServices.length > 0 && (
                <div class="space-y-6 mt-8">
                  {svc.subServices.map(sub => (
                    <div class="pl-5 border-l-2 border-acid">
                      <h4 class={`font-sans font-semibold text-sm ${t.head} mb-2`}>{sub.title}</h4>
                      <p class={`font-sans text-sm ${t.body} leading-relaxed`}>{sub.body}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>
      )}

      {/* ── 3 · band ── */}
      {svc.layout === 'band' && (
        <section id={svc.id} class={`${t.bg} relative overflow-hidden`}>
          <div class={`absolute inset-y-0 right-0 w-[62%] ${t.art} opacity-40 pointer-events-none hidden md:block`} aria-hidden="true">
            <Art class="absolute right-[-8%] top-1/2 -translate-y-1/2 h-[110%] w-auto min-w-[560px]" />
          </div>
          <div class="container-big relative py-20 lg:py-28">
            <div class="max-w-3xl">
              <h3 class={`font-serif font-normal ${t.head} mb-6`} style="font-size: clamp(26px, 3vw, 40px); line-height: 1.15;">
                {svc.title}
              </h3>
              <p class={`font-sans text-base ${t.body} leading-relaxed`}>{svc.body}</p>
              {svc.note && (
                <p class="mt-8"><span class="inline-block bg-acid text-ink font-sans text-xs font-semibold uppercase tracking-widest px-4 py-2">{svc.note}</span></p>
              )}
              {svc.subServices && svc.subServices.length > 0 && (
                <div class="space-y-6 mt-8">
                  {svc.subServices.map(sub => (
                    <div class="pl-5 border-l-2 border-acid">
                      <h4 class={`font-sans font-semibold text-sm ${t.head} mb-2`}>{sub.title}</h4>
                      <p class={`font-sans text-sm ${t.body} leading-relaxed`}>{sub.body}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>
      )}

      {/* ── 4 · offset-card ── */}
      {svc.layout === 'offset-card' && (
        <section id={svc.id} class={`${t.bg} relative`}>
          <div class="absolute inset-x-0 top-0 h-72 pointer-events-none" aria-hidden="true">
            <GeometricPattern motif={svc.motif ?? 'girih'} class="w-full h-full text-ink opacity-[0.05]" />
          </div>
          <div class="container-big relative py-20 lg:py-24">
            <div class="relative max-w-4xl">
              <div class={`hidden lg:block absolute -top-8 right-0 w-56 xl:w-64 ${t.art}`} aria-hidden="true">
                <Art class="w-full h-auto" />
              </div>
              <div class="bg-paper border border-line p-8 md:p-12 lg:p-14 lg:mr-44">
                <h3 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(24px, 2.6vw, 34px); line-height: 1.2;">
                  {svc.title}
                </h3>
                <p class="font-sans text-base text-stone leading-relaxed">{svc.body}</p>
                {svc.note && (
                  <p class="mt-8"><span class="inline-block bg-acid text-ink font-sans text-xs font-semibold uppercase tracking-widest px-4 py-2">{svc.note}</span></p>
                )}
                {svc.subServices && svc.subServices.length > 0 && (
                  <div class="space-y-6 mt-8">
                    {svc.subServices.map(sub => (
                      <div class="pl-5 border-l-2 border-acid">
                        <h4 class="font-sans font-semibold text-sm text-ink mb-2">{sub.title}</h4>
                        <p class="font-sans text-sm text-stone leading-relaxed">{sub.body}</p>
                      </div>
                    ))}
                  </div>
                )}
                <div class="lg:hidden mt-10 text-ink" aria-hidden="true">
                  <Art class="w-36 h-auto mx-auto" />
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      {/* ── 5 · emblem ── */}
      {svc.layout === 'emblem' && (
        <section id={svc.id} class={t.bg}>
          <div class="container-big py-20 lg:py-28">
            <div class={`${t.art} mx-auto w-48 md:w-60 mb-10`}>
              <Art class="w-full h-auto" />
            </div>
            <h3 class={`font-serif font-normal ${t.head} text-center mx-auto mb-8`} style="font-size: clamp(26px, 3vw, 40px); line-height: 1.15; max-width: 720px;">
              {svc.title}
            </h3>
            <div class={`max-w-4xl mx-auto lg:columns-2 lg:gap-16 font-sans text-base ${t.body} leading-relaxed`}>
              <p>{svc.body}</p>
            </div>
            {svc.note && (
              <p class="text-center mt-10"><span class="inline-block bg-acid text-ink font-sans text-xs font-semibold uppercase tracking-widest px-4 py-2">{svc.note}</span></p>
            )}
            {svc.subServices && svc.subServices.length > 0 && (
              <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8 mt-10">
                {svc.subServices.map(sub => (
                  <div class="pl-5 border-l-2 border-acid">
                    <h4 class={`font-sans font-semibold text-sm ${t.head} mb-2`}>{sub.title}</h4>
                    <p class={`font-sans text-sm ${t.body} leading-relaxed`}>{sub.body}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )}

      {/* ── 6 · mosaic ── */}
      {svc.layout === 'mosaic' && (
        <section id={svc.id} class={t.bg}>
          <div class="container-big py-20 lg:py-24">
            <div class={`grid grid-cols-1 lg:grid-cols-12 border ${t.rule}`}>
              <div class={`lg:col-span-5 ${t.art} bg-mist/70 p-8 lg:p-12 border-b lg:border-b-0 lg:border-r ${t.rule} flex items-center justify-center`}>
                <Art class="w-full max-w-sm h-auto" />
              </div>
              <div class="lg:col-span-7 flex flex-col">
                <div class={`p-8 lg:p-12 ${svc.subServices?.length ? `border-b ${t.rule}` : ''} flex-1`}>
                  <h3 class={`font-serif font-normal ${t.head} mb-5`} style="font-size: clamp(22px, 2.4vw, 30px); line-height: 1.2;">
                    {svc.title}
                  </h3>
                  <p class={`font-sans text-base ${t.body} leading-relaxed`}>{svc.body}</p>
                  {svc.note && (
                    <p class="mt-6"><span class="inline-block bg-acid text-ink font-sans text-xs font-semibold uppercase tracking-widest px-4 py-2">{svc.note}</span></p>
                  )}
                </div>
                {svc.subServices && svc.subServices.length > 0 && (
                  <div class="grid md:grid-cols-2">
                    {svc.subServices.map((sub, j) => (
                      <div class={`p-8 lg:p-10 ${j % 2 === 0 ? `md:border-r ${t.rule}` : ''} ${j > 0 ? `border-t md:border-t-0 ${t.rule}` : ''}`}>
                        <h4 class={`font-sans font-semibold text-sm ${t.head} mb-3`}>{sub.title}</h4>
                        <p class={`font-sans text-sm ${t.body} leading-relaxed`}>{sub.body}</p>
                      </div>
                    ))}
                  </div>
                )}
              </div>
              <div class="lg:col-span-12 h-1.5 bg-acid"></div>
            </div>
          </div>
        </section>
      )}

      {/* ── 7 · ledger ── */}
      {svc.layout === 'ledger' && (
        <section id={svc.id} class={t.bg}>
          <div class="container-big py-12 lg:py-14">
            <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 items-start ${ledgerContinues ? `border-t ${t.rule} pt-12` : ''}`}>
              <div class={`lg:col-span-2 ${t.art} w-20 lg:w-24`} aria-hidden="true">
                <Art class="w-full h-auto" />
              </div>
              <div class="lg:col-span-2">
                <span class={`font-serif ${t.head} leading-none block`} style="font-size: clamp(48px, 5vw, 72px);">{num}</span>
              </div>
              <div class="lg:col-span-8">
                <h3 class={`font-serif font-normal ${t.head} mb-4`} style="font-size: clamp(22px, 2.4vw, 28px); line-height: 1.2;">
                  {svc.title}
                </h3>
                <p class={`font-sans text-base ${t.body} leading-relaxed`}>{svc.body}</p>
                {svc.note && (
                  <p class="mt-6"><span class="inline-block bg-acid text-ink font-sans text-xs font-semibold uppercase tracking-widest px-4 py-2">{svc.note}</span></p>
                )}
                {svc.subServices && svc.subServices.length > 0 && (
                  <div class="space-y-6 mt-6">
                    {svc.subServices.map(sub => (
                      <div class="pl-5 border-l-2 border-acid">
                        <h4 class={`font-sans font-semibold text-sm ${t.head} mb-2`}>{sub.title}</h4>
                        <p class={`font-sans text-sm ${t.body} leading-relaxed`}>{sub.body}</p>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
      )}
    </Fragment>
  );
})}
