---
// ServiceShowcase — image-led alternating service sections (Goldman-Sachs editorial style).
// Each service renders as its own <section id={service.id}> with a tailored photo on one side
// and heading + copy on the other, alternating sides down the page (mirrors the Home pillars).
// Anchor ids are targeted by the navbar mega-menu — never change them.

interface SubService { title: string; body: string }
interface ServiceItem {
  id: string;
  title: string;
  body: string;
  subServices?: SubService[];
  image: string;      // curated photo URL (remote now; swap to /images/<id>.jpg later)
  imageAlt: string;
  note?: string;      // optional acid status pill (e.g. Pensions "In Development")
}
interface Props {
  pillar: string;
  headline: string;
  intro?: string;
  services: ServiceItem[];
}

const { pillar, headline, intro, services } = Astro.props;
const pillarId = pillar.toLowerCase().replace(/\s+/g, '-');
---

<!-- ── Pillar header ─────────────────────────────────────────────────────── -->
<section class="bg-paper pt-section pb-14" id={pillarId}>
  <div class="container-big">
    <p class="label mb-4">{pillar}</p>
    <h2 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(32px, 4vw, 48px); line-height: 1.1; max-width: 680px;">
      {headline}
    </h2>
    {intro && (
      <p class="font-sans text-base text-stone leading-relaxed max-w-2xl">{intro}</p>
    )}
  </div>
</section>

<!-- ── Alternating image / copy sections ─────────────────────────────────── -->
{services.map((svc, i) => {
  const imageRight = i % 2 === 1;      // zig-zag: even = image left, odd = image right
  const bg = i % 2 === 1 ? 'bg-mist' : 'bg-paper';
  return (
    <section id={svc.id} class={bg}>
      <div class="container-big py-16 lg:py-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
          <!-- Image -->
          <div class={`lg:col-span-6 ${imageRight ? 'lg:order-2' : ''}`}>
            <div class="aspect-[4/3] overflow-hidden bg-line">
              <img
                src={svc.image}
                alt={svc.imageAlt}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
          <!-- Copy -->
          <div class={`lg:col-span-6 ${imageRight ? 'lg:order-1' : ''}`}>
            <h3 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(24px, 2.6vw, 34px); line-height: 1.2;">
              {svc.title}
            </h3>
            <p class="font-sans text-base text-stone leading-relaxed">{svc.body}</p>

            {svc.note && (
              <p class="mt-8">
                <span class="inline-block bg-acid text-ink font-sans text-xs font-semibold uppercase tracking-widest px-4 py-2">{svc.note}</span>
              </p>
            )}

            {svc.subServices && svc.subServices.length > 0 && (
              <div class="space-y-6 mt-8">
                {svc.subServices.map(sub => (
                  <div class="pl-5 border-l-2 border-acid">
                    <h4 class="font-sans font-semibold text-sm text-ink mb-2">{sub.title}</h4>
                    <p class="font-sans text-sm text-stone leading-relaxed">{sub.body}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  );
})}
