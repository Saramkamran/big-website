---
/* Home-page intro: black screen, white Bismillah with the English and Chinese translations
   below. Plays once per browser session, on "/" only.
   BaseLayout's head script adds html.preloader-on (before first paint) only when the path is
   "/" and sessionStorage "bigPreloaderSeen" is unset. Without JS the overlay stays hidden.
   Only the Arabic 400 file of Amiri is imported (no Google Fonts link).
   Timeline (from the first paint of the overlay): Arabic 0.3-1.7s, English 1.6-2.6s,
   Chinese 2.1-3.1s (each fades in and rises 12px); fade-out starts at 4.6s (1s long) once the
   page has loaded and the font is ready, hard cap 8s; whole run 5.6s or longer. */
import '@fontsource/amiri/arabic-400.css';
---

<div id="preloader" class="preloader">
  <p class="preloader__t preloader__ar" lang="ar" dir="rtl">بِسْـــــــــمِ اللهِ الرَّحْمَنِ الرَّحِيمِ</p>
  <p class="preloader__t preloader__en" lang="en">In the name of Allah, the Most Gracious, the Most Merciful</p>
  <p class="preloader__t preloader__zh" lang="zh-Hans">奉至仁至慈的真主之名</p>
</div>

<style is:global>
  /* Hidden unless the head script turned it on. */
  #preloader { display: none; }
  html.preloader-on { overflow: hidden; }
  html.preloader-on #preloader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: #0a0a0a;
    color: #fff;
    text-align: center;
    cursor: pointer;
    opacity: 1;
    transition: opacity 1s ease-in-out;
  }
  html.preloader-on #preloader.is-leaving { opacity: 0; pointer-events: none; }
  /* Click / Escape: a quicker fade-out. */
  html.preloader-on #preloader.is-skip { transition-duration: 0.6s; }

  #preloader p { margin: 0; color: #fff; text-align: center; }

  /* Each line starts invisible, 12px low; .is-play (added after first paint) runs the
     staggered fade + rise. Only opacity and transform are animated. */
  #preloader .preloader__t {
    opacity: 0;
    transform: translateY(12px);
    will-change: opacity, transform;
  }
  #preloader.is-play .preloader__t { opacity: 1; transform: translateY(0); }

  #preloader .preloader__ar {
    font-family: "Amiri", "Noto Naskh Arabic", "Traditional Arabic", serif;
    font-size: clamp(44px, 7vw, 112px);
    line-height: 1.6;
    margin-bottom: 32px;
  }
  #preloader.is-play .preloader__ar {
    transition: opacity 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.3s, transform 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.3s;
  }

  #preloader .preloader__en,
  #preloader .preloader__zh {
    font-size: clamp(18.4px, 1.73vw, 27.6px);
    letter-spacing: 0.02em;
  }
  #preloader .preloader__en { font-family: var(--font-heading); margin-bottom: 12px; }
  #preloader .preloader__zh { font-family: "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif; }
  #preloader.is-play .preloader__en {
    transition: opacity 1s cubic-bezier(0.22, 1, 0.36, 1) 1.6s, transform 1s cubic-bezier(0.22, 1, 0.36, 1) 1.6s;
  }
  #preloader.is-play .preloader__zh {
    transition: opacity 1s cubic-bezier(0.22, 1, 0.36, 1) 2.1s, transform 1s cubic-bezier(0.22, 1, 0.36, 1) 2.1s;
  }

  /* Reduced motion: same timing, opacity fades only (no rise). */
  @media (prefers-reduced-motion: reduce) {
    #preloader .preloader__t,
    #preloader.is-play .preloader__t { transform: none; }
  }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('preloader');
    if (!el) return;
    var root = document.documentElement;

    /* Not the home page, or already seen this session: nothing to play. */
    if (!root.classList.contains('preloader-on')) { el.remove(); return; }

    var HOLD = 4600;   /* earliest start of the fade-out, from first paint */
    var CAP = 8000;    /* start the fade-out anyway if the page still has not loaded */
    var leaving = false;
    var minDone = false;
    var loaded = document.readyState === 'complete';
    var fontReady = !(document.fonts && document.fonts.load);

    function cleanup() {
      root.classList.remove('preloader-on');
      el.setAttribute('aria-hidden', 'true');
      el.remove();
      try { sessionStorage.setItem('bigPreloaderSeen', '1'); } catch (e) {}
    }
    function leave(skip) {
      if (leaving) return;
      leaving = true;
      if (skip) el.classList.add('is-skip');
      el.classList.add('is-leaving');
      setTimeout(cleanup, skip ? 600 : 1000);
    }
    function check() { if (minDone && loaded && fontReady) leave(false); }

    if (!fontReady) {
      var done = function () { fontReady = true; check(); };
      document.fonts.load('1em Amiri').then(done, done);
    }
    if (!loaded) window.addEventListener('load', function () { loaded = true; check(); });

    /* The clock starts once the overlay has actually painted. */
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        el.classList.add('is-play');
        setTimeout(function () { minDone = true; check(); }, HOLD);
        setTimeout(function () { leave(false); }, CAP);
      });
    });

    /* Click or Escape skips straight to the (quicker) fade-out. */
    el.addEventListener('click', function () { leave(true); });
    window.addEventListener('keydown', function (e) { if (e.key === 'Escape') leave(true); });
  })();
</script>
