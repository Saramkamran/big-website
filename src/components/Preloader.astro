---
/* First-visit intro: pitch-black screen, white lettering in Segoe UI Black (falls back to
   Inter Black off Windows).
   B, I, G rise in one under the other; then each word is COMPLETED in place: the rest of
   the letters are written straight after its initial (B + lackstone, I + slamic, G + lobal);
   then the black panel slides up to reveal the page.
   Plays once per browser session (BaseLayout's head script sets html.preloader-skip /
   html.preloader-active before first paint). About 5.5 s in total. */
const rows = [
  { initial: 'B', rest: 'lackstone', initialDelay: '0.30s', restDelay: '2.15s', restDur: '1.00s' },
  { initial: 'I', rest: 'slamic',    initialDelay: '0.85s', restDelay: '2.85s', restDur: '0.80s' },
  { initial: 'G', rest: 'lobal',     initialDelay: '1.40s', restDelay: '3.55s', restDur: '0.65s' },
];
---

<div id="preloader" class="preloader" aria-hidden="true">
  <div class="preloader__lockup">
    {rows.map((r) => (
      <div class="preloader__row">
        <span class="preloader__initial" style={`--d: ${r.initialDelay}`}>{r.initial}</span><span class="preloader__rest" style={`--d: ${r.restDelay}; --dur: ${r.restDur}`}>{r.rest}</span>
      </div>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('preloader');
    if (!el) return;
    var root = document.documentElement;

    /* Already seen this session: the head script hid it with CSS; drop it from the DOM. */
    if (root.classList.contains('preloader-skip')) { el.remove(); return; }

    try { sessionStorage.setItem('big-preloader', '1'); } catch (e) {}

    var MIN = 4800;   /* never leave before the animation (and a short hold) has finished */
    var MAX = 7500;   /* never hold the page longer than this (slow connection, big video) */
    var t0 = Date.now();
    var left = false;

    function finish() {
      if (el.parentNode) el.parentNode.removeChild(el);
      root.classList.remove('preloader-active');
    }
    function leave() {
      if (left) return;
      left = true;
      el.classList.add('is-leaving');
      el.addEventListener('transitionend', function (e) { if (e.target === el) finish(); });
      setTimeout(finish, 1200); /* fallback if transitionend never fires */
    }

    var loaded = new Promise(function (resolve) {
      if (document.readyState === 'complete') resolve();
      else window.addEventListener('load', resolve, { once: true });
    });
    var fonts = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();

    Promise.all([loaded, fonts]).then(function () {
      setTimeout(leave, Math.max(0, MIN - (Date.now() - t0)));
    });
    setTimeout(leave, MAX);
  })();
</script>

<style is:global>
  /* html.preloader-active is added by the head script: locks scroll while the panel is up. */
  html.preloader-active { overflow: hidden; }
  html.preloader-skip #preloader { display: none; }

  .preloader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    color: #fff;
    /* Segoe UI Black on Windows; Inter 900 (loaded in BaseLayout) everywhere else. */
    font-family: 'Segoe UI Black', 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-weight: 900;
    transform: translateY(0);
  }
  .preloader.is-leaving {
    transform: translateY(-100%);
    transition: transform 0.7s cubic-bezier(0.77, 0, 0.18, 1);
  }
  .preloader.is-leaving .preloader__lockup {
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .preloader__lockup { padding: 0 24px; }
  .preloader__row {
    display: block;
    white-space: nowrap;
    font-size: clamp(48px, min(9.5vw, 15vh), 128px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .preloader__initial,
  .preloader__rest { display: inline-block; }

  .preloader__initial {
    opacity: 0;
    animation: preloader-rise 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d);
  }

  /* The rest of the word is written left to right, straight after its initial. */
  .preloader__rest {
    clip-path: inset(-0.3em 100% -0.3em -0.05em);   /* hidden; the keyframes wipe it open */
    animation: preloader-write var(--dur, 0.8s) cubic-bezier(0.65, 0, 0.35, 1) both;
    animation-delay: var(--d);
  }

  @keyframes preloader-rise {
    from { opacity: 0; transform: translateY(32px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes preloader-write {
    from { clip-path: inset(-0.3em 100% -0.3em -0.05em); }
    to   { clip-path: inset(-0.3em -0.1em -0.3em -0.05em); }
  }
  @keyframes preloader-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Reduced motion: NOT switched off. Windows' "show animations off" reports this on many
     ordinary machines (see Hero.astro) and the preloader would look broken. Only the sliding
     movement goes: initials fade in place, the words are still written left to right (a plain
     reveal, no travel), and the panel fades out instead of sliding up. Same timing. */
  @media (prefers-reduced-motion: reduce) {
    .preloader__initial { animation-name: preloader-fade; transform: none; }
    .preloader.is-leaving {
      transform: none;
      opacity: 0;
      transition: opacity 0.6s ease;
    }
  }
</style>
