---
import Button from './Button.astro';
---

<section class="bg-mist py-section">
  <div class="container-big">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16 mb-12">
      <!-- Stat 1 -->
      <div>
        <p class="no-justify font-serif font-normal text-copy mb-2" style="font-size: clamp(48px, 6vw, 72px); line-height: 1;">
          25+
        </p>
        <p class="no-justify font-sans font-bold text-sm text-copy uppercase tracking-wide leading-snug">
          Years of experience in Global Capital Markets, Private Equity, Asset Management and Corporate Financing
        </p>
      </div>
      <!-- Stat 2 -->
      <div>
        <p class="no-justify font-serif font-normal text-copy mb-2" style="font-size: clamp(48px, 6vw, 72px); line-height: 1;">
          100%
        </p>
        <p class="no-justify font-sans font-bold text-sm text-copy uppercase tracking-wide leading-snug">
          Shariah Screened Every Portfolio Independently Compliance Checked
        </p>
      </div>
      <!-- Stat 3 -->
      <div>
        <p class="no-justify font-serif font-normal text-copy mb-2" style="font-size: clamp(48px, 6vw, 72px); line-height: 1;">
          3
        </p>
        <p class="no-justify font-sans font-bold text-sm text-copy uppercase tracking-wide leading-snug">
          Markets: PSX · FTSE · NASDAQ Access for Local &amp; Overseas Investors
        </p>
      </div>
    </div>

    <!-- CTA links -->
    <div class="flex items-center gap-8 flex-wrap">
      <Button variant="outline" href="/about">Our Firm</Button>
      <Button variant="outline" href="/contact">Engage</Button>
    </div>
  </div>
</section>
