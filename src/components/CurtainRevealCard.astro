---
// CurtainRevealCard — a large image card whose details reveal on hover behind a
// curtain that wipes open from the centre (clip-path), with the image easing in.
// Pure CSS/Astro (no React/framer-motion) so it stays consistent with the static
// site. Accessible: on touch (hover:none) and reduced-motion the copy is shown by
// default, and focusing the CTA reveals it for keyboard users.
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  href?: string;
  ctaLabel?: string;
}
const { eyebrow, title, description, image, imageAlt, href = '/contact', ctaLabel = 'Get in Touch' } = Astro.props;
---

<article class="crc group relative overflow-hidden bg-ink min-h-[440px] lg:min-h-[560px]">
  <!-- Image -->
  <img src={image} alt={imageAlt} class="crc-img absolute inset-0 w-full h-full object-cover" loading="lazy" />
  <!-- Permanent bottom gradient for the resting-state title -->
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/25 to-transparent pointer-events-none"></div>
  <!-- Curtain veil — wipes open from the centre on hover -->
  <div class="crc-veil absolute inset-0 bg-ink/65 pointer-events-none"></div>
  <!-- Leading acid edge that sweeps with the curtain -->
  <div class="crc-edge absolute inset-y-0 left-1/2 w-0.5 bg-acid pointer-events-none opacity-0"></div>

  <!-- Content -->
  <div class="absolute inset-0 flex flex-col justify-end p-8 lg:p-12">
    {eyebrow && <p class="label text-acid mb-3">{eyebrow}</p>}
    <h3 class="font-serif font-normal text-white" style="font-size: clamp(28px, 3vw, 40px); line-height: 1.15;">
      {title}
    </h3>
    <div class="crc-reveal">
      <p class="font-sans text-white/85 text-sm lg:text-base leading-relaxed mt-5 mb-7 max-w-xl">{description}</p>
      <a
        href={href}
        class="inline-flex items-center gap-2 border border-paper/40 text-white px-5 py-2.5 font-sans text-sm font-semibold hover:bg-acid hover:text-ink hover:border-acid transition-colors"
      >
        {ctaLabel} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .crc-img { transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .crc:hover .crc-img { transform: scale(1.06); }

  /* The curtain: a dark veil clipped to a centre line, opening full on hover */
  .crc-veil {
    clip-path: polygon(50% 0, 50% 0, 50% 100%, 50% 100%);
    transition: clip-path 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .crc:hover .crc-veil,
  .crc:focus-within .crc-veil {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }

  .crc-edge { transition: opacity 0.25s ease; }
  .crc:hover .crc-edge,
  .crc:focus-within .crc-edge { opacity: 0; }

  /* The details reveal upward as the curtain opens */
  .crc-reveal {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease 0.1s;
  }
  .crc:hover .crc-reveal,
  .crc:focus-within .crc-reveal {
    max-height: 26rem;
    opacity: 1;
  }

  /* Touch devices have no hover — show everything by default */
  @media (hover: none) {
    .crc-veil { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
    .crc-reveal { max-height: 26rem; opacity: 1; }
    .crc-edge { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .crc-img, .crc-veil, .crc-reveal, .crc-edge { transition: none; }
  }
</style>
