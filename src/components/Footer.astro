<style>
  /* Opaque-black JPEG on an ink background — screen blending removes the
     black so no rectangle edge shows behind the wordmark. */
  .footer-logo {
    mix-blend-mode: screen;
    width: var(--footer-logo-w);
    height: auto;
    /* Viewport-based cap (not 100%): its parent link shrink-wraps to the logo, so a
       percentage here would be circular and shave the logo by its own inset. */
    max-width: calc(100vw - 2 * var(--nav-pad-x));
    /* The JPEG carries ~4.84% of black margin on each side, so its visible
       lettering starts inside the box. Pull the box left by that inset so the
       VISIBLE edge lands where the block's content starts. */
    margin-left: calc(-0.0484 * var(--footer-logo-w));
  }

  /* ── Brand block alignment ────────────────────────────────────────────
     Goal: footer logo's visible left edge === tagline's left edge === the
     navbar logo's visible left edge. The navbar logo box starts at
     --nav-pad-x and its own visible lettering is 4.84% of its width further in
     (156px wide from 900px up, 120px below), so the block's content starts at
     --nav-pad-x + 0.0484 * that width. */
  .footer-brand {
    --nav-logo-w: 120px;
    --footer-logo-w: 200px;                    /* phones */
    padding-left: calc(0.0484 * var(--nav-logo-w));
    /* Below 1024px the block stays in the grid cell (container padding is 24px). */
    margin-left: calc(var(--nav-pad-x) - 24px);
  }
  /* Tagline: 240px max, but always narrower than the logo above it. */
  .footer-tagline {
    max-width: min(240px, calc(var(--footer-logo-w) - 24px));
    /* The footer is outside <main>, so the global justify rule does not reach it. */
    text-align: justify;
    text-align-last: left;
    hyphens: manual;
    -webkit-hyphens: manual;
    word-spacing: normal;
    overflow-wrap: normal;
    text-wrap: pretty;
  }
  @media (max-width: 767px) {
    .footer-tagline { text-align: left; }
  }
  @media (min-width: 768px) {
    .footer-brand { --footer-logo-w: 280px; }
  }
  @media (min-width: 900px) {
    .footer-brand { --nav-logo-w: 156px; }
  }
  /* From 1024px the block is taken out of flow and hung from the page edge, in line
     with the navbar logo. Its grid cell stays, so the link columns do not move.
     `top` is left auto so it keeps its natural vertical position. */
  @media (min-width: 1024px) {
    .footer-brand {
      position: absolute;
      margin-left: 0;
      left: var(--nav-pad-x);
    }
  }
  /* The logo may not reach the "What We Do" column (starts at 0.2vw+46px below
     1280px, 0.5vw-338px above it). 24px clear gap is kept to the visible edge. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .footer-brand { --footer-logo-w: calc(22vw - 28px); }
  }
  @media (min-width: 1280px) {
    .footer-brand { --footer-logo-w: min(280px, calc(55vw - 453px)); }
  }
  .footer-link {
    @apply font-sans text-sm text-white/70 hover:text-white transition-colors;
  }
  .social-icon {
    @apply text-white/60 hover:text-white transition-colors;
  }
  .footer-legal-link {
    @apply font-sans text-xs text-white/40 hover:text-white/70 transition-colors;
  }
</style>
