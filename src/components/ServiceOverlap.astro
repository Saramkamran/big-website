---
// ServiceOverlap — a big image with an overlapping bordered editorial card.
interface Props {
  id: string; eyebrow?: string; tag?: string; title: string; body: string;
  image: string; imageAlt: string; imageSide?: 'left' | 'right'; bg?: 'paper' | 'mist';
}
const { id, eyebrow, tag, title, body, image, imageAlt, imageSide = 'left', bg = 'paper' } = Astro.props;
const bgClass = bg === 'mist' ? 'bg-mist' : 'bg-paper';
---
<section id={id} class={`${bgClass} py-20 lg:py-28`}>
  <div class="container-big">
    {(eyebrow || tag) && (
      <div class="flex items-center gap-3 mb-10">
        {eyebrow && <span class="font-sans text-xs font-bold tracking-[0.2em] text-ink">{eyebrow}</span>}
        <span class="h-px w-10 bg-acid"></span>
        {tag && <span class="font-sans text-xs font-semibold uppercase tracking-widest text-stone">{tag}</span>}
      </div>
    )}
    <div class="relative">
      <div class={`lg:w-[62%] aspect-[16/10] overflow-hidden bg-line ${imageSide === 'right' ? 'lg:ml-auto' : ''}`}>
        <img src={image} alt={imageAlt} class="w-full h-full object-cover" loading="lazy" />
      </div>
      <div class={`relative bg-paper border border-line p-8 lg:p-12 -mt-12 mx-4 lg:mx-0 lg:mt-0 lg:absolute lg:top-1/2 lg:-translate-y-1/2 lg:w-[46%] ${imageSide === 'right' ? 'lg:left-0' : 'lg:right-0'}`}>
        <h3 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(26px, 2.8vw, 38px); line-height: 1.2;">
          {title}
        </h3>
        <p class="font-sans text-sm lg:text-base text-stone leading-relaxed">{body}</p>
      </div>
    </div>
  </div>
</section>
