---
---

<header id="site-header" class="sticky top-0 z-50 bg-acid border-b-2 border-acid" style="height: var(--header-h);">
  <!--
    Row layout: [logo] [primary links] ——— flexible gap ——— [secondary links][search][CTA]
    The right cluster carries `ml-auto`, which both pushes it flush right on desktop
    and keeps the hamburger flush right on mobile (where the link groups are hidden).
  -->
  <div class="w-full h-full flex items-center px-6 min-[900px]:pl-10 min-[900px]:pr-10">
    <!-- Logo — 63×26 wordmark in a 99×64 container, 40px inset from the bar edge -->
    <a
      href="/"
      class="flex flex-shrink-0 items-center h-full no-underline min-[900px]:w-[99px]"
      aria-label="Blackstone Islamic Global — Home"
    >
      <!-- 63×26 wordmark box. Cap height fills the 26px; width is left free so the
           brand's -0.04em tracking survives (forcing 63 would stretch the letterforms). -->
      <svg width="63" height="26" viewBox="0 0 63 26" fill="none" role="img" class="block text-ink">
        <title>BIG — Blackstone Islamic Global</title>
        <text
          x="0" y="26"
          fill="currentColor"
          font-family="Inter, system-ui, sans-serif"
          font-size="35.75" font-weight="800" letter-spacing="-1.43"
        >BIG</text>
      </svg>
    </a>

    <!-- Primary nav — sits immediately right of the logo, left-aligned -->
    <nav class="hidden min-[900px]:flex items-center h-full" aria-label="Main navigation">
      <div class="relative group" id="services-menu-container">
        <button
          id="services-btn"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="mega-menu"
          class="nav-link flex items-center gap-1"
        >
          What We Do
          <svg class="w-3 h-3 transition-transform duration-200" id="services-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>
      <a href="/insights" class="nav-link">Insights</a>
      <a href="/about" class="nav-link">Our Firm</a>
      <a href="/contact" class="nav-link">Contact</a>
    </nav>

    <!-- Right cluster — secondary links, search, CTA (and the mobile hamburger) -->
    <!-- gap-2 = the spec's 8px between utility nav → search → CTA -->
    <div class="ml-auto flex items-center gap-2 h-full">
      <nav class="hidden min-[900px]:flex items-center h-full" aria-label="Utility navigation">
        <div class="relative group" id="coaching-menu-container">
          <button
            id="coaching-btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="coaching-menu"
            class="nav-link flex items-center gap-1"
          >
            Investor Coaching
            <svg class="w-3 h-3 transition-transform duration-200" id="coaching-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div class="relative group" id="newsroom-menu-container">
          <button
            id="newsroom-btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="newsroom-menu"
            class="nav-link flex items-center gap-1"
          >
            Newsroom
            <svg class="w-3 h-3 transition-transform duration-200" id="newsroom-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div class="relative group" id="pressroom-menu-container">
          <button
            id="pressroom-btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="pressroom-menu"
            class="nav-link flex items-center gap-1"
          >
            Pressroom
            <svg class="w-3 h-3 transition-transform duration-200" id="pressroom-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div class="relative group" id="careers-menu-container">
          <button
            id="careers-btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="careers-menu"
            class="nav-link flex items-center gap-1"
          >
            Careers
            <svg class="w-3 h-3 transition-transform duration-200" id="careers-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
      </nav>

      <!-- 18×18 icon centred in a 32×32 hit area -->
      <button
        id="search-btn"
        class="hidden min-[900px]:inline-flex items-center justify-center w-8 h-8 flex-shrink-0 text-ink hover:text-ink/70 transition-colors"
        aria-label="Search"
        aria-expanded="false"
        aria-controls="search-panel"
      >
        <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
        </svg>
      </button>

      <!-- 91×32, 6px/7px padding, 0.8px square border, transparent fill -->
      <a
        href="/login"
        class="hidden min-[900px]:inline-flex items-center justify-center flex-shrink-0 w-[91px] h-8 px-[7px] py-[6px] rounded-none border-[0.8px] border-ink bg-transparent text-ink font-sans text-sm font-medium leading-none whitespace-nowrap transition-colors hover:bg-ink hover:text-white"
      >
        Client Login
      </a>

      <button id="mobile-menu-btn" class="min-[900px]:hidden p-2 text-ink" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" id="hamburger-icon">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" id="close-icon">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- ── Search panel (desktop) ──────────────────────────────────────────── -->
  <!-- TODO: no search results page exists yet — submit is inert until one is built. -->
  <div
    id="search-panel"
    role="region"
    aria-label="Search"
    class="hidden absolute top-full left-0 right-0 bg-white border-t border-line shadow-2xl z-40"
  >
    <div class="container-big py-6">
      <form id="search-form" role="search" class="flex items-center gap-4">
        <svg class="w-5 h-5 flex-shrink-0 text-stone" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
        </svg>
        <label for="search-input" class="sr-only">Search</label>
        <input
          id="search-input"
          name="q"
          type="search"
          placeholder="Search BIG"
          class="flex-1 bg-transparent font-sans text-base text-ink placeholder:text-stone focus:outline-none py-1"
        />
        <button type="button" id="search-close" class="p-2 text-ink hover:text-stone transition-colors" aria-label="Close search">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </form>
    </div>
  </div>

  <!-- ── Mega Menu (desktop) ─────────────────────────────────────────────── -->
  <div
    id="mega-menu"
    role="region"
    aria-label="What We Do menu"
    class="hidden absolute top-full left-0 right-0 bg-white border-t border-line shadow-2xl z-40"
  >
    <div class="container-big py-10">
      <div class="flex gap-0">

        <!-- Left intro panel -->
        <div class="w-56 flex-shrink-0 pr-8 border-r border-line mr-8 flex flex-col justify-between">
          <div>
            <h2 class="font-serif font-normal text-ink text-2xl leading-tight mb-4">What We Do</h2>
            <p class="font-sans text-sm text-stone leading-relaxed mb-6">
              Let us take the opportunity to help you understand how we make things happen for you — across Pakistani and global Shariah-compliant markets.
            </p>
            <a
              href="/#what-we-do"
              class="inline-flex items-center border border-ink px-4 py-2 font-sans text-xs font-semibold text-ink hover:bg-ink hover:text-white transition-colors"
            >
              Explore Our Businesses
            </a>
          </div>
          <div class="mt-8 pt-6 border-t border-line">
            <a href="/about" class="font-sans text-xs font-semibold text-ink hover:text-stone transition-colors flex items-center gap-1">
              About BIG <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
            </a>
          </div>
        </div>

        <!-- 4 service columns -->
        <div class="flex-1 grid grid-cols-4 gap-8">
          <!-- PSX & Global Markets -->
          <div>
            <a href="/what-we-do/psx-global-markets" class="block label mb-5 text-ink hover:text-stone transition-colors">
              PSX &amp; Global Markets
            </a>
            <ul class="space-y-3">
              <li><a href="/what-we-do/psx-global-markets#shariah-equities" class="mega-link">Shariah Equities</a></li>
              <li><a href="/what-we-do/psx-global-markets#green-sukuks" class="mega-link">Sukuks and Green Sukuks</a></li>
              <li><a href="/what-we-do/psx-global-markets#transaction-services" class="mega-link">Transaction Services</a></li>
              <li><a href="/what-we-do/psx-global-markets#blackstone-intel" class="mega-link">Blackstone Intel</a></li>
              <li><a href="/what-we-do/psx-global-markets#portfolio-consultancy" class="mega-link">Portfolio Consultancy</a></li>
              <li><a href="/what-we-do/psx-global-markets#portfolio-supervision" class="mega-link">Portfolio Supervision</a></li>
            </ul>
          </div>
          <!-- Asset Management -->
          <div>
            <a href="/what-we-do/asset-management" class="block label mb-5 text-ink hover:text-stone transition-colors">
              Asset Management
            </a>
            <ul class="space-y-3">
              <li><a href="/what-we-do/asset-management#am-fixed-income" class="mega-link">Shariah Fixed Income Funds</a></li>
              <li><a href="/what-we-do/asset-management#am-equity" class="mega-link">Shariah Equity Funds</a></li>
              <li><a href="/what-we-do/asset-management#am-etfs" class="mega-link">Shariah ETF</a></li>
              <li><a href="/what-we-do/asset-management#am-multi-asset" class="mega-link">Shariah Multi-Asset Funds</a></li>
              <li><a href="/what-we-do/asset-management#am-pensions" class="mega-link">Shariah Pensions</a></li>
            </ul>
          </div>
          <!-- Private Wealth -->
          <div>
            <a href="/what-we-do/private-wealth" class="block label mb-5 text-ink hover:text-stone transition-colors">
              Private Wealth Mgmt
            </a>
            <ul class="space-y-3">
              <li><a href="/what-we-do/private-wealth#wealth-planning" class="mega-link">Wealth Planning</a></li>
              <li><a href="/what-we-do/private-wealth#private-equity" class="mega-link">Private Equity</a></li>
              <li><a href="/what-we-do/private-wealth#real-estate" class="mega-link">Real Estate</a></li>
              <li><a href="/what-we-do/private-wealth#pakistan-energy" class="mega-link">Pakistan Energy</a></li>
              </ul>
          </div>
          <!-- Specialized Services -->
          <div>
            <a href="/what-we-do/specialized-services" class="block label mb-5 text-ink hover:text-stone transition-colors">
              Specialized Services
            </a>
            <ul class="space-y-3">
              <li><a href="/what-we-do/specialized-services#family-office" class="mega-link">Basirah Family Office</a></li>
              <li><a href="/what-we-do/specialized-services#lifestyle-management" class="mega-link">Lifestyle Management</a></li>
              <li><a href="/what-we-do/specialized-services#pr-campaign" class="mega-link">PR Campaign</a></li>
              <li><a href="/what-we-do/specialized-services#philanthropy-zakat" class="mega-link">Philanthropy and Zakat</a></li>
              <li><a href="/what-we-do/specialized-services#mergers-acquisitions" class="mega-link">M&amp;A and Carve Out</a></li>
              <li><a href="/what-we-do/specialized-services#professional-services" class="mega-link">Professional Services</a></li>
              <li><a href="/what-we-do/specialized-services#ipos" class="mega-link">Initial Public Offer</a></li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ── Investor Coaching menu (desktop) ─────────────────────────────────── -->
  <div
    id="coaching-menu"
    role="region"
    aria-label="Investor Coaching menu"
    class="hidden absolute top-full left-0 right-0 bg-white border-t border-line shadow-2xl z-40"
  >
    <div class="container-big py-10">
      <div class="flex gap-0">

        <!-- Left intro panel -->
        <div class="w-56 flex-shrink-0 pr-8 border-r border-line mr-8 flex flex-col justify-between">
          <div>
            <h2 class="font-serif font-normal text-ink text-2xl leading-tight mb-4">Investor Coaching</h2>
          </div>
        </div>

        <!-- 3 columns -->
        <div class="flex-1 grid grid-cols-3 gap-8">
          <!-- Guidance Documents -->
          <div>
            <p class="block label mb-5 text-ink">Guidance Documents</p>
            <ul class="space-y-3">
              <!-- TODO: confirm final PDF path -->
              <li><a href="/pdfs/psx-investor-guidance-en.pdf" class="mega-link">PSX Investor Guidance (English)</a></li>
              <!-- TODO: confirm final PDF path -->
              <li><a href="/pdfs/psx-investor-guidance-ur.pdf" class="mega-link">PSX Investor Guidance (Urdu)</a></li>
              <!-- TODO: confirm final PDF path -->
              <li><a href="/pdfs/secp-investor-guidance-en.pdf" class="mega-link">SECP Investor Guidance (English)</a></li>
              <!-- TODO: confirm final PDF path -->
              <li><a href="/pdfs/secp-investor-guidance-ur.pdf" class="mega-link">SECP Investor Guidance (Urdu)</a></li>
              <!-- TODO: confirm exact title and PDF -->
              <li><a href="/pdfs/risk-of-equity-trading.pdf" class="mega-link">Risk of Equity Trading</a></li>
            </ul>
          </div>
          <!-- PSX Resources -->
          <div>
            <p class="block label mb-5 text-ink">PSX Resources</p>
            <ul class="space-y-3">
              <li><a href="https://www.psx.com.pk/psx/resources-and-tools/investors" target="_blank" rel="noopener noreferrer" class="mega-link">Investor Guidance</a></li>
              <li><a href="https://www.psx.com.pk/psx/resources-and-tools/shariah-compliant-investment" target="_blank" rel="noopener noreferrer" class="mega-link">Shariah Compliant Stocks</a></li>
              <li><a href="https://www.psx.com.pk/psx/resources-and-tools/investors/investor-dos-and-donts" target="_blank" rel="noopener noreferrer" class="mega-link">Investor Dos and Don'ts</a></li>
            </ul>
          </div>
          <!-- Market Tools & Regulators -->
          <div>
            <p class="block label mb-5 text-ink">Market Tools &amp; Regulators</p>
            <ul class="space-y-3">
              <li><a href="https://www.cdcaccess.com.pk/#/login" target="_blank" rel="noopener noreferrer" class="mega-link">CDC</a></li>
              <li><a href="https://uis.nccpl.com.pk/" target="_blank" rel="noopener noreferrer" class="mega-link">NCCPL</a></li>
              <li><a href="https://www.sbp.org.pk/" target="_blank" rel="noopener noreferrer" class="mega-link">SBP</a></li>
              <li><a href="https://www.tradingview.com/" target="_blank" rel="noopener noreferrer" class="mega-link">TradingView</a></li>
              <li><a href="https://www.investing.com/markets/" target="_blank" rel="noopener noreferrer" class="mega-link">Investing.com</a></li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ── Newsroom menu (desktop) ──────────────────────────────────────────── -->
  <div
    id="newsroom-menu"
    role="region"
    aria-label="Newsroom menu"
    class="hidden absolute top-full left-0 right-0 bg-white border-t border-line shadow-2xl z-40"
  >
    <div class="container-big py-10">
      <div class="flex gap-0">
        <div class="flex-1 grid grid-cols-1 gap-8 max-w-xs">
          <div>
            <ul class="space-y-3">
              <li><a href="https://www.bloomberg.com" target="_blank" rel="noopener noreferrer" class="mega-link">Bloomberg</a></li>
              <li><a href="https://www.reuters.com/" target="_blank" rel="noopener noreferrer" class="mega-link">Reuters</a></li>
              <li><a href="https://www.wsj.com/" target="_blank" rel="noopener noreferrer" class="mega-link">Wall Street Journal</a></li>
              <li><a href="https://www.economist.com/" target="_blank" rel="noopener noreferrer" class="mega-link">The Economist</a></li>
              <li><a href="https://www.brecorder.com/" target="_blank" rel="noopener noreferrer" class="mega-link">Business Recorder</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Pressroom menu (desktop) ─────────────────────────────────────────── -->
  <div
    id="pressroom-menu"
    role="region"
    aria-label="Pressroom menu"
    class="hidden absolute top-full left-0 right-0 bg-white border-t border-line shadow-2xl z-40"
  >
    <div class="container-big py-10">
      <div class="flex gap-0">
        <div class="flex-1 grid grid-cols-1 gap-8 max-w-xs">
          <div>
            <ul class="space-y-3">
              <li><span class="mega-link">Coming soon</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Careers menu (desktop) ───────────────────────────────────────────── -->
  <div
    id="careers-menu"
    role="region"
    aria-label="Careers menu"
    class="hidden absolute top-full left-0 right-0 bg-white border-t border-line shadow-2xl z-40"
  >
    <div class="container-big py-10">
      <div class="flex gap-0">
        <div class="flex-1 grid grid-cols-1 gap-8 max-w-xs">
          <div>
            <ul class="space-y-3">
              <li><span class="mega-link">Coming soon</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Mobile menu drawer ─────────────────────────────────────────────── -->
  <div
    id="mobile-menu"
    class="hidden min-[900px]:hidden fixed inset-x-0 bottom-0 bg-white z-30 overflow-y-auto"
    style="top: var(--header-h);"
  >
    <div id="mobile-menu-inner" class="container-big py-8 space-y-1">
      <!-- Search — icon + input row -->
      <!-- TODO: no search results page exists yet — submit is inert until one is built. -->
      <form role="search" class="mobile-search-form flex items-center gap-3 border border-line px-4 py-3 mb-6">
        <svg class="w-5 h-5 flex-shrink-0 text-stone" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
        </svg>
        <label for="mobile-search-input" class="sr-only">Search</label>
        <input
          id="mobile-search-input"
          name="q"
          type="search"
          placeholder="Search BIG"
          class="flex-1 bg-transparent font-sans text-base text-ink placeholder:text-stone focus:outline-none"
        />
      </form>

      <!-- Primary links (desktop order) -->
      <div>
        <button
          id="mobile-services-btn"
          class="w-full flex items-center justify-between py-4 font-sans text-base font-semibold text-ink border-b border-line"
          aria-expanded="false"
          aria-controls="mobile-services-panel"
        >
          What We Do
          <svg class="w-4 h-4 transition-transform duration-200" id="mobile-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-services-panel" class="hidden bg-mist px-4 py-4 space-y-6">
          <!-- Mobile intro blurb -->
          <p class="font-sans text-sm text-stone leading-relaxed border-l-2 border-acid pl-3">
            Let us help you understand how we make things happen for you — across Pakistani and global Shariah-compliant markets.
          </p>
          <div>
            <a href="/what-we-do/psx-global-markets" class="label mb-3 block hover:text-ink transition-colors">PSX &amp; Global Markets</a>
            <ul class="space-y-2 pl-2">
              <li><a href="/what-we-do/psx-global-markets#shariah-equities" class="mobile-sub-link">Shariah Equities</a></li>
              <li><a href="/what-we-do/psx-global-markets#green-sukuks" class="mobile-sub-link">Sukuks and Green Sukuks</a></li>
              <li><a href="/what-we-do/psx-global-markets#transaction-services" class="mobile-sub-link">Transaction Services</a></li>
              <li><a href="/what-we-do/psx-global-markets#blackstone-intel" class="mobile-sub-link">Blackstone Intel</a></li>
              <li><a href="/what-we-do/psx-global-markets#portfolio-consultancy" class="mobile-sub-link">Portfolio Consultancy</a></li>
              <li><a href="/what-we-do/psx-global-markets#portfolio-supervision" class="mobile-sub-link">Portfolio Supervision</a></li>
            </ul>
          </div>
          <div>
            <a href="/what-we-do/asset-management" class="label mb-3 block hover:text-ink transition-colors">Asset Management</a>
            <ul class="space-y-2 pl-2">
              <li><a href="/what-we-do/asset-management#am-fixed-income" class="mobile-sub-link">Shariah Fixed Income Funds</a></li>
              <li><a href="/what-we-do/asset-management#am-equity" class="mobile-sub-link">Shariah Equity Funds</a></li>
              <li><a href="/what-we-do/asset-management#am-etfs" class="mobile-sub-link">Shariah ETF</a></li>
              <li><a href="/what-we-do/asset-management#am-multi-asset" class="mobile-sub-link">Shariah Multi-Asset Funds</a></li>
              <li><a href="/what-we-do/asset-management#am-pensions" class="mobile-sub-link">Shariah Pensions</a></li>
            </ul>
          </div>
          <div>
            <a href="/what-we-do/private-wealth" class="label mb-3 block hover:text-ink transition-colors">Private Wealth Mgmt</a>
            <ul class="space-y-2 pl-2">
              <li><a href="/what-we-do/private-wealth#wealth-planning" class="mobile-sub-link">Wealth Planning</a></li>
