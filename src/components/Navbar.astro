<header id="site-header" class="sticky top-0 z-50 bg-ink border-b-2 border-ink" style="height: var(--header-h);">
  <!--
    Row layout: [logo] [primary links] ——— flexible gap ——— [secondary links][menu]
    The right cluster carries `ml-auto`, which both pushes it flush right on desktop
    and keeps the hamburger flush right on mobile (where the link groups are hidden).
  -->
  <div class="w-full h-full flex items-center px-6 min-[900px]:pl-10 min-[900px]:pr-10">
    <!-- Logo — the metallic BLACKSTONE ISLAMIC GLOBAL wordmark (3:1). The file is
         a JPEG with an opaque black background, so global.css blends it with
         `mix-blend-mode: screen` to drop that black into the ink bar. -->
    <a
      href="/"
      class="site-logo flex flex-shrink-0 items-center h-full no-underline mr-6"
      aria-label="Blackstone Islamic Global — Home"
    >
      <img
        src="/images/big-logo.jpg"
        alt="Blackstone Islamic Global"
        width="1600"
        height="533"
        class="site-logo-img block w-auto"
      />
    </a>

    <!-- Primary nav — sits immediately right of the logo, left-aligned -->
    <nav class="hidden min-[900px]:flex items-center h-full" aria-label="Main navigation">
      <div class="relative group" id="services-menu-container">
        <button
          id="services-btn"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="mega-menu"
          class="nav-link flex items-center gap-1"
        >
          What We Do
          <svg class="w-3 h-3 transition-transform duration-200" id="services-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>
      <a href="/about" class="nav-link">Our Firm</a>
      <a href="/contact" class="nav-link">Contact</a>
    </nav>

    <!-- Right cluster — secondary links (and the mobile hamburger) -->
    <div class="ml-auto flex items-center gap-2 h-full">
      <nav class="hidden min-[900px]:flex items-center h-full" aria-label="Utility navigation">
        <div class="relative group" id="coaching-menu-container">
          <button
            id="coaching-btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="coaching-menu"
            class="nav-link flex items-center gap-1"
          >
            Investor Coaching
            <svg class="w-3 h-3 transition-transform duration-200" id="coaching-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div class="relative group" id="newsroom-menu-container">
          <button
            id="newsroom-btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="newsroom-menu"
            class="nav-link flex items-center gap-1"
          >
            Newsroom
            <svg class="w-3 h-3 transition-transform duration-200" id="newsroom-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div class="relative group" id="pressroom-menu-container">
          <button
            id="pressroom-btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="pressroom-menu"
            class="nav-link flex items-center gap-1"
          >
            Pressroom
            <svg class="w-3 h-3 transition-transform duration-200" id="pressroom-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div class="relative group" id="careers-menu-container">
          <button
            id="careers-btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="careers-menu"
            class="nav-link flex items-center gap-1"
          >
            Careers
            <svg class="w-3 h-3 transition-transform duration-200" id="careers-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
      </nav>



      <button id="mobile-menu-btn" class="min-[900px]:hidden p-2 text-ink" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" id="hamburger-icon">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" id="close-icon">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
