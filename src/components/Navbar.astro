<style>
  /* 14px / 400 / normal tracking, 8px padding each side → 16px between adjacent
     links, full navbar height so the label is vertically centred. */
  .nav-link {
    @apply inline-flex items-center h-full px-2 font-sans text-sm font-normal tracking-normal
           text-ink hover:text-ink/70 transition-colors whitespace-nowrap;
  }
  .mega-link {
    @apply font-sans text-sm text-ink/70 hover:text-ink transition-colors;
  }
  .mobile-sub-link {
    @apply block font-sans text-sm text-ink/70 hover:text-ink py-1 transition-colors;
  }

  /* ── Brand logo ─────────────────────────────────────────────────────────
     A 3:1 metallic wordmark. The bar is 80px tall, so 52px fills it with a
     comfortable margin and makes the second line ("ISLAMIC GLOBAL") genuinely
     readable rather than a smudge. 52px tall => ~156px wide. */
  .site-logo-img {
    height: 52px;
    /* No drop-shadow here: the bar is black, and global.css applies a faint
       white glow (#site-header .site-logo-img) so the mark's dark outlines
       have something to separate from. Keeping a dark shadow too would just
       fight that rule. */
  }
  @media (max-width: 899px) {
    .site-logo-img { height: 40px; }
  }
</style>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuInner = document.getElementById('mobile-menu-inner');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  // [trigger id, panel id, chevron id] — same accordion pattern for every mobile drawer section
  const mobileAccordions = [
    ['mobile-services-btn', 'mobile-services-panel', 'mobile-chevron'],
    ['mobile-coaching-btn', 'mobile-coaching-panel', 'mobile-coaching-chevron'],
    ['mobile-newsroom-btn', 'mobile-newsroom-panel', 'mobile-newsroom-chevron'],
    ['mobile-pressroom-btn', 'mobile-pressroom-panel', 'mobile-pressroom-chevron'],
    ['mobile-careers-btn', 'mobile-careers-panel', 'mobile-careers-chevron'],
  ] as const;

  /* ── Mega menu + utility dropdowns (same trigger/panel pattern) ───────── */
  // [trigger id, panel id, chevron id, container id]
  const desktopMenus = [
    ['services-btn', 'mega-menu', 'services-chevron', 'services-menu-container'],
    ['coaching-btn', 'coaching-menu', 'coaching-chevron', 'coaching-menu-container'],
    ['newsroom-btn', 'newsroom-menu', 'newsroom-chevron', 'newsroom-menu-container'],
    ['pressroom-btn', 'pressroom-menu', 'pressroom-chevron', 'pressroom-menu-container'],
    ['careers-btn', 'careers-menu', 'careers-chevron', 'careers-menu-container'],
  ] as const;

  function closeAllDesktopMenus(except?: string) {
    desktopMenus.forEach(([btnId, panelId, chevronId]) => {
      if (btnId === except) return;
      document.getElementById(panelId)?.classList.add('hidden');
      document.getElementById(btnId)?.setAttribute('aria-expanded', 'false');
      document.getElementById(chevronId)?.classList.remove('rotate-180');
    });
  }

  desktopMenus.forEach(([btnId, panelId, chevronId, containerId]) => {
    const btn = document.getElementById(btnId);
    const panel = document.getElementById(panelId);
    const chevron = document.getElementById(chevronId);
    const container = document.getElementById(containerId);

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !panel?.classList.contains('hidden');
      closeAllDesktopMenus(isOpen ? undefined : btnId);
      panel?.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
      chevron?.classList.toggle('rotate-180', !isOpen);
    });

    panel?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeAllDesktopMenus()));

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (container && !container.contains(target) && panel && !panel.contains(target)) {
        panel.classList.add('hidden');
        btn?.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      }
    });
  });



  /* ── Global dismiss ─────────────────────────────────────────────────── */
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeAllDesktopMenus(); closeMobileMenu(); }
  });
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
  });

  /* ── Mobile menu ────────────────────────────────────────────────────── */
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.contains('hidden') ? openMobileMenu() : closeMobileMenu();
  });
  function openMobileMenu() {
    mobileMenu?.classList.remove('hidden');
    mobileMenuBtn?.setAttribute('aria-expanded', 'true');
    mobileMenuBtn?.setAttribute('aria-label', 'Close menu');
    hamburgerIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeMobileMenu() {
    mobileMenu?.classList.add('hidden');
    mobileMenuBtn?.setAttribute('aria-expanded', 'false');
    mobileMenuBtn?.setAttribute('aria-label', 'Open menu');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // Click outside the menu content (the empty overlay area) closes the drawer.
  mobileMenu?.addEventListener('click', (e) => {
    if (mobileMenuInner && !mobileMenuInner.contains(e.target as Node)) closeMobileMenu();
  });

  mobileAccordions.forEach(([btnId, panelId, chevronId]) => {
    const btn = document.getElementById(btnId);
    const panel = document.getElementById(panelId);
    const chevron = document.getElementById(chevronId);
    btn?.addEventListener('click', () => {
      const isOpen = !panel?.classList.contains('hidden');
      panel?.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
      chevron?.classList.toggle('rotate-180', !isOpen);
    });
  });
  mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMobileMenu));

  // Crossing the desktop breakpoint with the drawer open would leave body scroll locked.
  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches) closeMobileMenu();
  });
</script>
