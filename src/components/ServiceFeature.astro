---
// ServiceFeature — image/text split (alternating side, paper/mist), with an optional
// acid "note" pill and an optional row of factual capability rails.
interface Rail { name: string; desc: string }
interface Props {
  id: string; index?: string; eyebrow?: string; title: string; body: string;
  image: string; imageAlt: string; imageSide?: 'left' | 'right'; bg?: 'paper' | 'mist';
  note?: string; rails?: Rail[];
}
const { id, index, eyebrow, title, body, image, imageAlt, imageSide = 'left', bg = 'paper', note, rails } = Astro.props;
const bgClass = bg === 'mist' ? 'bg-mist' : 'bg-paper';
const railCols = rails && rails.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-4';
---
<section id={id} class={`${bgClass} py-20 lg:py-28`}>
  <div class="container-big">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class={`lg:col-span-6 ${imageSide === 'right' ? 'lg:order-2' : ''}`}>
        <div class="aspect-[4/3] overflow-hidden bg-line">
          <img src={image} alt={imageAlt} class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
      <div class={`lg:col-span-6 ${imageSide === 'right' ? 'lg:order-1' : ''}`}>
        <div class="flex items-center gap-3 mb-5">
          {index && <span class="font-sans text-xs font-bold tracking-[0.2em] text-ink">{index}</span>}
          <span class="h-px w-10 bg-acid"></span>
          {eyebrow && <span class="font-sans text-xs font-semibold uppercase tracking-widest text-stone">{eyebrow}</span>}
        </div>
        <h3 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(26px, 2.8vw, 38px); line-height: 1.2;">
          {title}
        </h3>
        <p class="font-sans text-base text-stone leading-relaxed">{body}</p>
        {note && (
          <p class="mt-8"><span class="inline-block bg-acid text-ink font-sans text-xs font-semibold uppercase tracking-widest px-4 py-2">{note}</span></p>
        )}
      </div>
    </div>
    {rails && rails.length > 0 && (
      <div class={`grid grid-cols-2 ${railCols} gap-8 lg:gap-10 mt-14 lg:mt-16`}>
        {rails.map((r) => (
          <div>
            <div class="h-0.5 w-10 bg-acid mb-4"></div>
            <p class="font-serif font-normal text-ink text-xl lg:text-2xl mb-1">{r.name}</p>
            <p class="font-sans text-xs text-stone leading-snug">{r.desc}</p>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
