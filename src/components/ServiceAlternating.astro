---
// ServiceAlternating — the alternating full-bleed two-column service pattern.
//
// Each service renders as a full-width row: one column is a single edge-to-edge
// image (full row height, no padding/border/radius), the other is a generously
// padded, vertically-centred text column containing, in order:
//   eyebrow → multi-line serif heading → paragraph → lime-dot bullets → CTA.
//
// Rows alternate the image side, and the row background alternates in sync:
// image-left rows sit on white, image-right rows sit on cream.
// On mobile each row stacks to a single column, image first.
interface Service {
  id: string;
  eyebrow: string;
  /* 2–3 short phrases, each rendered on its own line. */
  headingLines: string[];
  body: string;
  bullets?: string[];
  cta?: { label: string; href: string };
  image: string;
  imageAlt: string;
  /* Anchor the crop when the subject sits high in the frame. */
  imageTop?: boolean;
  imagePosition?: string;
}

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

{services.map((s, i) => {
  const imageRight = i % 2 === 1;
  return (
    <section
      id={s.id}
      class:list={['svc-row', imageRight && 'svc-row--reverse', imageRight && 'svc-row--cream']}
    >
      <div class="svc-media">
        <img
          src={s.image}
          alt={s.imageAlt}
          class:list={['svc-img', s.imageTop && 'svc-img--top']}
          style={s.imagePosition ? `object-position: ${s.imagePosition};` : undefined}
          loading="lazy"
        />
      </div>
      <div class="svc-copy">
        <div class="svc-copy-inner">
          <p class="svc-eyebrow">{s.eyebrow}</p>
          <h2 class="svc-heading">
            {s.headingLines.map((line, n) => (
              <>{n > 0 && <br />}{line}</>
            ))}
          </h2>
          <p class="svc-para">{s.body}</p>
          {s.bullets && s.bullets.length > 0 && (
            <ul class="svc-list">
              {s.bullets.map((b) => (
                <li><span class="svc-dot" aria-hidden="true"></span><span>{b}</span></li>
              ))}
            </ul>
          )}
          {s.cta && (
            <a class="svc-btn" href={s.cta.href}>
              {s.cta.label} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
    </section>
  );
})}

<style>
  /* ──────────────────────────────────────────────────────────────────────────
     Component-scoped (Astro adds a per-component attribute), so the global
     header, footer and everything else are untouched. The lime accent is a
     SEPARATE token (--lime) — the header/footer read --acid and keep their own
     theme colour.
     ────────────────────────────────────────────────────────────────────────── */
  .svc-row {
    --lime:      #D8FF3C;
    --charcoal:  #2B2B2E;
    --eyebrow:   #8C939E;
    --bodygray:  #9CA0A6;
    --cream:     #F3F4ED;

    display: grid;
    grid-template-columns: 1fr 1fr;   /* ~50/50 */
    align-items: stretch;
    background: #FFFFFF;
  }
  /* Image right → the row sits on cream. */
  .svc-row--cream { background: var(--cream); }

  /* Source order is image-first so mobile stacks image → text with no extra
     rules; the desktop flip is done with explicit column placement. */
  .svc-row--reverse .svc-media { grid-column: 2; grid-row: 1; }
  .svc-row--reverse .svc-copy  { grid-column: 1; grid-row: 1; }

  /* ── Image column: edge-to-edge, full row height, no padding/radius ─────── */
  .svc-media {
    position: relative;
    overflow: hidden;
    min-height: 560px;
  }
  .svc-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }
  .svc-img--top { object-position: top; }

  /* ── Text column: generous padding, vertically centred, left-aligned ────── */
  .svc-copy {
    display: flex;
    align-items: center;
    text-align: left;
    padding: 88px 6vw;
    min-width: 0;
  }
  .svc-copy-inner { max-width: 560px; width: 100%; }

  /* 1 · Eyebrow — small, uppercase, wide tracking, slate gray */
  .svc-eyebrow {
    font-family: theme('fontFamily.sans');
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--eyebrow);
    margin: 0 0 22px;
  }

  /* 2 · Heading — serif, charcoal, one short phrase per line */
  .svc-heading {
    font-family: theme('fontFamily.serif');
    font-weight: 400;
    color: var(--charcoal);
    font-size: clamp(30px, 3.2vw, 44px);
    line-height: 1.16;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }

  /* 3 · Paragraph — gray, ~90% column width */
  .svc-para {
    font-family: theme('fontFamily.sans');
    font-size: 15px;
    line-height: 1.75;
    color: var(--bodygray);
    max-width: 90%;
    white-space: pre-line;  /* preserves the copy deck's paragraph breaks */
    margin: 0 0 28px;
  }

  /* 4 · Bullet list — small lime dot + gray label, tight spacing */
  .svc-list {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
  }
  .svc-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: theme('fontFamily.sans');
    font-size: 14px;
    line-height: 1.5;
    color: var(--bodygray);
    margin-bottom: 9px;
  }
  .svc-list li:last-child { margin-bottom: 0; }
  .svc-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
    margin-top: 7px;
  }

  /* 5 · CTA — lime fill, charcoal text, no border, trailing arrow */
  .svc-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--lime);
    color: var(--charcoal);
    border: none;
    border-radius: 2px;
    padding: 13px 24px;
    font-family: theme('fontFamily.sans');
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .svc-btn:hover { background: #C6EC2A; }
  .svc-btn:focus-visible { outline: 2px solid var(--charcoal); outline-offset: 3px; }
  .svc-btn span { transition: transform 0.18s ease; }
  .svc-btn:hover span { transform: translateX(3px); }

  /* ── Tablet ────────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .svc-copy { padding: 64px 5vw; }
    .svc-media { min-height: 460px; }
  }

  /* ── Mobile: one column per row, image on top, full width ──────────────── */
  @media (max-width: 820px) {
    .svc-row,
    .svc-row--reverse {
      grid-template-columns: 1fr;
    }
    /* Reset the desktop swap so source order (image → text) wins. */
    .svc-row--reverse .svc-media,
    .svc-row--reverse .svc-copy {
      grid-column: 1;
      grid-row: auto;
    }
    .svc-media { min-height: 300px; }
    .svc-copy { padding: 52px 24px 60px; }
    .svc-copy-inner { max-width: none; }
    .svc-para { max-width: 100%; }
    .svc-btn { width: 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-btn, .svc-btn span { transition: none; }
  }
</style>
