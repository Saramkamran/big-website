---
// AmMultiAsset — Shariah Multi-Asset: an interlocking 8-point star with differently-filled
// quadrants (the blend of asset classes) balanced tip-down on a fulcrum plane; the acid
// sliver marks the balance point. Am pillar language: filled duotone planes — fills only,
// zero strokes, fill-current at opacity 1 / 0.16 / 0.08, exactly one thin acid sliver.
interface Props { class?: string; title?: string }
const { class: className, title } = Astro.props;
---
<svg
  viewBox="0 0 480 480"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <path d="M240 210 L240 74 L200 114 L144 114 L144 170 L104 210 Z" fill="currentColor" opacity="0.08" />
  <path d="M240 210 L376 210 L336 170 L336 114 L280 114 L240 74 Z" fill="currentColor" opacity="0.16" />
  <path d="M240 210 L104 210 L144 250 L144 306 L200 306 L240 346 Z" fill="currentColor" opacity="0.16" />
  <path d="M240 210 L240 346 L280 306 L336 306 L336 250 L376 210 Z" fill="currentColor" />
  <rect x="216" y="346" width="48" height="4" class="fill-acid" />
  <path d="M240 350 L300 414 L180 414 Z" fill="currentColor" />
  <rect x="104" y="414" width="272" height="12" fill="currentColor" opacity="0.16" />
</svg>
