---
// AmEtfs — Shariah ETFs: a tessellation of small 8-point star tiles (many holdings)
// enclosed in ONE circle (one traded unit), on a descending duotone plinth.
// Tiles sit on a 52-unit pitch against a 46-unit point-to-point tile so star points
// nearly touch and the field reads as an interlocking tessellation, not a dot grid;
// the center tile stays at opacity 1 as the focal holding.
// Am pillar language: filled duotone planes — fills only, zero strokes, fill-current at
// opacity 1 / 0.16 / 0.08, exactly one thin acid sliver.
interface Props { class?: string; title?: string }
const { class: className, title } = Astro.props;
---
<svg
  viewBox="0 0 360 540"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <defs>
    <clipPath id="am-etf-clip"><circle cx="180" cy="200" r="140" /></clipPath>
    <path id="am-etf-star" d="M-16 -16 H16 V16 H-16 Z M0 -23 L23 0 L0 23 L-23 0 Z" />
  </defs>
  <circle cx="180" cy="200" r="140" fill="currentColor" opacity="0.08" />
  <g clip-path="url(#am-etf-clip)" fill="currentColor">
    <use href="#am-etf-star" x="180" y="44" opacity="0.16" />
    <use href="#am-etf-star" x="76" y="96" opacity="0.16" />
    <use href="#am-etf-star" x="128" y="96" opacity="0.16" />
    <use href="#am-etf-star" x="180" y="96" opacity="0.16" />
    <use href="#am-etf-star" x="232" y="96" opacity="0.16" />
    <use href="#am-etf-star" x="284" y="96" opacity="0.16" />
    <use href="#am-etf-star" x="76" y="148" opacity="0.16" />
    <use href="#am-etf-star" x="128" y="148" opacity="0.16" />
    <use href="#am-etf-star" x="180" y="148" opacity="0.16" />
    <use href="#am-etf-star" x="232" y="148" opacity="0.16" />
    <use href="#am-etf-star" x="284" y="148" opacity="0.16" />
    <use href="#am-etf-star" x="24" y="200" opacity="0.16" />
    <use href="#am-etf-star" x="76" y="200" opacity="0.16" />
    <use href="#am-etf-star" x="128" y="200" opacity="0.16" />
    <use href="#am-etf-star" x="180" y="200" />
    <use href="#am-etf-star" x="232" y="200" opacity="0.16" />
    <use href="#am-etf-star" x="284" y="200" opacity="0.16" />
    <use href="#am-etf-star" x="336" y="200" opacity="0.16" />
    <use href="#am-etf-star" x="76" y="252" opacity="0.16" />
    <use href="#am-etf-star" x="128" y="252" opacity="0.16" />
    <use href="#am-etf-star" x="180" y="252" opacity="0.16" />
    <use href="#am-etf-star" x="232" y="252" opacity="0.16" />
    <use href="#am-etf-star" x="284" y="252" opacity="0.16" />
    <use href="#am-etf-star" x="76" y="304" opacity="0.16" />
    <use href="#am-etf-star" x="128" y="304" opacity="0.16" />
    <use href="#am-etf-star" x="180" y="304" opacity="0.16" />
    <use href="#am-etf-star" x="232" y="304" opacity="0.16" />
    <use href="#am-etf-star" x="284" y="304" opacity="0.16" />
    <use href="#am-etf-star" x="180" y="356" opacity="0.16" />
  </g>
  <rect x="132" y="352" width="96" height="6" class="fill-acid" />
  <rect x="100" y="420" width="160" height="12" fill="currentColor" />
  <rect x="124" y="444" width="112" height="12" fill="currentColor" opacity="0.16" />
  <rect x="148" y="468" width="64" height="12" fill="currentColor" opacity="0.08" />
</svg>
