---
// AmEquity — Shariah Equity: three overlapping dome silhouettes at rising scales
// (PSX / FTSE / NYSE) on stepped planes, crescent finial over the tallest dome.
// Am pillar language: filled duotone planes — fills only, zero strokes, fill-current at
// opacity 1 / 0.16 / 0.08, exactly one thin acid sliver. Renders on the ink band at 40%
// group opacity: every meaning-critical mark (all three domes, the ground plane, the
// finial, the acid seam) sits at opacity 1 and is clustered in the right ~55% of the
// viewBox so nothing solid slides beneath the band's copy column; the upper step rects
// and the left ground tail stay at 0.16 / 0.08 as secondary texture only.
interface Props { class?: string; title?: string }
const { class: className, title } = Astro.props;
---
<svg
  viewBox="0 0 960 360"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <defs>
    <path id="am-eq-dome" d="M-100 0 C-100 -110 -45 -135 0 -150 C45 -135 100 -110 100 0 Z" />
  </defs>
  <rect x="0" y="332" width="400" height="28" fill="currentColor" opacity="0.08" />
  <rect x="400" y="332" width="560" height="28" fill="currentColor" />
  <rect x="520" y="304" width="440" height="28" fill="currentColor" opacity="0.16" />
  <rect x="700" y="276" width="260" height="28" fill="currentColor" opacity="0.08" />
  <use href="#am-eq-dome" transform="translate(590 332) scale(0.7)" fill="currentColor" />
  <use href="#am-eq-dome" transform="translate(730 304) scale(1.1)" fill="currentColor" />
  <use href="#am-eq-dome" transform="translate(885 276) scale(1.5)" fill="currentColor" />
  <path d="M885 19 A15 15 0 1 0 885 49 A19 19 0 0 1 885 19 Z" fill="currentColor" />
  <rect x="400" y="328" width="120" height="4" class="fill-acid" />
</svg>
