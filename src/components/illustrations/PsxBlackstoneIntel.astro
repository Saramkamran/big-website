---
// PsxBlackstoneIntel — Blackstone Intel: minaret beacon with a crescent-held acid signal and
// concentric broadcast rings — inner ring plain arcs, outermost ring a string of tiny crescent
// glyphs (spec: "broadcast arcs of tiny crescents") escaping through the seal broken open at the
// top: the open channel. Open counterpart to PsxBlackstoneInvestments' closed seal.
// Strokes 5–6 = deliberate optical compensation for the 80–96px ledger rail this renders in
// (≈1.0–1.2px on screen, equivalent to the pillar's 1.5–2.5 fine-line weight at full size) —
// do NOT "correct" them down to 1.5–2.5 or the emblem disappears at rail scale.
interface Props { class?: string; title?: string }
const { class: className, title } = Astro.props;
---
<svg
  viewBox="0 0 480 480"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <defs>
    <!-- tiny crescent lune, 26 units wide, concave-up at identity (same construction as the beacon crescent) -->
    <path id="psx-bi-cres" d="M-13 0 A13 13 0 0 0 13 0 A18 18 0 0 1 -13 0 Z" />
  </defs>
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <!-- seal frame, broken open at the top: the channel -->
    <path d="M318 52 L428 162 L428 318 L318 428 L162 428 L52 318 L52 162 L162 52" stroke-width="6" />

    <!-- minaret -->
    <g stroke-width="6">
      <path d="M198 400 H282" />
      <path d="M222 400 L228 190" />
      <path d="M258 400 L252 190" />
      <path d="M204 252 H276" />
      <path d="M228 190 Q240 152 252 190" />
      <path d="M240 168 V132" />
    </g>

    <!-- crescent beacon -->
    <path d="M212 92 A28 28 0 0 0 268 92 A39 39 0 0 1 212 92 Z" stroke-width="5" />

    <!-- broadcast rings: inner pair as plain arcs... -->
    <g stroke-width="5">
      <path d="M182 90 A60 60 0 0 1 225 48" />
      <path d="M256 48 A60 60 0 0 1 298 90" />
    </g>
    <!-- ...outermost ring as a string of tiny crescents on a common r~72 circle around the
         signal (240 84), each concave toward it; the upper pair exits through the opening -->
    <g stroke-width="5">
      <use href="#psx-bi-cres" transform="translate(170 69) rotate(102)" />
      <use href="#psx-bi-cres" transform="translate(202 23) rotate(148)" />
      <use href="#psx-bi-cres" transform="translate(278 23) rotate(212)" />
      <use href="#psx-bi-cres" transform="translate(310 69) rotate(258)" />
    </g>
  </g>

  <!-- acid signal held by the crescent -->
  <circle cx="240" cy="84" r="6" class="fill-acid" />
</svg>
