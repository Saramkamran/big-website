---
// SsFamilyOffice — BIG Family Office: ONE monumental 8-point star assembled from four
// interlocking quadrant brackets (four family branches, one mark). Each axis seam is a
// keyed joggle — the clockwise quadrant's terminal turns 90° into an outer hook across
// the seam axis, its neighbour answers with a parallel inner hook — so the pieces
// visibly lock while the seam gaps stay open. The single acid octagon core = the single
// coordinated point of oversight.
// Ss pillar language: bold minimal marks, stroke 10 (scaled for the wide 960x360 band
// canvas), 5 elements, one acid fill. The composition rides the right edge — the east
// point converges outside the canvas at (971,180), so the ink-band layout bleeds the
// mark off-screen; the left half of the canvas stays empty air over the copy column.
interface Props { class?: string; title?: string }
const { class: className, title } = Astro.props;
---
<svg
  viewBox="0 0 960 360"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <!-- Four quadrant brackets in C4 pinwheel symmetry: each runs square corner to square
       corner and terminates in an outer hook across one seam axis plus an inner hook
       answering the next (24 apart, 22 overlap — the visible interlock) -->
  <path d="M935 189 L935 144 L920 129 L920 70 L861 70 L822 31 L797 31" stroke="currentColor" stroke-width="10" />
  <path d="M819 55 L774 55 L759 70 L700 70 L700 129 L661 168 L661 193" stroke="currentColor" stroke-width="10" />
  <path d="M685 171 L685 216 L700 231 L700 290 L759 290 L798 329 L823 329" stroke="currentColor" stroke-width="10" />
  <path d="M801 305 L846 305 L861 290 L920 290 L920 231 L959 192 L959 167" stroke="currentColor" stroke-width="10" />
  <!-- The single coordinated point of oversight: one acid octagonal core -->
  <path d="M860 159 L860 201 L831 230 L789 230 L760 201 L760 159 L789 130 L831 130 Z" class="fill-acid" />
</svg>
