---
// PwDedicatedInvestments — ornamental key interlaced in a knotwork cartouche (bespoke,
// exclusive access). Ornamental-arabesque language per design/ILLUSTRATION-SPEC.md.
interface Props { class?: string; title?: string }
const { class: className, title } = Astro.props;
---
<svg
  viewBox="0 0 480 480"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <defs>
    <g id="pwdi-side">
      <path d="M240 44 C140 118 140 362 240 436" stroke="currentColor" stroke-width="1.5" />
      <path d="M240 60 C156 126 156 354 240 420" stroke="currentColor" stroke-width="1.25" />
    </g>
    <g id="pwdi-knot">
      <path d="M226 88 C224 58 256 52 254 78" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
      <path d="M254 88 C256 58 224 52 226 78" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
    </g>
    <path id="pwdi-sq" d="M214 144 H266 V196 H214 Z" stroke="currentColor" stroke-width="1.25" />
    <path id="pwdi-teeth" d="M247 336 H271 V352 H259 V368 H271 V384 H247" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
    <path id="pwdi-bead" d="M171 231 L179 240 L171 249 L163 240 Z" fill="currentColor" />
  </defs>

  <!-- interlaced knotwork cartouche with threaded beads -->
  <use href="#pwdi-side" />
  <use href="#pwdi-side" transform="translate(480 0) scale(-1 1)" />
  <use href="#pwdi-knot" />
  <use href="#pwdi-knot" transform="rotate(180 240 240)" />
  <use href="#pwdi-bead" />
  <use href="#pwdi-bead" transform="translate(480 0) scale(-1 1)" />

  <!-- key bow: ring, 8-point star, eye -->
  <circle cx="240" cy="170" r="46" stroke="currentColor" stroke-width="1.75" />
  <use href="#pwdi-sq" />
  <use href="#pwdi-sq" transform="rotate(45 240 170)" />
  <circle cx="240" cy="170" r="9" stroke="currentColor" stroke-width="1.25" />
  <circle cx="240" cy="170" r="3" fill="currentColor" />

  <!-- stem, collar, jali-stepped bit, tip -->
  <path d="M233 216 V384 M247 216 V384" stroke="currentColor" stroke-width="1.5" />
  <path d="M226 240 H254" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
  <use href="#pwdi-teeth" />
  <use href="#pwdi-teeth" transform="translate(480 0) scale(-1 1)" />
  <path d="M233 384 L240 400 L247 384" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />

  <!-- one continuous acid hairline: the keyway thread, bow to tip -->
  <path d="M240 124 V400" class="stroke-acid" stroke-width="1.5" stroke-linecap="round" />
</svg>
