---
// SsMergersAcquisitions — M&A and Carve-Out: two heavy crescents interlocked into one
// continuous form (the merger/union), with an upper horn carved clean away along an
// offset acid cut line (the carve-out/divestiture).
// Ss pillar language: bold minimal marks — stroke 16, 4 elements, one acid fill.
interface Props { class?: string; title?: string }
const { class: className, title } = Astro.props;
---
<svg
  viewBox="0 0 360 540"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <!-- Two heavy crescent links interlocking into one continuous form (the merger/union):
       upper link opens downward, lower link opens upward, their openings clasp around the
       middle -->
  <path d="M120 286 A105 105 0 1 1 240 286" stroke="currentColor" stroke-width="20" stroke-linecap="round" />
  <path d="M240 254 A105 105 0 1 1 120 254" stroke="currentColor" stroke-width="20" stroke-linecap="round" />
  <!-- The carved-out division: a smaller crescent severed clean and set apart (the carve-out),
       drawn in acid -->
  <path d="M312 300 A34 34 0 1 1 312 362" stroke-width="14" stroke-linecap="round" class="stroke-acid" />
</svg>
