---
// PwPakistanEnergy — radial girih sunburst over an arch-framed derrick abstraction; the acid
// hairline is the energy flow. Ornamental-arabesque language per design/ILLUSTRATION-SPEC.md.
interface Props { class?: string; title?: string }
const { class: className, title } = Astro.props;
---
<svg
  viewBox="0 0 960 360"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <defs>
    <path id="pwen-sq" d="M659 59 H741 V141 H659 Z" stroke="currentColor" stroke-width="2" />
  </defs>

  <!-- ground -->
  <path d="M240 320 H944" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

  <!-- pointed arch frame, doubled -->
  <path d="M600 320 V236 C600 176 644 148 700 142 C756 148 800 176 800 236 V320" stroke="currentColor" stroke-width="2.5" />
  <path d="M616 320 V240 C616 188 652 162 700 156 C748 162 784 188 784 240 V320" stroke="currentColor" stroke-width="1.5" />

  <!-- derrick lattice -->
  <path d="M660 320 L696 168 M740 320 L704 168 M696 168 H704" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <path d="M669 280 H731 M680 236 H720 M689 196 H711" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <path d="M669 280 L720 236 M731 280 L680 236 M680 236 L711 196 M720 236 L689 196" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />

  <!-- girih sunburst -->
  <circle cx="700" cy="100" r="48" stroke="currentColor" stroke-width="2" />
  <circle cx="700" cy="100" r="60" stroke="currentColor" stroke-width="1.5" />
  <use href="#pwen-sq" />
  <use href="#pwen-sq" transform="rotate(45 700 100)" />
  <circle cx="700" cy="100" r="9" stroke="currentColor" stroke-width="2" />
  <path d="M700 34 V12 M700 166 V188 M766 100 H788 M634 100 H612 M747 53 L762 38 M653 53 L638 38 M747 147 L762 162 M653 147 L638 162" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

  <!-- one continuous acid hairline: energy flowing in from the left, up the derrick, into the core -->
  <path d="M0 292 C130 280 250 306 380 300 C480 296 540 310 620 306 C670 303 700 296 700 276 V110" class="stroke-acid" stroke-width="2.5" stroke-linecap="round" />
</svg>
