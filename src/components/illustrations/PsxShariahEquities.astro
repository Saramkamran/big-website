---
// PsxShariahEquities — Shariah Equities: girih octagon-and-diamond lattice traversed by three
// ascending strategy paths (Swing / Positional / Long-Term); acid nodes = screened opportunities.
// Psx fine line-art per design/ILLUSTRATION-SPEC.md: stroke-only, widths 1.5–2.5, round caps.
// Every zigzag vertex registers on lattice geometry (octagon vertices at center ±48/±20 and
// ±20/±48; diamond vertices at centers 165/315 ±27); mid acid nodes sit on path vertices.
interface Props { class?: string; title?: string }
const { class: className, title } = Astro.props;
---
<svg
  viewBox="0 0 480 480"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <defs>
    <path id="psx-se-oct" d="M48 -20 L48 20 L20 48 L-20 48 L-48 20 L-48 -20 L-20 -48 L20 -48 Z" />
    <path id="psx-se-dia" d="M0 -27 L27 0 L0 27 L-27 0 Z" />
  </defs>

  <!-- observatory-plate registration ticks -->
  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="opacity-60">
    <path d="M30 62 V30 H62" />
    <path d="M418 30 H450 V62" />
    <path d="M450 418 V450 H418" />
    <path d="M62 450 H30 V418" />
  </g>

  <!-- girih lattice field: octagon-and-star screen -->
  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-30">
    <use href="#psx-se-oct" x="90" y="90" />
    <use href="#psx-se-oct" x="240" y="90" />
    <use href="#psx-se-oct" x="390" y="90" />
    <use href="#psx-se-oct" x="90" y="240" />
    <use href="#psx-se-oct" x="240" y="240" />
    <use href="#psx-se-oct" x="390" y="240" />
    <use href="#psx-se-oct" x="90" y="390" />
    <use href="#psx-se-oct" x="240" y="390" />
    <use href="#psx-se-oct" x="390" y="390" />
    <use href="#psx-se-dia" x="165" y="165" />
    <use href="#psx-se-dia" x="315" y="165" />
    <use href="#psx-se-dia" x="165" y="315" />
    <use href="#psx-se-dia" x="315" y="315" />
  </g>

  <!-- three ascending strategy paths: Long-Term / Positional / Swing (zigzag vertices on lattice points) -->
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path d="M90 420 L420 90" stroke-width="2.5" />
    <path d="M70 342 L138 220 L192 260 L288 165 L342 220 L420 150" stroke-width="2" />
    <path d="M110 438 L138 370 L192 410 L220 342 L288 370 L315 288 L342 315 L420 240" stroke-width="2" />
  </g>

  <!-- screened opportunity nodes -->
  <g class="fill-acid">
    <circle cx="420" cy="90" r="6" />
    <circle cx="420" cy="150" r="6" />
    <circle cx="420" cy="240" r="6" />
    <circle cx="255" cy="255" r="4" />
    <circle cx="192" cy="260" r="4" />
    <circle cx="288" cy="370" r="4" />
  </g>
</svg>
