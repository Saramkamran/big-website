---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';

const accreditations = [
  { name: 'ACCA', label: 'ACCA Employer Accreditation' },
  { name: 'ICAP', label: 'ICAP Registered Employer' },
  { name: 'ISO/UKSAS', label: 'ISO / UKSAS Certified' },
  { name: 'MUFAP', label: 'MUFAP Member' },
  { name: 'SECP', label: 'SECP Licensed' },
  { name: 'TREC', label: 'PSX TREC Holder' },
  { name: 'PSX', label: 'Pakistan Stock Exchange' },
];

// Leadership cards + the shared bio dialog both read this array (it is also
// serialised into the page for the dialog script).
const leadership = [
  {
    name: 'Mian Muhammad Husnain Yasin',
    title: 'Founder and CEO',
    image: '/images/2.1.png',
    popupImage: '/images/2.1.png',
    alt: 'Mian Muhammad Husnain Yasin, smiling, seated at a desk in a navy double-breasted suit with a blue pocket square',
    bio: [
      'Mian Muhammad Husnain Yasin is a seasoned Chartered Accountant and wealth management executive with 25 years of professional experience in corporate reporting, finance, and investment strategy for family offices, ultra-high-net-worth individuals, and corporates.',
      'An alumnus of Cambridge Judge Business School, University of Cambridge, Husnain’s distinguished professional engagements include leading institutions and global organisations such as Army Welfare Trust (Pakistan), the Ministry of Justice (UK), Platinum Equity (USA), Novartis Pharmaceuticals (Switzerland), National Bank of Kuwait, and OneWeb (Saudi Arabia). His international exposure and understanding of Pakistan’s investment landscape have also enabled him to facilitate foreign direct investment opportunities into the country.',
      'As the Founder & CEO of Blackstone Islamic Global, Husnain leads a boutique, Shariah-enabled investment and wealth management platform specialising in equities, Sukuk, real estate, private equity, IPOs in Pakistan and the United States, and mergers and acquisitions. His approach combines rigorous research, disciplined risk management, and structured investment-to-exit strategies to pursue above-benchmark returns aligned with clients’ financial objectives and Shariah principles. A committed mentor and trusted adviser, he helps investors navigate market complexities and make informed investment decisions with greater discipline, foresight, and confidence.',
      'Beyond commitments, Husnain likes horse riding and adventure sports. He authored research on Islamic philosophy at the University of Oxford, reflecting his intellectual engagement with ethical thought and its relevance to sound business judgement, responsible decision-making, and the prudent stewardship of wealth.',
      'Humbled by the trust placed in him, Husnain is driven by a deeper purpose: to revive the timeless relationship between faith, wealth, and enterprise that flourished during the time of the Prophet Muhammad ﷺ. Inspired by the entrepreneurial spirit and commercial wisdom of the Prophet’s Companions (RA), he aspires to demonstrate how sound business understanding and astute investment decisions can work together to build exceptional wealth and social standing in a manner consistent with Islamic principles, while ultimately seeking the pleasure of Allah.',
    ],
  },
  {
    name: 'Amina Asif',
    title: 'Co-Founder and Director - Strategy & Legal',
    image: '/images/2.2.png',
    popupImage: '/images/2.2.png',
    alt: 'Amina Asif, seated at a desk in a black jacket and a cream headscarf with a gold-trimmed border, looking at the camera',
    bio: [
      'Recognised as one of the 101 Incredible Women of Pakistan, Amina is an accomplished legal and human resource professional with extensive experience across public service, legal affairs, regulatory compliance, and institutional governance.',
      'Following the First Position in LLM, Amina’s distinguished accolade includes project management of the United Nations Population Fund (UNFPA), the legal advisor to The Punjab Commission on the Status of Women, executive tasks to The Office of The Prime Minister of Pakistan, and organisations operating under the mandates of the Governments of Pakistan and Japan.',
      'An orator and one of only ten UNFPA-approved trainers in Pakistan, Amina has coached and mentored prominent bureaucrats, politicians, and corporate heads such as FFC leadership team on legal, regulatory, and compliance matters, earning recognition for her professional insight and commitment to institutional excellence.',
      'Combining her professional expertise and persona, Amina co-founded Blackstone Islamic Global alongside her husband, Mian Muhammad Husnain Yasin. As Director - Strategy & Legal, she plays a pivotal role in shaping the company’s strategic direction, strengthening its corporate governance, and overseeing its legal and compliance framework. Her commitment to sound governance and expectations management helps safeguard stakeholder interests and uphold the highest standards of professionalism.',
      'Beside commitments, Amina captained the basketball team at the Sacred Heart Cathedral High School, Lahore and played the netball and baseball with Kinnaird College for Women Lahore, winning numerous prizes and honours in recognition of her athletic ability, team spirit, and leadership.',
    ],
  },
];

const values = [
  { title: 'Integrity',    body: 'Truthful to all stakeholders.' },
  { title: 'Intelligence', body: 'To act smartly.' },
  { title: 'Impact',       body: 'Targeting value and wealth.' },
];

// The BIG Journey, split one card per existing paragraph. Wording is verbatim;
// only the card headings are new, taken from the year each paragraph opens with.
const journey = [
  {
    heading: '2002',
    body: `The BIG journey began in 2002, when our founding member, Muhammad Husnain Yasin, received PKR 25,000 in support from his mother to make his first investment in the Pakistan Stock Exchange. With little knowledge but a willingness to learn, discipline, and patience, his investment grew steadily, helping him support his family and fund his professional education.`,
  },
  {
    heading: '2006',
    body: `In 2006, Husnain moved to England, where he earned his Chartered Accountant qualification from ICAEW. Over the following 15 years, he progressed from assistant accountant to Board level leadership, gaining experience across industries and major economic cycles, including the 2008 Global Financial Crisis. These experiences and relationships shaped his belief that wealth is most meaningful when built through Shariah enabled investments.`,
  },
  {
    heading: '2021',
    body: `An alumnus of Cambridge Judge Business School, and with academic engagement at the University of Oxford, Husnain returned to Pakistan in 2021; and founded Blackstone Islamic Global to help others approach investing with entrepreneurial acumen and foresight.`,
  },
  {
    heading: 'Our ambition',
    body: `What began with PKR 25,000 support from his mother has grown into an inspiring ambition to help individuals and institutional clients build, preserve, and steward wealth with wisdom, faith, and agility.`,
  },
];
---

<BaseLayout
  title="Our Firm | Blackstone Islamic Global"
  description="Learn about Blackstone Islamic Global, our mission, accreditations, and leadership team."
>
  <div class="firm">

    {/* 1 — Page header block. Stacked and left aligned: eyebrow, H1, intro,
        Share, then the button, with the vertical rhythm from the reference. */}
    <section class="bg-paper firm-header">
      <div class="firm-container">
        <p class="firm-eyebrow font-sans">Our Firm</p>

        <h1 class="firm-h1 font-serif text-ink">24 Years of Excellence</h1>

        <p class="firm-intro font-sans">
          Since inception, our business philosophy has remained simple: unlock fundamentally strong, technically sound, and sentimentally stable investments. Yet, above all, our pursuit of excellence has always centred on exceptional service, trusted relationships, and meaningful delivery for our esteemed clients.
        </p>

        <button type="button" class="firm-share font-sans" id="firm-share" aria-label="Share this page">
          <span>Share</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
            <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
            <path d="M8.6 10.6 15.4 6.6M8.6 13.4 15.4 17.4" />
          </svg>
        </button>

      </div>
    </section>

    {/* 1b — Image gallery: four portrait tiles directly under the intro. Same
        container as the heading above so the left edges line up. */}
    <section class="bg-paper firm-gallery">
      <div>
        <div class="firm-gallery-grid">
          <img
            src="/images/big-1.7.jpg"
            alt="Two men holding a glass award trophy in front of an ICAEW backdrop, one in dark traditional dress and one smiling in a navy suit"
            width="854" height="1280" loading="lazy"
          />
          <img
            src="/images/2.0.jpg"
            alt="Magazine page from 'Incredible Women of Power', part of the 101 Incredible Women CEOs of Pakistan series, featuring a portrait of a woman in pink"
            width="917" height="1280" loading="lazy"
          />
          <img
            src="/images/2.3.jpg"
            alt="A woman in an orange scarf presenting to seated attendees at a training workshop, with a projector screen and green-covered tables"
            width="1280" height="789" loading="lazy"
          />
          <img
            src="/images/big-1.3.jpg"
            alt="Two men holding a framed piece of Arabic calligraphy, one in a striped shirt and purple tie, the other in a dark blazer and glasses"
            width="979" height="1280" loading="lazy"
          />
        </div>
      </div>
    </section>


    {/* 3 — Mission statement, then About Us */}
    <section class="bg-paper firm-statement-section">
      <div class="firm-container">
        <p class="firm-statement font-serif text-copy">
          Inspire to be the world's number one Shariah enabled financial prosperity advisors
        </p>

      </div>
    </section>

    {/* 3b — About Us, on bg-mist so it separates from the statement above and
        Our Values below. Sticky label column, then lead, pull quote, body and
        the ruled list. Every word is the existing copy. */}
    <section class="bg-mist firm-section" id="about-us">
      <div class="firm-container">
        <div class="firm-aboutus">
          <div class="firm-aboutus-side">
            <p class="firm-eyebrow-sm font-sans">About Us</p>
            <h2 class="firm-aboutus-h2 font-serif text-ink">About Us</h2>
            <span class="firm-rule" aria-hidden="true"></span>
          </div>

          <div class="firm-aboutus-main">
            <p class="firm-lead font-sans text-copy" data-reveal>
              Blackstone Islamic Global 'BIG' is a Shariah enabled brokerage, asset management, and wealth management consultancy serving institutional and individual clients globally. Our practice combines deep markets research and expertise to deliver structured and faith-aligned investment solutions.
            </p>

            <blockquote class="firm-quote" data-reveal>
              <p class="firm-quote-text font-serif text-copy">
                At BIG, we believe that adherence to Shariah principles and the pursuit of superior performance are not competing objectives, they are mutually reinforcing.
              </p>
            </blockquote>
            <p class="firm-quote-after font-sans" data-reveal>
              Our approach is built on transparency, trust, and a long-term commitment to our clients' financial well-being and legacy
            </p>

            <p class="firm-body font-sans" data-reveal>
              We also provide access to Pakistan's private equity, real estate, and specialized professional services including M&amp;A, IPOs, and family office management.
            </p>

            {/* Labels drawn only from the wording above. Rendered as plain rows:
                the five entries do not map one to one onto the four What We Do
                pages, so they are not linked. */}
            <ol class="firm-dolist">
              {[
                'Shariah enabled brokerage',
                'Asset management',
                'Wealth management consultancy',
                "Access to Pakistan's private equity and real estate",
                'M&A, IPOs and family office management',
              ].map((item, i) => (
                <li class="firm-dorow" data-reveal>
                  <span class="firm-doindex font-sans">{String(i + 1).padStart(2, '0')}</span>
                  <span class="firm-dolabel font-serif text-ink">{item}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    {/* 4 — Our Values */}
    <section class="firm-values-section">
      <div class="firm-container">
        <h2 class="firm-values-h2 font-serif font-normal">Our Values</h2>
        <ul class="firm-values-list">
          {values.map((v, i) => (
            <li class="firm-value-item">
              <span class="firm-value-num font-serif" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="firm-value-name font-serif font-normal">{v.title}</h3>
              <p class="firm-value-body no-justify font-sans">{v.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* 5 — Photo mosaic. Three unique photos, so one wide tile then two below. */}
    <section class="bg-paper firm-mosaic-section">
      <div class="firm-mosaic-wrap">
        <div class="firm-mosaic">
          <img
            src="/images/big-1.9.jpg"
            alt="About twenty colleagues in business attire standing in a row on a stage in front of an ICAEW backdrop"
            class="firm-mosaic-wide" loading="lazy" width="1280" height="854"
          />
          <img
            src="/images/big-1.6.jpg"
            alt="Group photo of staff and guests in a lecture hall with a large 'CA Pakistan' logo on the wall behind them"
            class="firm-mosaic-left" loading="lazy" width="1280" height="853"
          />
          <img
            src="/images/big-1.1.jpg"
            alt="Man in a striped shirt and purple tie speaking into a microphone at a wooden podium, with a University of Lahore School of Accountancy &amp; Finance sign behind him"
            class="firm-mosaic-right" loading="lazy" width="1380" height="1840"
          />
        </div>
      </div>
    </section>

    {/* 6 — The BIG Journey band */}
    <section class="bg-mist firm-section" id="journey">
      <div class="firm-container">
        <div class="firm-split firm-heritage">
          <div>
            <p class="firm-eyebrow-sm font-sans">Our Heritage</p>
            <h2 class="firm-h2 font-serif text-ink">The BIG Journey</h2>
          </div>
          <div class="firm-prose">
            <p>
              This philosophy has evolved through an epic journey, shaping who we are today and continuing to guide us towards tomorrow.
            </p>
          </div>
        </div>
      </div>

      {/* Track starts at the container gutter but bleeds right, so the last card is clipped. */}
      <div
        class="firm-track"
        id="firm-track"
        role="group"
        aria-label="The BIG Journey, scrollable timeline"
        tabindex="0"
      >
        {journey.map((c) => (
          <article class="firm-card bg-paper">
            <h3 class="firm-card-title font-sans text-ink">{c.heading}</h3>
            <p class="firm-card-body font-sans">{c.body}</p>
          </article>
        ))}
      </div>

      <div class="firm-container">
        <div class="firm-controls">
          <button type="button" class="firm-nav" id="firm-prev" aria-label="Previous card" aria-controls="firm-track" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M15 5 8 12l7 7" /></svg>
          </button>
          <button type="button" class="firm-nav" id="firm-next" aria-label="Next card" aria-controls="firm-track">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
        <p class="firm-pdflink-wrap">
          <a
            href="/the-big-journey.pdf"
            class="firm-pdflink font-sans"
            download
            type="application/pdf"
          >Download as PDF<span class="sr-only"> (PDF)</span></a>
        </p>
      </div>
    </section>

    {/* 7 — Vendor Selection Programme + Accreditations list */}
    <section class="bg-paper firm-section">
      <div class="firm-container">
        <div class="firm-split firm-vendor">
          <div>
            <h2 class="firm-h2 font-serif text-ink">Vendor Selection Programme</h2>
            <p class="firm-prose firm-vendor-body">
              Our Vendor Selection Programme enables us to work with professionally vetted and reputable organisations, allowing us to deliver market leading services and solutions to our clients.
            </p>
          </div>
          <div>
            <p class="firm-eyebrow-sm font-sans">Accreditations &amp; Memberships</p>
            <ul class="firm-list">
              {accreditations.map((acc) => (
                <li class="firm-list-row">
                  <span class="firm-list-name font-sans text-ink">{acc.name}</span>
                  <span class="firm-list-label font-sans">{acc.label}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* 8 — Leadership and Board */}
    <section class="bg-mist firm-section">
      <div class="firm-container">
        <p class="firm-eyebrow-sm font-sans">Leadership &amp; Board</p>
        <h2 class="firm-h2 font-serif text-ink firm-leader-head">Experienced. Principled. Client-Focused.</h2>

        <div class="firm-people">
          {leadership.map((person, i) => (
            <article class="firm-person">
              <button type="button" class="firm-person-btn" data-bio={i} aria-haspopup="dialog">
                <span class="firm-portrait">
                  <img src={person.image} alt={person.alt} loading="lazy" width="1280" height="853" />
                </span>
                <span class="firm-person-name font-sans text-copy">{person.name}</span>
              </button>
              <p class="firm-person-title font-sans">{person.title}</p>
              <button type="button" class="firm-person-more font-sans" data-bio={i} aria-haspopup="dialog" aria-label={`View bio of ${person.name}`}>View bio +</button>
            </article>
          ))}
        </div>

        {/* One shared bio dialog, filled from the leadership data by the script below. */}
        <dialog id="firm-bio" class="firm-bio" aria-labelledby="firm-bio-name">
          <div class="firm-bio-panel">
            <button type="button" class="firm-bio-close" aria-label="Close">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <div class="firm-bio-photo"><img id="firm-bio-img" src="" alt="" /></div>
            <div class="firm-bio-text" id="firm-bio-text" tabindex="0">
              <p class="firm-bio-role font-sans no-justify" id="firm-bio-role"></p>
              <h3 class="firm-bio-name font-serif font-normal" id="firm-bio-name"></h3>
              <span class="firm-bio-bar" aria-hidden="true"></span>
              <div id="firm-bio-body"></div>
            </div>
          </div>
        </dialog>
        <script is:inline type="application/json" id="firm-bios" set:html={JSON.stringify(leadership.map(({ name, title, popupImage, alt, bio }) => ({ name, role: title, image: popupImage, alt, bio })))}></script>

      </div>
    </section>

    {/* 9 — Closing CTA. Copy, image and button are unchanged; only the heading
        scale is lifted, via a page-scoped override so the shared component and
        every other page that uses it stay exactly as they are. */}
    <div class="firm-cta">
      <ContactCTA
        headline="Speak with Our Team"
        subtext="We would welcome the opportunity to discuss how BIG can serve your investment and advisory needs."
        image="/images/person.jpg"
        imageAlt="Smiling woman in a cream hijab and white patterned blouse working on a laptop at an outdoor table, with an orange building behind her"
      />
    </div>
  </div>
</BaseLayout>

<style>
  /* ────────────────────────────────────────────────────────────────────────
     Our Firm, editorial layout. Everything is scoped under .firm and to this
     page only, so no other route and no shared component changes behavior.
     Colors come exclusively from the existing tokens: no new values.
     ──────────────────────────────────────────────────────────────────────── */

  /* One shared container with equal gutters: 20px mobile, 50px from 1024px,
     100px from 1700px. Content and images run its full width. */
  .firm-container {
    width: 100%;
    padding-left: 20px;
    padding-right: 20px;
  }
  @media (min-width: 1024px) {
    .firm-container { padding-left: 50px; padding-right: 50px; }
  }
  @media (min-width: 1700px) {
    .firm-container { padding-left: 100px; padding-right: 100px; }
  }

  .firm-section       { padding-block: clamp(64px, 8vw, 128px); }
  .firm-section-tight { padding-block: clamp(32px, 4vw, 56px); }

  /* 1 — page header block. Spacing steps follow the reference: eyebrow sits
     ~90px below the navbar, H1 ~16px under it, intro ~50px under the H1,
     Share ~50px under the intro, button ~90px under Share, then ~80px clear
     before the hero image. */
  .firm-header {
    padding-top: clamp(48px, 6.2vw, 90px);
    padding-bottom: clamp(48px, 5.5vw, 80px);
  }

  .firm-eyebrow {
    font-size: clamp(15px, 1.4vw, 20px);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--body-text);
    margin: 0 0 16px;
  }

  .firm-h1 {
    font-weight: 300;
    font-size: clamp(48px, 7vw, 100px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0;
    /* Keeps "24 Years of Excellence" on one line on desktop; wraps on mobile. */
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .firm-h1 { white-space: normal; }
  }

  .firm-intro {
    font-size: clamp(20px, 2.3vw, 34px);
    line-height: 1.5;
    color: var(--body-text);
    margin: clamp(28px, 3.4vw, 50px) 0 0;
    /* No max-width: it spans the container and wraps to about 3 lines wide. */
  }

  .firm-share {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(28px, 3.4vw, 50px);
    padding: 10px 2px;          /* 44px tap target without a visible box */
    min-height: 44px;
    background: none;
    border: 0;
    cursor: pointer;
    font-size: clamp(16px, 1.4vw, 20px);
    font-weight: 500;
    color: var(--ink);
  }
  .firm-share svg { width: 20px; height: 20px; }
  .firm-share:hover span { text-decoration: underline; text-underline-offset: 4px; }
  .firm-share:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }


  /* 1b — image gallery: full-bleed strip (no container, no side padding, no gaps).
     4 columns from 1024px, 2 below. Tiles are cropped with the crop anchored high so
     faces stay in frame; white space above and below only. */
  .firm-gallery { padding-block: 64px; padding-inline: 0; margin: 0; }
  .firm-gallery > div { width: 100%; max-width: none; margin: 0; padding: 0; }
  .firm-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    width: 100%;
  }
  .firm-gallery-grid img {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
  }
  @media (max-width: 767px) {
    .firm-gallery { padding-block: 40px; }
  }
  @media (min-width: 1024px) {
    .firm-gallery-grid { grid-template-columns: repeat(4, 1fr); }
    .firm-gallery-grid img { aspect-ratio: 3 / 4; }
  }


  /* 3 — mission statement + About Us */
  /* Fills the container: no max-width, no ch cap, no balance. `pretty` only
     improves the last-line break, it does not shorten the measure. */
  .firm-statement {
    width: 100%;
    max-width: none;
    font-weight: 300;
    font-size: clamp(40px, 6.6vw, 112px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: pretty;
    margin: 0;
  }

  .firm-split {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(28px, 5vw, 72px);
  }
  @media (max-width: 900px) { .firm-split { grid-template-columns: 1fr; } }

  /* ~100px of air above and below the statement on desktop. */
  .firm-statement-section { padding-block: clamp(56px, 7vw, 100px); }

  /* ── About Us ──────────────────────────────────────────────────────────── */
  .firm-aboutus {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 60px;
  }
  .firm-aboutus-side { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + 40px); align-self: start; }
  .firm-aboutus-main { grid-column: 5 / span 8; }

  @media (max-width: 1023px) {
    .firm-aboutus { grid-template-columns: 1fr; gap: 32px; }
    .firm-aboutus-side { grid-column: auto; position: static; }
    .firm-aboutus-main { grid-column: auto; }
  }

  .firm-aboutus-h2 {
    font-weight: 400;
    font-size: clamp(40px, 4.5vw, 64px);
    line-height: 1;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .firm-rule {
    display: block;
    width: 48px;
    height: 2px;
    background: var(--ink);
    margin-top: 24px;
  }

  .firm-lead {
    font-size: clamp(22px, 2.3vw, 34px);
    line-height: 1.45;
    margin: 0;
  }

  .firm-quote {
    margin: clamp(40px, 4.5vw, 64px) 0 0;
    padding-left: 28px;
    border-left: 2px solid var(--ink);
  }
  .firm-quote-text {
    font-weight: 300;
    font-size: clamp(28px, 3.2vw, 48px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .firm-quote-after {
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.5;
    color: var(--body-text);
    margin: 24px 0 0;
  }

  .firm-body {
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.5;
