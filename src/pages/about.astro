<script>
  /* Carousel: prev/next scroll by exactly one card, and the buttons disable at
     each end. Arrow keys work when the track itself has focus. */
  const track = document.getElementById('firm-track');
  const prev  = document.getElementById('firm-prev') as HTMLButtonElement | null;
  const next  = document.getElementById('firm-next') as HTMLButtonElement | null;

  if (track && prev && next) {
    const step = () => {
      const card = track.querySelector('.firm-card') as HTMLElement | null;
      if (!card) return 346;
      const gap = parseFloat(getComputedStyle(track).columnGap || '20') || 20;
      return card.offsetWidth + gap;
    };

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next.addEventListener('click', () => track.scrollBy({ left:  step() }));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); track.scrollBy({ left:  step() }); }
      if (e.key === 'ArrowLeft')  { e.preventDefault(); track.scrollBy({ left: -step() }); }
    });

    sync();
  }

  /* Share: native share sheet where available, otherwise copy the URL. */
  const share = document.getElementById('firm-share');
  share?.addEventListener('click', async () => {
    const label = share.querySelector('span');
    const url = window.location.href;
    try {
      if (navigator.share) {
        await navigator.share({ title: document.title, url });
      } else {
        await navigator.clipboard.writeText(url);
        if (label) {
          const original = label.textContent;
          label.textContent = 'Link copied';
          setTimeout(() => { label.textContent = original; }, 2000);
        }
      }
    } catch {
      /* dismissed or blocked: nothing to do */
    }
  });
</script>

<script>
  /* Leadership bio dialog. Data comes from the JSON the page embeds. Native
     <dialog>.showModal() gives Esc, an inert page and the top layer; this adds
     backdrop-click, a Tab trap, focus return, scroll lock and animated close. */
  type Bio = { name: string; role: string; image: string; alt: string; bio: string[] };

  const dlg = document.getElementById('firm-bio') as HTMLDialogElement | null;
  const dataEl = document.getElementById('firm-bios');

  if (dlg && dataEl) {
    const people: Bio[] = JSON.parse(dataEl.textContent || '[]');
    const photo = dlg.querySelector('#firm-bio-img') as HTMLImageElement;
    const roleEl = dlg.querySelector('#firm-bio-role') as HTMLElement;
    const nameEl = dlg.querySelector('#firm-bio-name') as HTMLElement;
    const bodyEl = dlg.querySelector('#firm-bio-body') as HTMLElement;
    const textEl = dlg.querySelector('#firm-bio-text') as HTMLElement;
    const closeBtn = dlg.querySelector('.firm-bio-close') as HTMLButtonElement;
    const html = document.documentElement;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let opener: HTMLElement | null = null;
    let closing = false;

    /* Lock page scroll without a layout shift: keep the scrollbar's space reserved. */
    const lock = () => {
      const scrollbar = window.innerWidth - html.clientWidth;
      if (window.CSS && CSS.supports('scrollbar-gutter', 'stable')) {
        html.style.scrollbarGutter = 'stable';
      } else if (scrollbar > 0) {
        html.style.paddingRight = `${scrollbar}px`;
      }
      html.style.overflow = 'hidden';
    };
    const unlock = () => {
      html.style.overflow = '';
      html.style.scrollbarGutter = '';
      html.style.paddingRight = '';
    };

    const open = (index: number, trigger: HTMLElement) => {
      const p = people[index];
      if (!p) return;
      opener = trigger;
      closing = false;
      dlg.classList.remove('is-closing');
      photo.src = p.image;
      photo.alt = p.alt;
      roleEl.textContent = p.role;
      nameEl.textContent = p.name;
      bodyEl.replaceChildren(
        ...p.bio.map((text) => {
          const para = document.createElement('p');
          para.className = 'firm-bio-p no-justify';
          para.textContent = text;
          return para;
        })
      );
      textEl.scrollTop = 0;
      lock();
      dlg.showModal();
      closeBtn.focus();
    };

    const close = () => {
      if (!dlg.open || closing) return;
      closing = true;
      dlg.classList.add('is-closing');
      window.setTimeout(() => {
        dlg.classList.remove('is-closing');
        dlg.close();
      }, reduceMotion.matches ? 1 : 200);
    };

    /* Focus returns to the card that opened it; scroll unlocks whichever way it closed. */
    dlg.addEventListener('close', () => {
      unlock();
      closing = false;
      opener?.focus();
      opener = null;
    });
    /* Esc: run the exit animation instead of closing instantly. */
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    /* A click that lands on the dialog frame itself (outside the panel) is a backdrop click. */
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    closeBtn.addEventListener('click', close);

    /* Tab / Shift+Tab cycle between the close button and the scrollable text. */
    dlg.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const items = Array.from(
        dlg.querySelectorAll<HTMLElement>('button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])')
      );
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    document.querySelectorAll<HTMLElement>('[data-bio]').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.bio), btn));
    });
  }
</script>
