---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ArrowLink from '../components/ArrowLink.astro';
import ContactCTA from '../components/ContactCTA.astro';
import AboutConstruction from '../components/illustrations/AboutConstruction.astro';

const accreditations = [
  { name: 'ACCA', label: 'ACCA Employer Accreditation' },
  { name: 'ICAP', label: 'ICAP Registered Employer' },
  { name: 'ISO/UKSAS', label: 'ISO / UKSAS Certified' },
  { name: 'MUFAP', label: 'MUFAP Member' },
  { name: 'SECP', label: 'SECP Licensed' },
  { name: 'TREC', label: 'PSX TREC Holder' },
  { name: 'PSX', label: 'Pakistan Stock Exchange' },
];

const leadership = [
  { name: '[Name Placeholder]', title: 'Chief Executive Officer', image: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=600&q=80' },
  { name: '[Name Placeholder]', title: 'Chief Investment Officer', image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=600&q=80' },
  { name: '[Name Placeholder]', title: 'Head of Private Wealth', image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80' },
  { name: '[Name Placeholder]', title: 'Head of Asset Management', image: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&w=600&q=80' },
];
---

<BaseLayout
  title="Our Firm | Blackstone Islamic Global"
  description="Learn about Blackstone Islamic Global — our mission, accreditations, and leadership team."
>
  <!-- Our Firm statement -->
  <section class="py-section bg-paper border-b border-line relative overflow-hidden">
    <!-- Drafting-table construction pinned behind the statement (decorative) -->
    <div
      class="pointer-events-none select-none absolute -top-8 -right-12 w-48 md:-top-10 md:-right-16 md:w-[26rem] lg:w-[32rem] xl:w-[36rem] text-ink opacity-[0.12]"
      aria-hidden="true"
    >
      <AboutConstruction class="w-full h-auto" />
    </div>
    <div class="container-big relative">
      <p class="label mb-6">Our Firm</p>
      <h1 class="font-serif font-normal text-ink mb-16" style="font-size: clamp(40px, 6.5vw, 88px); line-height: 1.05; max-width: 960px;">
        Inspire to be the world's number one Shariah-compliant financial prosperity advisors
      </h1>

      <!-- Three photo row -->
      <div class="grid grid-cols-3 gap-4 mb-16">
        <div class="aspect-[4/3] bg-mist overflow-hidden">
          <img src="https://images.unsplash.com/photo-1573164574511-73c773193279?auto=format&fit=crop&w=800&q=80" alt="BIG team at work" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="aspect-[4/3] bg-mist overflow-hidden">
          <img src="https://images.unsplash.com/photo-1622675363311-3e1904dc1885?auto=format&fit=crop&w=800&q=80" alt="Investment advisory meeting" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="aspect-[4/3] bg-mist overflow-hidden">
          <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80" alt="BIG investment research in action" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>

      <!-- Narrative -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-4">
          <h2 class="font-serif font-normal text-ink mb-4" style="font-size: clamp(28px, 2.8vw, 38px); line-height: 1.2;">
            About Us
          </h2>
        </div>
        <div class="lg:col-span-8 space-y-5 font-sans text-base text-stone leading-relaxed">
          <p>
            Blackstone Islamic Global 'BIG' is a Shariah-compliant brokerage, asset management, and wealth management consultancy serving institutional and individual clients globally. Our practice combines deep markets research and expertise to deliver structured and faith-aligned investment solutions.
          </p>
          <p>
            We also provide access to Pakistan's private equity, real estate, and specialized professional services including M&amp;A, IPOs, and family office management.
          </p>
          <p>
            At BIG, we believe that adherence to Shariah principles and the pursuit of superior performance are not competing objectives, they are mutually reinforcing. Our approach is built on transparency, trust, and a long-term commitment to our clients' financial well-being and legacy
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Approach -->
  <section class="py-section bg-mist">
    <div class="container-big">
      <!-- Emblem header: the construction resolved — thin construction rules, one result stroke -->
      <div class="flex flex-col items-center text-center mb-16">
        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-24 h-24 text-ink mb-6" aria-hidden="true" focusable="false">
          <circle cx="32" cy="32" r="22" stroke="currentColor" stroke-width="0.75" class="opacity-60" />
          <path d="M32 5 V59 M5 32 H59" stroke="currentColor" stroke-width="0.75" class="opacity-60" />
          <path d="M13 13 L51 51 M51 13 L13 51" stroke="currentColor" stroke-width="0.75" class="opacity-60" />
          <path d="M16.4 16.4 H47.6 V47.6 H16.4 Z" stroke="currentColor" stroke-width="0.75" class="opacity-70" />
          <path d="M32 10 L54 32 L32 54 L10 32 Z" stroke="currentColor" stroke-width="0.75" class="opacity-70" />
          <path d="M32 10 L38.4 16.4 L47.6 16.4 L47.6 25.6 L54 32 L47.6 38.4 L47.6 47.6 L38.4 47.6 L32 54 L25.6 47.6 L16.4 47.6 L16.4 38.4 L10 32 L16.4 25.6 L16.4 16.4 L25.6 16.4 Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          <circle cx="32" cy="32" r="1.5" fill="currentColor" />
        </svg>
        <h2 class="font-serif font-normal text-ink" style="font-size: clamp(32px, 3.5vw, 48px); line-height: 1.1;">
          Our Values
        </h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div>
          <div class="w-8 h-1 bg-acid mb-5"></div>
          <h3 class="font-sans font-bold text-sm text-ink uppercase tracking-wide mb-4">Integrity</h3>
          <p class="font-sans text-sm text-stone leading-relaxed">
            Truthful to all stakeholders.
          </p>
        </div>
        <div>
          <div class="w-8 h-1 bg-acid mb-5"></div>
          <h3 class="font-sans font-bold text-sm text-ink uppercase tracking-wide mb-4">Intelligence</h3>
          <p class="font-sans text-sm text-stone leading-relaxed">
            To act smartly.
          </p>
        </div>
        <div>
          <div class="w-8 h-1 bg-acid mb-5"></div>
          <h3 class="font-sans font-bold text-sm text-ink uppercase tracking-wide mb-4">Impact</h3>
          <p class="font-sans text-sm text-stone leading-relaxed">
            Targeting value and wealth.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 24 Years of Excellence + The BIG Journey -->
  <section class="py-section bg-paper border-t border-line">
    <div class="container-big">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-16">
        <div class="lg:col-span-4">
          <p class="label mb-4">Our Heritage</p>
          <h2 class="font-serif font-normal text-ink" style="font-size: clamp(28px, 2.8vw, 38px); line-height: 1.2;">
            24 Years of Excellence
          </h2>
        </div>
        <div class="lg:col-span-8 space-y-5 font-sans text-base text-stone leading-relaxed">
          <p>
            Since inception, our business philosophy has remained simple: unlock fundamentally strong, technically sound, and sentimentally stable investments. Yet, above all, our pursuit of excellence has always centred on exceptional service, trusted relationships, and meaningful delivery for our esteemed clients.
          </p>
          <p>
            This philosophy has evolved through an epic journey, shaping who we are today and continuing to guide us towards tomorrow.
          </p>
        </div>
      </div>

      <!-- The BIG Journey — boxed -->
      <div class="border border-line p-8 lg:p-14">
        <p class="label mb-4">The BIG Journey</p>
        <div class="space-y-5 font-sans text-base text-stone leading-relaxed max-w-3xl">
          <p>
            The BIG journey began in 2002, when our founding member, Muhammad Husnain Yasin, received PKR 25,000 in support from his mother to make his first investment in the Pakistan Stock Exchange. With little knowledge but a willingness to learn, discipline, and patience, his investment grew steadily, helping him support his family and fund his professional education.
          </p>
          <p>
            In 2006, Husnain moved to England, where he earned his Chartered Accountant qualification from ICAEW. Over the following 15 years, he progressed from assistant accountant to Board level leadership, gaining experience across industries and major economic cycles, including the 2008 Global Financial Crisis. These experiences and relationships shaped his belief that wealth is most meaningful when built through Shariah-compliant investments.
          </p>
          <p>
            An alumnus of Cambridge Judge Business School, and with academic engagement at the University of Oxford, Husnain returned to Pakistan in 2021; and founded Blackstone Islamic Global to help others approach investing with entrepreneurial acumen and foresight.
          </p>
          <p>
            What began with PKR 25,000 support from his mother has grown into an inspiring ambition to help individuals and institutional clients build, preserve, and steward wealth with wisdom, faith, and agility.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Vendor Selection Programme -->
  <section class="py-section bg-mist border-t border-line">
    <div class="container-big">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-4">
          <h2 class="font-serif font-normal text-ink" style="font-size: clamp(28px, 2.8vw, 38px); line-height: 1.2;">
            Vendor Selection Programme
          </h2>
        </div>
        <div class="lg:col-span-8 font-sans text-base text-stone leading-relaxed">
          <p>
            Our Vendor Selection Programme enables us to work with professionally vetted and reputable organisations, allowing us to deliver market leading services and solutions to our clients.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Accreditations -->
  <section class="py-section bg-paper border-t border-line">
    <div class="container-big">
      <p class="label mb-8">Accreditations & Memberships</p>
      <div class="flex flex-wrap items-center gap-6">
        {accreditations.map(acc => (
          <div class="border border-line px-6 py-4 flex items-center justify-center gap-2.5 min-w-[140px]">
            <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0 text-stone" aria-hidden="true" focusable="false">
              <path d="M4.2 4.2 H11.8 V11.8 H4.2 Z" stroke="currentColor" stroke-width="1.2" />
              <path d="M8 2.6 L13.4 8 L8 13.4 L2.6 8 Z" stroke="currentColor" stroke-width="1.2" />
            </svg>
            <span class="font-sans font-bold text-sm text-ink tracking-wide">{acc.name}</span>
          </div>
        ))}
      </div>
      <p class="font-sans text-xs text-stone mt-6">
        ACCA · ICAP · ISO/UKSAS · MUFAP · SECP · TREC · PSX
      </p>
    </div>
  </section>

  <!-- Leadership -->
  <section class="py-section bg-mist border-t border-line">
    <div class="container-big">
      <p class="label mb-6">Leadership & Board</p>
      <h2 class="font-serif font-normal text-ink mb-12" style="font-size: clamp(32px, 3.5vw, 48px); line-height: 1.1;">
        Experienced. Principled. Client-Focused.
      </h2>
      <!-- ONE shared pointed-arch (mihrab) clip for all four portraits; objectBoundingBox scales with each box -->
      <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
        <defs>
          <clipPath id="about-arch-frame" clipPathUnits="objectBoundingBox">
            <path d="M0.5 0 C0.68 0.05 0.97 0.14 1 0.3 L1 1 L0 1 L0 0.3 C0.03 0.14 0.32 0.05 0.5 0 Z" />
          </clipPath>
        </defs>
      </svg>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {leadership.map(person => (
          <div>
            <div class="aspect-[3/4] bg-stone/10 mb-4 overflow-hidden" style="clip-path: url(#about-arch-frame); -webkit-clip-path: url(#about-arch-frame);">
              <img
                src={person.image}
                alt={person.name}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <p class="font-sans font-semibold text-sm text-ink mb-1">{person.name}</p>
            <p class="font-sans text-xs text-stone">{person.title}</p>
          </div>
        ))}
      </div>
      <p class="font-sans text-xs text-stone mt-8 italic">
        Leadership profiles are placeholder pending client confirmation.
      </p>
    </div>
  </section>

  <ContactCTA
    headline="Speak with Our Team"
    subtext="We would welcome the opportunity to discuss how BIG can serve your investment and advisory needs."
    image="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=1200&q=80"
    imageAlt="BIG wealth advisor in client consultation"
  />
</BaseLayout>
