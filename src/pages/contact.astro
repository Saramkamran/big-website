---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ContactPortal from '../components/illustrations/ContactPortal.astro';
import GeometricPattern from '../components/illustrations/GeometricPattern.astro';

const sent = Astro.url.searchParams.get('sent') === 'true';
const errorType = Astro.url.searchParams.get('error');
const errorMessage = errorType === 'validation'
  ? 'Please check the required fields and enter a valid email address, then try again.'
  : errorType
    ? 'Sorry — we could not send your message just now. Please try again, or email us directly.'
    : '';

const services = [
  'Shariah Equities',
  'Shariah Equities — Portfolio Consultancy',
  'Shariah Equities — Portfolio Supervision',
  'Sukuks and Green Sukuks',
  'Transaction Services',
  'Blackstone Intel (WhatsApp Channel)',
  'Asset Management — Shariah Fixed Income Funds',
  'Asset Management — Shariah Equity Funds',
  'Asset Management — Shariah ETF',
  'Asset Management — Shariah Multi-Asset Funds',
  'Asset Management — Shariah Pensions',
  'Private Wealth — Wealth Planning',
  'Private Wealth — Private Equity',
  'Private Wealth — Pakistan Energy',
  'Private Wealth — Real Estate',
  'Specialized — Basirah Family Office',
  'Specialized — Lifestyle Management',
  'Specialized — PR Campaign',
  'Specialized — Philanthropy and Zakat',
  'Specialized — M&A and Carve Out',
  'Specialized — Initial Public Offer',
  'Specialized — Professional Services',
  'General Enquiry',
];

---

<BaseLayout
  title="Contact | Blackstone Islamic Global"
  description="Get in touch with Blackstone Islamic Global — our team is ready to assist with your Shariah-compliant investment enquiries."
>
  <section class="py-section bg-paper border-b border-line">
    <div class="container-big">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
        <!-- Left: intro -->
        <div class="lg:col-span-4">
          <svg class="absolute w-0 h-0 overflow-hidden" aria-hidden="true" focusable="false">
            <defs>
              <path id="contact-star8" d="M12 2 L13.91 7.38 L19.07 4.93 L16.62 10.09 L22 12 L16.62 13.91 L19.07 19.07 L13.91 16.62 L12 22 L10.09 16.62 L4.93 19.07 L7.38 13.91 L2 12 L7.38 10.09 L4.93 4.93 L10.09 7.38 Z" />
            </defs>
          </svg>
          <ContactPortal class="w-44 h-auto text-ink mb-10" />
          <p class="label mb-4">Contact</p>
          <h1 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(28px, 3.5vw, 48px); line-height: 1.1;">
            How Can We Help?
          </h1>
          <p class="font-sans text-base text-stone leading-relaxed mb-10">
            Whether you are a first-time investor or a sophisticated institution, our team is here to understand your needs and guide you to the right Shariah-compliant solution.
          </p>

          <!-- Office / contact placeholders -->
          <div class="font-sans text-sm text-stone border-t border-line divide-y divide-line">
            <div class="py-5">
              <p class="font-semibold text-ink mb-1 flex items-center gap-2"><svg viewBox="0 0 24 24" class="w-3 h-3 shrink-0 fill-current" aria-hidden="true" focusable="false"><use href="#contact-star8" /></svg>Registered Office</p>
              <p class="pl-5">[Office address — placeholder pending client confirmation]</p>
            </div>
            <div class="py-5">
              <p class="font-semibold text-ink mb-1 flex items-center gap-2"><svg viewBox="0 0 24 24" class="w-3 h-3 shrink-0 fill-current" aria-hidden="true" focusable="false"><use href="#contact-star8" /></svg>Email</p>
              <p class="pl-5">[info@blackstoneislamicglobal.com — placeholder]</p>
            </div>
            <div class="py-5">
              <p class="font-semibold text-ink mb-1 flex items-center gap-2"><svg viewBox="0 0 24 24" class="w-3 h-3 shrink-0 fill-current" aria-hidden="true" focusable="false"><use href="#contact-star8" /></svg>Phone</p>
              <p class="pl-5">[+92 XXX XXXXXXX — placeholder]</p>
            </div>
            <div class="py-5">
              <p class="font-semibold text-ink mb-1 flex items-center gap-2"><svg viewBox="0 0 24 24" class="w-3 h-3 shrink-0 fill-current" aria-hidden="true" focusable="false"><use href="#contact-star8" /></svg>WhatsApp — Blackstone Intel</p>
              <p class="pl-5"><a href="#" class="underline hover:text-ink">Join Channel (link placeholder)</a></p>
            </div>
            <div class="py-5">
              <p class="font-semibold text-ink mb-1 flex items-center gap-2"><svg viewBox="0 0 24 24" class="w-3 h-3 shrink-0 fill-current" aria-hidden="true" focusable="false"><use href="#contact-star8" /></svg>WhatsApp — Blackstone Intel</p>
              <p class="pl-5"><a href="#" class="underline hover:text-ink">Contact Client Care for access</a></p>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div class="lg:col-span-8">
          {sent ? (
            <div class="bg-mist border-l-4 border-acid px-8 py-10">
              <h2 class="font-serif font-normal text-ink text-2xl mb-3">Thank you for reaching out.</h2>
              <p class="font-sans text-base text-stone leading-relaxed">
                A member of our team will be in touch shortly. We look forward to exploring how BIG can serve your investment needs.
              </p>
            </div>
          ) : (
            <form
              method="POST"
              action="/form/contact.php"
              class="space-y-6"
            >
              {errorMessage && (
                <div class="bg-red-50 border-l-4 border-red-500 px-5 py-4">
                  <p class="font-sans text-sm text-red-800">{errorMessage}</p>
                </div>
              )}

              <!-- Honeypot: hidden from users; bots that fill it are silently rejected -->
              <div class="hidden" aria-hidden="true">
                <label>Company
                  <input type="text" name="company" tabindex="-1" autocomplete="off" />
                </label>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block font-sans text-sm font-medium text-ink mb-2">Full Name *</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full px-4 py-3 border border-line font-sans text-sm text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-ink focus:border-ink"
                    placeholder="Your full name"
                  />
                </div>
                <div>
                  <label for="email" class="block font-sans text-sm font-medium text-ink mb-2">Email Address *</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full px-4 py-3 border border-line font-sans text-sm text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-ink focus:border-ink"
                    placeholder="your@email.com"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="phone" class="block font-sans text-sm font-medium text-ink mb-2">Phone Number</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    class="w-full px-4 py-3 border border-line font-sans text-sm text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-ink focus:border-ink"
                    placeholder="+92 or international"
                  />
                </div>
                <div>
                  <label for="subject" class="block font-sans text-sm font-medium text-ink mb-2">Subject *</label>
                  <input
                    type="text"
                    id="subject"
                    name="subject"
                    required
                    class="w-full px-4 py-3 border border-line font-sans text-sm text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-ink focus:border-ink"
                    placeholder="Brief subject"
                  />
                </div>
              </div>

              <div>
                <label for="service" class="block font-sans text-sm font-medium text-ink mb-2">Service of Interest</label>
                <select
                  id="service"
                  name="service"
                  class="w-full px-4 py-3 border border-line font-sans text-sm text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-ink focus:border-ink"
                >
                  <option value="">Select a service...</option>
                  {services.map(s => <option value={s}>{s}</option>)}
                </select>
              </div>

              <div>
                <label for="message" class="block font-sans text-sm font-medium text-ink mb-2">Message *</label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows={6}
                  class="w-full px-4 py-3 border border-line font-sans text-sm text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-ink focus:border-ink resize-none"
                  placeholder="Tell us about your investment goals and how we can help..."
                ></textarea>
              </div>

              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  id="privacy"
                  name="privacy"
                  required
                  class="mt-1 w-4 h-4 accent-ink"
                />
                <label for="privacy" class="font-sans text-xs text-stone leading-relaxed">
                  I agree to the <a href="#" class="underline hover:text-ink">Privacy Policy</a> and consent to BIG contacting me regarding my enquiry.
                </label>
              </div>

              <button
                type="submit"
                class="inline-flex items-center px-8 py-4 bg-ink text-white font-sans text-sm font-semibold hover:bg-stone transition-colors"
              >
                Send Enquiry →
              </button>
            </form>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Map placeholder -->
  <section class="relative overflow-hidden h-64 bg-mist border-t border-line">
    <GeometricPattern motif="girih" class="absolute inset-0 w-full h-full text-ink opacity-[0.06]" />
    <div class="relative z-10 h-full flex flex-col items-center justify-center gap-4">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-ink" aria-hidden="true" focusable="false">
        <path d="M12 2 L13.91 7.38 L19.07 4.93 L16.62 10.09 L22 12 L16.62 13.91 L19.07 19.07 L13.91 16.62 L12 22 L10.09 16.62 L4.93 19.07 L7.38 13.91 L2 12 L7.38 10.09 L4.93 4.93 L10.09 7.38 Z" class="fill-acid" />
        <circle cx="12" cy="12" r="2.5" fill="currentColor" />
      </svg>
      <p class="font-sans text-sm text-stone italic">
        [Map placeholder — office location to be confirmed]
      </p>
    </div>
  </section>
</BaseLayout>
