---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAlternating from '../../components/ServiceAlternating.astro';
import Button from '../../components/Button.astro';

const services = [
  {
    id: 'wealth-planning',
    eyebrow: '01 · A la Carte',
    headingLines: ['Wealth Planning: À la Carte Approach'],
    image: 'https://images.unsplash.com/photo-1622675363311-3e1904dc1885?auto=format&fit=crop&w=1200&q=80',
    imageAlt: 'Bespoke wealth-planning consultation with an advisor',
    body: `We take a highly customised approach to understanding your wealth aspirations, commitments, and non-negotiables enabling us to design and implement personalised, À la carte approach that preserve and grow wealth that align with your marvellous lifestyle, legacy, and succession planning.

Our specialists engage with you and your team to develop and implement wealth strategies that broaden your portfolio, expand your universe, and multiply your wealth on your terms.`,
    cta: { label: 'Explore Wealth Planning', href: '/contact' },
  },
  {
    id: 'private-equity',
    eyebrow: '02 · Growth Capital',
    headingLines: ['Private Equity'],
    image: 'https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?auto=format&fit=crop&w=1200&q=80',
    imageAlt: 'Business growth discussion during a private equity partnership',
    body: `Our Private Equity specialists bring 50+ years of collective advisory experience with oversight of $7+ billion in transnational portfolios. Through this international network and strategic partnerships, we provide direct access to select private investment opportunities across oil & gas exploration in Pakistan's Southern belt, Gilgit-Baltistan gemstones, USA rare minerals, Ghana gold mining, New Zealand meat, Pakistani textile, sports and sugar, and hospitality JVs near the Holy Sites of Makkah and Madinah.

We can also position you as an exclusive underwriter for IPOs and Sukuks; and as a corporate financier to our prestigious clients in Türkiye, Pakistan and Saudi Arabia.

Whether an investor seeking a strategic partnership or a business owner looking to accelerate growth, we connect capital with opportunity, and flip the asset within 5 to 7 years for you.`,
    cta: { label: 'Explore Private Equity', href: '/contact' },
  },
  {
    id: 'pakistan-energy',
    eyebrow: '03 · OMC Sector',
    headingLines: ['Pakistan Energy'],
    image: 'https://images.unsplash.com/photo-1513828583688-c52646db42da?auto=format&fit=crop&w=1200&q=80',
    imageAlt: 'Refinery and downstream plant in Pakistan\'s OMC energy sector',
    body: `For ultra-high-net-worth individuals and corporates seeking entry into Pakistan's OMC sector, we provide end-to-end advisory across deal origination, due diligence, transaction execution, and post-acquisition support.

Combining deep sector expertise, strong industry relationships, and a track record of successful execution, we help you build value-accretive energy businesses while navigating Pakistan's downstream market.`,
    cta: { label: 'Explore Pakistan Energy', href: '/contact' },
  },
  {
    id: 'real-estate',
    eyebrow: '04 · Landmark Transactions',
    headingLines: ['Real Estate'],
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80',
    imageAlt: 'Landmark real-estate transactions and development',
    body: `From identifying high-value, off-market opportunities to structuring transactions and negotiating favourable terms, we deliver superior real estate solutions. Through great relationships with sponsors, developers, and other stakeholders, we facilitate landmark deals with excellence.`,
    cta: { label: 'Explore Real Estate', href: '/contact' },
  },
];


---

<BaseLayout
  title="Private Wealth Management | Blackstone Islamic Global"
  description="Bespoke à la carte wealth planning, dedicated investments, private equity, real estate, and philanthropy, all tailored to your legacy."
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="relative flex items-end bg-ink" style="min-height: calc(100vh - var(--header-h));">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('/images/pvm-opt.png');"
      ></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(110deg, rgba(11,11,11,0.55) 0%, rgba(11,11,11,0.20) 50%, rgba(11,11,11,0.03) 100%);"
      ></div>
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-acid"></div>
    </div>

    <div class="relative z-10 container-big hero-inner w-full pt-12 pb-12">
      <div class="max-w-3xl hero-copy">
        <!-- pw-hero-h1 is a page-only override: 38 characters, so it holds one
             line comfortably at the larger size. The shared hero-h1 class is
             left untouched. -->
        <h1 class="hero-h1 pw-hero-h1 font-serif text-white font-normal leading-[1.05] mb-6">
          Your Wealth | Your Legacy | Your Terms
        </h1>
        <Button variant="acid" href="#wealth-planning">Explore What We Do</Button>
      </div>
    </div>

    <div class="absolute bottom-8 right-16 hidden lg:flex flex-col items-center gap-2 opacity-40" aria-hidden="true">
      <span class="font-sans text-xs text-white tracking-widest uppercase">Scroll</span>
      <div class="w-px h-12 bg-white/60"></div>
    </div>
  </section>


  <!-- ── Services ──────────────────────────────────────────────────────── -->
  <ServiceAlternating services={services} />

</BaseLayout>

<style>
  /* ── Hero, matched to the PSX & Global Markets page ─────────────────────
     hero-h1 / hero-copy are scoped per-component in Astro, so they are
     defined here rather than inherited. */
  .hero-h1 {
    margin-top: 2.1em;
    max-width: none;
  }
  @media (max-width: 640px) {
    .hero-h1 { margin-top: 0; }
  }

  /* 38 characters — comfortably holds one line at the full size. */
  .pw-hero-h1 {
    font-size: clamp(1.75rem, 3vw, 3.75rem);
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .pw-hero-h1 {
      white-space: normal;
      font-size: clamp(1.5rem, 6vw, 2rem);
    }
  }

  /* Soft shadow so the copy stays legible over the photo. */
  .hero-copy h1,
  .hero-copy p {
    text-shadow: 0 2px 18px rgba(11, 11, 11, 0.55), 0 1px 3px rgba(11, 11, 11, 0.4);
  }

  /* Trim the shared container gutter for this hero only; container-big
     (px-6 / lg:px-16) is used site-wide and is left alone. */
  .hero-inner { padding-left: 8px; }
  @media (min-width: 1024px) {
    .hero-inner { padding-left: 24px; }
  }
</style>
