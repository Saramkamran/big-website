---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAlternating from '../../components/ServiceAlternating.astro';
import Button from '../../components/Button.astro';

const services = [
  {
    id: 'wealth-planning',
    eyebrow: '01 · A la Carte',
    headingLines: ['À La Carte Approach'],
    image: '/images/alcarte.jpg',
    imageAlt: 'Overhead view of a person holding a small cup of coffee at a rustic wooden table, beside a plate of pancakes with berries and fruit on an ornate tray, two antique keys, and an open vintage book',
    body: `We take a highly customised approach to understanding your wealth aspirations, commitments, and non-negotiables enabling us to design and implement personalised, À la carte approach that preserve and grow wealth that align with your marvellous lifestyle, legacy, and succession planning.

Our specialists engage with you and your team to develop and implement wealth strategies that broaden your portfolio, expand your universe, and multiply your wealth on your terms.`,
    cta: { label: 'Explore Wealth Planning', href: '/contact' },
  },
  {
    id: 'private-equity',
    eyebrow: '02 · Growth Capital',
    headingLines: ['Private Equity'],
    image: 'https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?auto=format&fit=crop&w=1200&q=80',
    imageAlt: 'Business growth discussion during a private equity partnership',
    body: `Our Private Equity specialists bring 50+ years of collective advisory experience with oversight of transnational portfolios. Through this international network and strategic partnerships, we provide direct access to select private investment opportunities across oil & gas exploration in Pakistan's Southern belt, Gilgit-Baltistan gemstones, USA rare minerals, Ghana gold mining, New Zealand meat, Pakistani textile, sports and sugar, and hospitality JVs near the Holy Sites of Makkah and Madinah.

We can also position you as an exclusive underwriter for IPOs and Sukuks; and as a corporate financier to our prestigious clients in Türkiye, Pakistan and Saudi Arabia.

Whether an investor seeking a strategic partnership or a business owner looking to accelerate growth, we connect capital with opportunity, and flip the asset at 1-5x within 5 to 7 years for you.`,
    cta: { label: 'Explore Private Equity', href: '/contact' },
  },
  {
    id: 'pakistan-energy',
    eyebrow: '03 · OMC Sector',
    headingLines: ['Pakistan Energy'],
    image: '/images/oil.jpg',
    imageAlt: 'Aerial view of an oil refinery and storage tanks',
    body: `For ultra-high-net-worth individuals and corporates seeking entry into Pakistan's oil and gas sector, we provide end-to-end advisory across deal origination, due diligence, transaction execution, and post-acquisition support.

Combining deep sector expertise, strong industry relationships, and a track record of successful execution, we help you build value-accretive energy businesses while navigating Pakistan's downstream market.`,
    cta: { label: 'Explore Pakistan Energy', href: '/contact' },
  },
  {
    id: 'real-estate',
    eyebrow: '04 · Landmark Transactions',
    headingLines: ['Real Estate'],
    image: '/images/building-blue-sky.jpg',
    imageAlt: 'Looking straight up at modern glass and steel skyscrapers converging against a clear blue sky',
    body: `From identifying high-value, off-market opportunities to structuring transactions and negotiating favourable terms, we deliver superior real estate solutions. Through great relationships with sponsors, developers, and other stakeholders, we facilitate landmark deals with excellence.`,
    cta: { label: 'Explore Real Estate', href: '/contact' },
  },
];


---

<BaseLayout
  title="Private Wealth Management | Blackstone Islamic Global"
  description="Bespoke à la carte wealth planning, dedicated investments, private equity, real estate, and philanthropy, all tailored to your legacy."
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="service-hero--raised relative flex items-end bg-ink" style="min-height: calc(100vh - var(--header-h));">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('/images/plane.jpg');"
      ></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(90deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,0) 65%), linear-gradient(110deg, rgba(11,11,11,0.70) 0%, rgba(11,11,11,0.35) 50%, rgba(11,11,11,0.18) 100%);"
      ></div>
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-acid"></div>
    </div>

    <div class="relative z-10 container-big hero-gutter w-full pt-12 pb-12">
      <div class="hero-content service-hero">
        <p class="hero-eyebrow hero-eyebrow-lg">Private Wealth Management</p>
        <h1 class="hero-h1-md">
          Your Wealth | Your Legacy | Your Terms
        </h1>
        <p class="hero-sub">
          We steward your wealth towards lasting security and a satisfying legacy
        </p>
        <Button variant="acid" href="#wealth-planning">Explore What We Do</Button>
      </div>
    </div>

  </section>


  <!-- ── Services ──────────────────────────────────────────────────────── -->
  <ServiceAlternating services={services} />

</BaseLayout>
