---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAlternating from '../../components/ServiceAlternating.astro';
import Button from '../../components/Button.astro';

const services = [
  {
    id: 'family-office',
    eyebrow: '01 · Coordinated Oversight',
    headingLines: ['Basirah Family Office'],
    image: '/images/ss-basirah-family-office.jpg',
    imageAlt: 'An artist painting a landscape, evoking bespoke, one-of-a-kind holdings',
    body: `Through Basirah family office, we offer you monopolised business opportunities and prized collectibles including one-of-a-kind - art, watches, and jewellery.`,
    cta: { label: 'Explore Basirah Family Office', href: '/contact' },
  },
  {
    id: 'lifestyle-management',
    eyebrow: '02 · Confidential',
    headingLines: ['Lifestyle Management'],
    image: '/images/rolls.jpg',
    imageAlt: 'Black and silver Rolls-Royce coupe parked on a Mayfair street in front of red-brick and stone townhouses with a red shop awning and festive floral display',
    imagePosition: '85% 100%',
    body: `With confidentiality, we manage your family and business needs including private aviation, bill payments; and licensed security and chauffeur services anywhere in the world.`,
    cta: { label: 'Explore Lifestyle Management', href: '/contact' },
  },
  {
    id: 'pr-campaign',
    eyebrow: '03 · Global Outreach',
    headingLines: ['PR Campaign'],
    image: '/images/ss-pr-campaign.jpg',
    imageAlt: 'An illuminated ON AIR studio sign, representing visibility and public profile',
    body: `An inspiring feature of our personalised offering is our ability to manage your business social media presence and curate bespoke PR campaigns, enhancing your executive profile, visibility, and global outreach.`,
    cta: { label: 'Explore PR Campaign', href: '/contact' },
  },
  {
    id: 'philanthropy-zakat',
    eyebrow: '04 · Purposeful Giving',
    headingLines: ['Philanthropy and Zakat Strategy'],
    image: '/images/ss-philanthropy-zakat.jpg',
    imageAlt: 'Children together outdoors, reflecting purposeful giving and community impact',
    imagePosition: '72% 18%',
    body: `We believe wealth is not all about financial prosperity but also a powerful force for positive socio-economic change. Our philanthropy and Zakat strategy helps you plan your giving through family trusts, foundations, waqfs, CSR initiatives, and other impact creating projects spanning healthcare, education, disaster relief, and community development.

We help families create a lasting legacy with purposeful giving, while advising on tax efficient charitable offerings.

Our Philanthropy and Zakat advisory is offered at reduced fee.`,
    cta: { label: 'Explore Philanthropy and Zakat', href: '/contact' },
  },
  {
    id: 'mergers-acquisitions',
    eyebrow: '05 · Origination to Execution',
    headingLines: ['M&A and Carve Out'],
    image: '/images/ss-mergers-acquisitions.jpg',
    imageAlt: 'Precise hand-carving of a squash, separating value with craft and care',
    body: `Our M&A and carve out specialists bring extensive experience across Pakistan's energy, sugar and chemicals space, British and American aviation, and the European FMCG sectors, delivering value-focused outcomes.

For your next strategic transaction, our specialists are ready to help you.`,
    cta: { label: 'Explore M&A and Carve Out', href: '/contact' },
  },
  {
    id: 'ipos',
    eyebrow: '06 · PSX & US',
    headingLines: ['Pakistan and US IPO'],
    image: '/images/ss-initial-public-offer.jpg',
    imageAlt: 'A neon PUBLIC MARKET sign against open sky, signalling going public',
    body: `As Pakistan enters a new phase of economic upside, IPO interest is accelerating. Our specialists provide an end-to-end IPO consultancy, helping businesses prepare, execute, and grow through public listing at PSX.

We also offer US IPO consultancy to bridge Pakistani businesses with global investors.`,
    cta: { label: 'Explore IPOs', href: '/contact' },
  },
  {
    id: 'professional-services',
    eyebrow: '07 · A-Rated Network',
    headingLines: ['Professional Services'],
    image: '/images/ss-professional-services.jpg',
    imageAlt: 'Cricket balls lined up on a sunlit pitch, a trusted professional network',
    body: `We are associated with a network of A-rated chartered accountants across Pakistan, the UK, and the US, providing accounting, audit, tax, legal, AML, ESG, and governance services with discretion, and integrity.`,
    cta: { label: 'Explore Professional Services', href: '/contact' },
  },
];


---

<BaseLayout
  title="Specialised Services | Blackstone Islamic Global"
  description="Basirah Family Office, Lifestyle Management, PR Campaign, Philanthropy and Zakat, M&A and Carve Out, and IPO consultancy for Pakistan and US markets."
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="service-hero--raised relative flex items-end bg-ink" style="min-height: calc(100vh - var(--header-h)); --hero-block-top: min(60%, calc(100% - 180px));">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('/images/car.jpg');"
      ></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(90deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,0) 65%), linear-gradient(110deg, rgba(11,11,11,0.65) 0%, rgba(11,11,11,0.30) 52%, rgba(11,11,11,0.17) 100%);"
      ></div>
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-acid"></div>
    </div>

    <div class="relative z-10 container-big hero-gutter w-full pt-12 pb-12">
      <div class="hero-content service-hero service-hero--oneline">
        <p class="hero-eyebrow hero-eyebrow-lg">Specialised Services</p>
        <h1 class="hero-h1-md">
          Personalised Investments&nbsp;| Personalised Oversight&nbsp;| Exceptional Returns
        </h1>
        <p class="hero-sub">
          Our yarning experience of specialised services is sagaciously crafted to go an extra mile in your perspicacity and stature
        </p>
        <Button variant="acid" href="#family-office">Explore What We Do</Button>
      </div>
    </div>

  </section>


  <!-- ── Services ──────────────────────────────────────────────────────── -->
  <ServiceAlternating services={services} />

</BaseLayout>
