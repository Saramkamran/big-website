---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceSections from '../../components/ServiceSections.astro';
import Button from '../../components/Button.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const services = [
  {
    layout: 'feature', id: 'family-office', index: '01', tag: 'Coordinated Oversight',
    title: 'Basirah Family Office', imageSide: 'left', bg: 'paper',
    image: '/images/ss-basirah-family-office.jpg',
    imageAlt: 'An artist painting a landscape — bespoke, one-of-a-kind holdings',
    body: `Through Basirah family office, we offer you monopolised business opportunities and prized collectibles including one-of-a-kind - art, watches, and jewellery.`,
  },
  {
    layout: 'overlap', id: 'lifestyle-management', eyebrow: '02', tag: 'Confidential',
    title: 'Lifestyle Management', imageSide: 'right', bg: 'mist',
    image: 'https://images.unsplash.com/photo-1494412651409-8963ce7935a7?auto=format&fit=crop&w=1200&q=80',
    imageAlt: 'Private aviation and lifestyle management services',
    body: `With confidentiality, we manage your family and business needs including private aviation, bill payments; and licensed security and chauffeur services anywhere in the world.`,
  },
  {
    layout: 'feature', id: 'pr-campaign', index: '03', tag: 'Global Outreach',
    title: 'PR Campaign', imageSide: 'left', bg: 'paper',
    image: '/images/ss-pr-campaign.jpg',
    imageAlt: 'An illuminated ON AIR studio sign — visibility and public profile',
    body: `An inspiring feature of our personalised offering is our ability to manage your business social media presence and curate bespoke PR campaigns, enhancing your executive profile, visibility, and global outreach.`,
  },
  {
    layout: 'banner', id: 'philanthropy-zakat', index: '04', eyebrow: 'Purposeful Giving',
    title: 'Philanthropy and Zakat Strategy',
    image: '/images/ss-philanthropy-zakat.jpg',
    imageAlt: 'Children together outdoors — purposeful giving and community impact',
    imagePosition: '72% 18%',
    imageZoom: '135%',
    minH: '760px',
    body: `We believe wealth is not all about financial prosperity but also a powerful force for positive socio-economic change. Our philanthropy and Zakat strategy helps you plan your giving through family trusts, foundations, waqfs, CSR initiatives, and other impact creating projects spanning healthcare, education, disaster relief, and community development.

We help families create a lasting legacy with purposeful giving, while advising on tax efficient charitable offerings. Our Philanthropy and Zakat advisory is offered at reduced fee.`,
  },
  {
    layout: 'feature', id: 'mergers-acquisitions', index: '05', tag: 'Origination to Execution',
    title: 'M&A and Carve Out', imageSide: 'right', bg: 'paper',
    image: '/images/ss-mergers-acquisitions.jpg',
    imageAlt: 'Precise hand-carving of a squash — separating value with craft and care',
    body: `Our M&A and carve out specialists bring extensive experience across Pakistan's energy, sugar and chemicals space, British and American aviation, and the European FMCG sectors, delivering value-focused outcomes.

For your next strategic transaction, our specialists are ready to help you.`,
  },
  {
    layout: 'overlap', id: 'ipos', eyebrow: '06', tag: 'PSX & US',
    title: 'Initial Public Offer', imageSide: 'left', bg: 'mist',
    image: '/images/ss-initial-public-offer.jpg',
    imageAlt: 'A neon PUBLIC MARKET sign against open sky — going public',
    body: `As Pakistan enters a new phase of economic upside, IPO interest is accelerating. Our specialists provide an end-to-end IPO consultancy, helping businesses prepare, execute, and grow through public listing at PSX.

We also offer US IPO consultancy to bridge Pakistani businesses with global investors.`,
  },
  {
    layout: 'bordered', id: 'professional-services', index: '07', eyebrow: 'A-Rated Network',
    title: 'Professional Services', imageSide: 'right', bg: 'paper', wideImage: true,
    image: '/images/ss-professional-services.jpg',
    imageAlt: 'Cricket balls lined up on a sunlit pitch — a trusted professional network',
    body: `We are associated with a network of A-rated chartered accountants across Pakistan, the UK, and the US, providing accounting, audit, tax, legal, AML, ESG, and governance services with discretion, and integrity.`,
  },
];

---

<BaseLayout
  title="Specialized Services | Blackstone Islamic Global"
  description="Basirah Family Office, Lifestyle Management, PR Campaign, Philanthropy and Zakat, M&A and Carve Out, and IPO consultancy for Pakistan and US markets."
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="relative flex items-start bg-ink" style="min-height: calc(100vh - var(--header-h));">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('https://images.unsplash.com/photo-1780907058575-050e066f6671?auto=format&fit=crop&w=2400&q=80');"
      ></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(110deg, rgba(11,11,11,0.50) 0%, rgba(11,11,11,0.15) 52%, rgba(11,11,11,0.02) 100%);"
      ></div>
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-acid"></div>
    </div>

    <div class="relative z-10 container-big w-full pt-12 pb-12">
      <div class="max-w-3xl">
        <p class="label text-acid mb-6">Specialized Services</p>
        <h1
          class="font-serif font-normal text-white mb-10 leading-[1.05]"
          style="font-size: clamp(34px, 5.5vw, 60px);"
        >
          Personalised Investments<br/>Personalised Oversight<br/>Exceptional Returns
        </h1>
        <Button variant="acid" href="#family-office">Explore What We Do</Button>
      </div>
    </div>

    <div class="absolute bottom-8 right-16 hidden lg:flex flex-col items-center gap-2 opacity-40" aria-hidden="true">
      <span class="font-sans text-xs text-white tracking-widest uppercase">Scroll</span>
      <div class="w-px h-12 bg-white/60"></div>
    </div>
  </section>


  <!-- ── Services ──────────────────────────────────────────────────────── -->
  <ServiceSections services={services} />

  <ContactCTA
    headline="Let's Discuss Your Mandate"
    subtext="Our specialized advisory team is ready to explore how BIG can make the difference — in confidence and at the highest standard."
    image="https://images.unsplash.com/photo-1758518731706-be5d5230e5a5?auto=format&fit=crop&w=1200&q=80"
    imageAlt="Executive boardroom — specialized advisory and M&A"
  />

</BaseLayout>
