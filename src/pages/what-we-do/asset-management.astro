---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAlternating from '../../components/ServiceAlternating.astro';
import Button from '../../components/Button.astro';

const services = [
  {
    id: 'am-fixed-income',
    eyebrow: '01 · Capital Preservation',
    headingLines: ['Shariah Fixed Income Funds'],
    image: '/images/am-fixed-income.jpg',
    imageAlt: 'Worshippers gathered in congregation, evoking faith-aligned, community-scale investing',
    body: `We help clients navigate safe funds with confidence, identifying instruments focused on capital preservation and stable returns through a curated selection of high-quality income and money market mutual funds.

For distinguished corporates and ultra-high-net-worth clients, we also facilitate the creation of dedicated mutual funds through our trusted network of leading global asset management companies. These customised funds may offer greater NAV returns and preferential fee arrangements.`,
    cta: { label: 'Explore Shariah Fixed Income', href: '/contact' },
  },
  {
    id: 'am-equity',
    eyebrow: '02 · PSX · FTSE · NYSE',
    headingLines: ['Shariah Equity Funds'],
    image: '/images/am-equity.jpg',
    imageAlt: 'Abraj Al Bait clock tower rising above Makkah',
    body: `With 20+ years of experience across PSX and global markets, we professionally manage investments through discretionary mandated mutual funds. Our institutional grade research and insight evaluate geoeconomics, geopolitics, corporate valuations, and investment psychology to identify pre-optimistic opportunities across equity and equity fund-of-funds.

We intelligently crystallise gains during pre-pessimistic phases, preserve capital, and remain tactically cash ready to seize the next winning opportunity for our clients.`,
    cta: { label: 'Explore Shariah Equity', href: '/contact' },
  },
  {
    id: 'am-etfs',
    eyebrow: '03 · Diversification',
    headingLines: ['Shariah ETF'],
    image: '/images/am-etf.jpg',
    imageAlt: 'Tiled mosque domes in graduated colour, suggesting diversified exposure within faith principles',
    body: `We help clients access carefully selected ETFs that provide diversified exposure to high performing clubbed equities. Our objective remains offering a clear pathway to participate in long term corporate and market growth while synced with faith and investment principles.`,
    cta: { label: 'Explore Shariah ETFs', href: '/contact' },
  },
  {
    id: 'am-multi-asset',
    eyebrow: '04 · Balanced',
    headingLines: ['Shariah Multi-Asset Funds'],
    image: '/images/am-multi-asset.jpg',
    imageAlt: 'Multi-coloured mosque domes and minarets, a blend of complementary elements',
    body: `Leveraging our market expertise and meticulous scrutiny, we help clients position in multi-asset and hybrid funds, including asset allocation, gold and balance funds. By strategically blending equities and fixed income instruments, these solutions seek to balance growth and stability, helping clients pursue their financial objectives across different asset classes.`,
    bullets: [
      'Asset Allocation',
      'Gold Funds',
      'Balance Funds',
    ],
    cta: { label: 'Explore Multi-Asset Funds', href: '/contact' },
  },
  {
    id: 'am-pensions',
    eyebrow: '05 · Retirement',
    headingLines: ['Shariah Pensions'],
    image: '/images/am-pensions.jpg',
    imageAlt: 'Placing a golf ball on the tee during the unhurried years after a working life',
    body: `Personal freedom, financial prosperity, and tax efficient retirement is what you deserve after a lifetime of hard work. To preserve your lifestyle and pursue the aspirations that you may have postponed during your working years, our retirement planning begins well before your superannuation.

We do not offer a random, one-size-fits-all pension solution. We understand your lifestyle, customise a retirement strategy, and structure a plan around your aspirations to ensure low tax and high returns pay your happiness. We partner with top rated pension providers and do all the needful for you.`,
    cta: { label: 'Explore Shariah Pensions', href: '/contact' },
  },
];

---

<BaseLayout
  title="Asset Management | Blackstone Islamic Global"
  description="Shariah-screened fixed income, equity, ETF, multi-asset, and pension solutions, rigorously managed by BIG's investment team."
  theme="bw"
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="relative flex items-end bg-ink" style="min-height: calc(100vh - var(--header-h));">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('https://images.unsplash.com/photo-1773503877076-cc9caa3322ff?auto=format&fit=crop&w=2400&q=80');"
      ></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(110deg, rgba(11,11,11,0.52) 0%, rgba(11,11,11,0.16) 52%, rgba(11,11,11,0.02) 100%);"
      ></div>
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-acid"></div>
    </div>

    <div class="relative z-10 container-big hero-inner w-full pt-12 pb-12">
      <div class="max-w-3xl hero-copy">
        <!-- am-hero-h1 is a page-only override: 58 characters, so it needs a
             smaller clamp than PSX to hold one line. The shared hero-h1 class
             is left untouched. -->
        <h1 class="hero-h1 am-hero-h1 font-serif text-white font-normal leading-[1.05] mb-6">
          Shariah Screened | Professionally Managed | Growth Focused
        </h1>
        <p class="font-sans text-white/80 text-lg leading-relaxed mb-8 max-w-xl">
          Our comprehensive suite of asset management solutions across fixed income, equities, and multi-asset classes is built around proprietary strategies designed to navigate market cycles and pursue realistic returns.
        </p>
        <Button variant="acid" href="#am-fixed-income">Explore What We Do</Button>
      </div>
    </div>

    <div class="absolute bottom-8 right-16 hidden lg:flex flex-col items-center gap-2 opacity-40" aria-hidden="true">
      <span class="font-sans text-xs text-white tracking-widest uppercase">Scroll</span>
      <div class="w-px h-12 bg-white/60"></div>
    </div>
  </section>


  <!-- ── Services ──────────────────────────────────────────────────────── -->
  <ServiceAlternating services={services} />

</BaseLayout>

<style>
  /* ── Hero, matched to the PSX & Global Markets page ─────────────────────
     hero-h1 / hero-copy are scoped per-component in Astro, so they are
     defined here rather than inherited. */
  .hero-h1 {
    margin-top: 2.1em;
    max-width: none;
  }
  @media (max-width: 640px) {
    .hero-h1 { margin-top: 0; }
  }

  /* 58 characters — needs a smaller cap than PSX (50 chars) to hold one line. */
  .am-hero-h1 {
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .am-hero-h1 {
      white-space: normal;
      font-size: clamp(1.5rem, 6vw, 2rem);
    }
  }

  /* Soft shadow so the copy stays legible over the photo. */
  .hero-copy h1,
  .hero-copy p {
    text-shadow: 0 2px 18px rgba(11, 11, 11, 0.55), 0 1px 3px rgba(11, 11, 11, 0.4);
  }

  /* Trim the shared container gutter for this hero only; container-big
     (px-6 / lg:px-16) is used site-wide and is left alone. */
  .hero-inner { padding-left: 8px; }
  @media (min-width: 1024px) {
    .hero-inner { padding-left: 24px; }
  }
</style>
