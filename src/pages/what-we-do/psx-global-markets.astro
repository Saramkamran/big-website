---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';

// ── Body section data ──────────────────────────────────────────────────────
// One entry per row, rendered by the shared alternating two-column pattern.
//
// `body` is the client copy deck, verbatim, and `headingLines` carries each
// section's original service-name title. Bullet lists appear only where one
// existed before the layout change.
const sections = [
  {
    id: 'shariah-equities',
    eyebrow: '01',
    headingLines: ['Shariah Equities'],
    body: `Our equities business provides bespoke and Shariah enabled investment solutions for clients seeking sophisticated access to PSX and global capital markets. Combining proprietary strategies, deep-dive research, and market psychology, we identify high-conviction, high-return opportunities.

Through disciplined capital allocation, dynamic portfolio construction, and proactive risk management, our approach is designed to compound wealth, preserve capital, and pursue superior returns, creating sustainable wealth for our growing clientele.`,
    cta: { label: 'Explore Shariah Equities', href: '/contact' },
    image: '/images/psx-shariah-equities.jpg',
    imageAlt: 'Advisors reviewing equity research and market charts together',
  },
];

// Rows that follow the Big Services card grid.
const restSections = [
  {
    id: 'green-sukuks',
    eyebrow: '02',
    headingLines: ['Sukuks and Green Sukuks'],
    body: `Through primary and secondary markets, our Sukuk desk provides access to high-quality sovereign and corporate issuers, offering faith based fixed income solutions to our respected clients.

We also connect minimum A-rated Green Sukuks with ESG conscious investors, providing direct access to sustainable instruments in energy, and flood control infrastructure of Pakistan.`,
    cta: { label: 'Explore Sukuks', href: '/contact' },
    image: 'https://images.unsplash.com/photo-1509391366360-2e959784a276?auto=format&fit=crop&w=2000&q=80',
    imageAlt: '',
  },
  {
    id: 'transaction-services',
    eyebrow: '03',
    headingLines: ['Transaction Services'],
    body: `Our bank enabled transaction services platform provides seamless and secure market access through RAAST ID, SCRA, IPS and RDA-linked REIA solutions for domestic and overseas investors. We facilitate efficient execution, settlement, and post-trade support across all service lines.`,
    // Pre-existing capability rails — these four labels were on the page before
    // the layout change, so they stay as the section's bullet list.
    bullets: [
      'RAAST ID',
      'SCRA',
      'IPS',
      'REIA',
    ],
    cta: { label: 'Explore Transaction Services', href: '/contact' },
    image: '/images/psx-transaction-services.jpg',
    imageAlt: 'Interwoven strands of coloured thread, suggesting connected settlement and transaction rails',
  },
];

// Big Services — Portfolio Consultancy and Portfolio Supervision, shown as a
// two-up card grid rather than stacked alternating rows. Content is the same
// copy, imagery and alt text these two carried as svc-rows.
const cards = [
  {
    id: 'portfolio-consultancy',
    eyebrow: 'Shariah Equities · Self-Directed',
    headingLines: ['Portfolio Consultancy'],
    body: `Our portfolio consultancy services are designed for self-directed investors, providing timely trading and investment calls, and regular follow-ups. Combining market intelligence with actionable insights, we help clients navigate volatility, deploy capital decisively, and pursue growth.`,
    cta: { label: 'Explore Portfolio Consultancy', href: '/contact' },
    image: '/images/psx-portfolio-consultancy.jpg',
    imageAlt: 'Investor reviewing live market charts on a tablet during an advisory meeting',
  },
  {
    id: 'portfolio-supervision',
    eyebrow: 'Shariah Equities · Discretionary Mandate',
    headingLines: ['Portfolio Supervision'],
    body: `Our portfolio supervision is designed for trusted clients who prefer professional delegation. We provide bespoke strategies aligned with each client's risk and return objectives.

Our specialists actively monitor and optimise portfolios to preserve and grow capital. This white-glove service is subject to minimum portfolio requirements and eligibility criteria.`,
    cta: { label: 'Enquire', href: '/contact' },
    image: '/images/psx-portfolio-supervision.jpg',
    imageAlt: 'Portfolio manager discussing performance charts with a client',
    imageTop: true,
  }
];



// Blackstone Intel closes the page as a distinct dark full-bleed banner rather
// than an alternating row — copy verbatim from the client deck.
const blackstoneIntelBody = `We operate our dedicated WhatsApp channel, Blackstone Intel, to promote financial literacy and intelligent investing in capital markets. We coach and mentor aspiring investors better understand risk and rewards, and make informed decisions.

Join it for free and learn before earn`;
---

<BaseLayout
  title="PSX & Global Markets | Blackstone Islamic Global"
  description="Shariah-compliant equities, green sukuks, and transaction services across the Pakistan Stock Exchange and global markets."
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="relative flex items-end bg-ink" style="min-height: calc(100vh - var(--header-h));">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('https://images.unsplash.com/photo-1761233138997-44d9b002a08f?auto=format&fit=crop&w=2400&q=80');"
      ></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(110deg, rgba(11,11,11,0.55) 0%, rgba(11,11,11,0.18) 55%, rgba(11,11,11,0.02) 100%);"
      ></div>
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-acid"></div>
    </div>

    <div class="relative z-10 container-big psx-hero-inner w-full pt-12 pb-12">
      <div class="max-w-3xl hero-copy">
        <!-- psx-hero-h1 is a page-only override: this headline is 50 characters
             against the homepage's 33, so it needs a smaller clamp plus nowrap
             to hold one line. The shared hero-h1 class is left untouched. -->
        <h1 class="hero-h1 psx-hero-h1 font-serif text-white font-normal leading-[1.05] mb-6">
          Tailored Strategy | Smart Execution | Timely Exist
        </h1>
        <p class="font-sans text-white/80 text-lg leading-relaxed mb-8 max-w-xl">
          Our equities business combines niche research, rigorous analysis, and deep market expertise to deliver tailored, timely and independent investment solutions for our distinguished investors.
        </p>
        <Button variant="acid" href="#shariah-equities">Explore What We Do</Button>
      </div>
    </div>

    <div class="absolute bottom-8 right-16 hidden lg:flex flex-col items-center gap-2 opacity-40" aria-hidden="true">
      <span class="font-sans text-xs text-white tracking-widest uppercase">Scroll</span>
      <div class="w-px h-12 bg-white/60"></div>
    </div>
  </section>



  {/*
    Body rows — one shared alternating two-column pattern.
    The image column is full-bleed: edge-to-edge, full row height, no padding or
    radius. The text column is generously padded, vertically centred and
    left-aligned. Odd rows place the image left (row sits on white); even rows
    place it right (row sits on cream). Each row stacks to one column on mobile,
    image first.
  */}
  {sections.map((s, i) => {
    const imageRight = i % 2 === 1;
    return (
      <section
        id={s.id}
        class:list={['svc-row', imageRight && 'svc-row--reverse', imageRight && 'svc-row--cream']}
      >
        <div class="svc-media">
          <img
            src={s.image}
            alt={s.imageAlt}
            class:list={['svc-img', s.imageTop && 'svc-img--top']}
            loading="lazy"
          />
        </div>
        <div class="svc-copy">
          <div class="svc-copy-inner">
            <h2 class="svc-heading">
              {s.headingLines.map((line, n) => (
                <>{n > 0 && <br />}{line}</>
              ))}
            </h2>
            <p class="svc-para">{s.body}</p>
            {s.bullets && s.bullets.length > 0 && (
              <ul class="svc-list">
                {s.bullets.map((b) => (
                  <li><span class="svc-dot" aria-hidden="true"></span><span>{b}</span></li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
    );
  })}


  {/* ── Big Services — two-up card grid ───────────────────────────────────
      Portfolio Consultancy and Portfolio Supervision, previously stacked
      alternating rows. Same copy, imagery and alt text, re-presented as
      cards: image, accent rule, heading, paragraph, underlined link. */}
  <section id="big-services" class="bg-paper py-section">
    <!-- Page-scoped wide container: this section runs wider than the site's
         1280px container-big so the two cards read near edge-to-edge. The
         shared .container-big class is deliberately left untouched. -->
    <div class="svc-wide">
      <div class="max-w-2xl mb-14">
        <h2 class="font-serif font-normal text-ink" style="font-size: clamp(32px, 4vw, 48px); line-height: 1.1;">
          Big Services
        </h2>
        <p class="font-sans text-base text-stone leading-relaxed mt-5">
          Our core portfolio services, tailored to how you want to engage with the markets.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {cards.map((c) => (
          <article id={c.id} class="svc-card">
            <div class="svc-card-media">
              <img
                src={c.image}
                alt={c.imageAlt}
                class:list={['svc-card-img', c.imageTop && 'svc-card-img--top']}
                loading="lazy"
              />
            </div>
            <span class="svc-card-rule" aria-hidden="true"></span>
            <h3 class="font-sans font-bold text-ink text-xl leading-snug mb-3">
              {c.headingLines.join(' ')}
            </h3>
            <p class="svc-card-para font-sans text-base text-stone leading-relaxed mb-6">{c.body}</p>
            <a class="svc-card-link font-sans text-sm font-semibold text-ink" href={c.cta.href}>
              {c.cta.label} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>


  {restSections.map((s, i) => {
    /* Continue the alternation after the card grid: the first row above was
       image-left/white, so these resume image-right/cream, image-left/white. */
    const imageRight = i % 2 === 0;
    return (
      <section
        id={s.id}
        class:list={['svc-row', imageRight && 'svc-row--reverse', imageRight && 'svc-row--cream']}
      >
        <div class="svc-media">
          <img
            src={s.image}
            alt={s.imageAlt}
            class:list={['svc-img', s.imageTop && 'svc-img--top']}
            loading="lazy"
          />
        </div>
        <div class="svc-copy">
          <div class="svc-copy-inner">
            <h2 class="svc-heading">
              {s.headingLines.map((line, n) => (
                <>{n > 0 && <br />}{line}</>
              ))}
            </h2>
            <p class="svc-para">{s.body}</p>
            {s.bullets && s.bullets.length > 0 && (
              <ul class="svc-list">
                {s.bullets.map((b) => (
                  <li><span class="svc-dot" aria-hidden="true"></span><span>{b}</span></li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
    );
  })}


  


</BaseLayout>

<style>
  /* ──────────────────────────────────────────────────────────────────────────
     Alternating full-bleed two-column row.

     Page-scoped (Astro adds a per-component attribute), so the global header,
     footer and every other page are untouched. The reference's lime accent is a
     SEPARATE token (--lime) — the header/footer read --acid and keep their teal.
     ────────────────────────────────────────────────────────────────────────── */
  .svc-row {
    --lime:      #0B0B0B;
    --charcoal:  #2B2B2E;
    --eyebrow:   #8C939E;
    --bodygray:  #9CA0A6;
    --cream:     #F3F4ED;

    display: grid;
    grid-template-columns: 1fr 1fr;   /* ~50/50 */
    align-items: stretch;
    background: #FFFFFF;
  }
  /* Image right → the row sits on cream (matches the reference rhythm). */
  .svc-row--cream { background: var(--cream); }

  /* Source order is image-first so mobile stacks image → text with no extra
     rules; the desktop flip is done with explicit column placement. */
  .svc-row--reverse .svc-media { grid-column: 2; grid-row: 1; }
  .svc-row--reverse .svc-copy  { grid-column: 1; grid-row: 1; }

  /* ── Image column: edge-to-edge, full row height, no padding/radius ─────── */
  .svc-media {
    position: relative;
    overflow: hidden;
    min-height: 560px;
  }
  .svc-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }
  .svc-img--top { object-position: top; }

  /* ── Text column: generous padding, vertically centred, left-aligned ────── */
  .svc-copy {
    display: flex;
    align-items: center;
    text-align: left;
    padding: 88px 6vw;
    min-width: 0;
  }
  .svc-copy-inner { max-width: 560px; width: 100%; }

  /* 1 · Eyebrow — small, uppercase, wide tracking, slate gray */
  .svc-eyebrow {
    font-family: theme('fontFamily.sans');
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--eyebrow);
    margin: 0 0 22px;
  }

  /* 2 · Heading — serif, charcoal, one short phrase per line */
  .svc-heading {
    font-family: theme('fontFamily.serif');
    font-weight: 400;
    color: var(--charcoal);
    font-size: clamp(30px, 3.2vw, 44px);
    line-height: 1.16;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }

  /* 3 · Paragraph — gray, ~90% column width */
  .svc-para {
    font-family: theme('fontFamily.sans');
    font-size: 15px;
    line-height: 1.75;
    color: var(--bodygray);
    max-width: 90%;
    white-space: pre-line;  /* preserves the copy deck's paragraph breaks */
    margin: 0 0 28px;
  }

  /* 4 · Bullet list — small lime dot + gray label, tight spacing */
  .svc-list {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
  }
  .svc-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: theme('fontFamily.sans');
    font-size: 14px;
    line-height: 1.5;
    color: var(--bodygray);
    margin-bottom: 9px;
  }
  .svc-list li:last-child { margin-bottom: 0; }
  .svc-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
    margin-top: 7px;
  }

  /* 5 · CTA — lime fill, charcoal text, no border, trailing arrow */
  .svc-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--lime);
    color: var(--charcoal);
    border: none;
    border-radius: 2px;
    padding: 13px 24px;
    font-family: theme('fontFamily.sans');
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .svc-btn:hover { background: #3A3A3A; }
  .svc-btn:focus-visible { outline: 2px solid var(--charcoal); outline-offset: 3px; }
  .svc-btn span { transition: transform 0.18s ease; }
  .svc-btn:hover span { transform: translateX(3px); }

  /* The per-section CTA was removed, so whatever now ends the text column
     (paragraph or bullet list) would leave its bottom margin as dead trailing
     space inside the padded column. Zero it on the last child only. */
  .svc-copy-inner > :last-child { margin-bottom: 0; }

  /* ── Big Services card grid ─────────────────────────────────────────────
     The accent tokens live on .svc-row, and these cards sit outside it, so
     they declare the same values locally rather than introducing new ones. */
  .svc-card {
    --lime:     #0B0B0B;
    --bodygray: #9CA0A6;
  }
  /* ── Hero, matched to the homepage ──────────────────────────────────────
     `hero-h1` and `hero-copy` are scoped to Hero.astro (Astro adds a
     per-component attribute), so they are redefined here to give this hero the
     same treatment: the 2.1em top offset and the soft text-shadow.

     Deliberately WITHOUT the homepage's `white-space: nowrap`. That headline is
     33 characters; this one is 50, and forcing a single line overflows the
     container at 1024px, 1440px and 1920px. Letting it wrap keeps the same
     type scale without pushing text off-screen. */
  .hero-h1 {
    margin-top: 2.1em;
    max-width: none;
  }
  @media (max-width: 640px) {
    .hero-h1 { margin-top: 0; }
  }

  /* Page-only override for this longer headline (50 chars vs the homepage's
     33). A smaller clamp plus nowrap holds it on one line from 768px up. */
  .psx-hero-h1 {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    white-space: nowrap;
  }
  /* Below 768px one line would require ~10px type to fit, which is unreadable,
     so the headline wraps instead of shrinking past legibility. */
  @media (max-width: 767px) {
    .psx-hero-h1 {
      white-space: normal;
      font-size: clamp(1.5rem, 6vw, 2rem);
    }
  }
  /* Includes `p` because the subtext is a normal paragraph here, not an h2 —
     without it the copy would lose its shadow against the photo. */
  .hero-copy h1,
  .hero-copy h2,
  .hero-copy p {
    text-shadow: 0 2px 18px rgba(11, 11, 11, 0.55), 0 1px 3px rgba(11, 11, 11, 0.4);
  }

  /* Pull the hero copy left of the shared container gutter. container-big
     applies px-6 / lg:px-16 (24px / 64px) and is used site-wide, so it is left
     alone and trimmed here for this hero only. */
  .psx-hero-inner { padding-left: 8px; }
  @media (min-width: 1024px) {
    .psx-hero-inner { padding-left: 24px; }
  }

  /* Wider than the site's 1280px container-big so the two cards read close to
     edge-to-edge, with a small outer margin. Scoped to this page only. */
  .svc-wide {
    max-width: 1700px;
    margin: 0 auto;
    padding-left: 32px;
    padding-right: 32px;
  }

  .svc-card-media {
    position: relative;
    overflow: hidden;
    /* Taller than the previous 16/10 so each image fills more of its column.
       Fixed height rather than a ratio, so the two cards always align. */
    height: 500px;
    background: var(--line);
  }
  .svc-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Subject sits high in this frame — anchor the crop to the top. */
  .svc-card-img--top { object-position: top; }

  /* Thin accent rule directly under the image. */
  .svc-card-rule {
    display: block;
    width: 100%;
    height: 3px;
    background: var(--lime);
    margin-bottom: 22px;
  }

  .svc-card-para {
    white-space: pre-line;  /* keeps the supervision card's paragraph break */
    color: var(--bodygray);
  }

  .svc-card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: gap 0.18s ease;
  }
  .svc-card-link:hover { gap: 12px; }

  /* Step the image height down with the viewport. These replace the old
     aspect-ratio rule, which would otherwise fight the fixed height above. */
  @media (max-width: 1279px) {
    .svc-card-media { height: 420px; }
  }
  @media (max-width: 767px) {
    .svc-wide { padding-left: 24px; padding-right: 24px; }
    .svc-card-media { height: 320px; }
  }

  /* ── Tablet ────────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .svc-copy { padding: 64px 5vw; }
    .svc-media { min-height: 460px; }
  }

  /* ── Mobile: one column per row, image on top, full width ──────────────── */
  @media (max-width: 820px) {
    .svc-row,
    .svc-row--reverse {
      grid-template-columns: 1fr;
    }
    /* Reset the desktop swap so source order (image → text) wins. */
    .svc-row--reverse .svc-media,
    .svc-row--reverse .svc-copy {
      grid-column: 1;
      grid-row: auto;
    }
    .svc-media { min-height: 300px; }
    .svc-copy { padding: 52px 24px 60px; }
    .svc-copy-inner { max-width: none; }
    .svc-para { max-width: 100%; }
    .svc-btn { width: 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-btn, .svc-btn span { transition: none; }
  }
</style>
