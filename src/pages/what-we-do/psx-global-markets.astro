---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutBIG from '../../components/AboutBIG.astro';
import Button from '../../components/Button.astro';
import ContactCTA from '../../components/ContactCTA.astro';

// §11 service copy — verbatim. Kept as constants so the prose stays byte-identical
// while each section below gets its own bespoke layout.
const shariahEquitiesBody = `Our Shariah-compliant boutique equities business combines disciplined investment research, rigorous Islamic screening, and deep expertise to deliver tailored halal investment solutions for institutional and individual investors. We work closely with our clients to understand their investment objectives and provide a high-touch, bespoke advisory experience designed to align capital deployment with their financial goals and risk profile. Across Swing, Positional, and Long-Term proprietary strategies, we identify opportunities in Shariah-compliant businesses supported by strong fundamentals, favourable technical trends, and constructive market sentiment. Through disciplined portfolio construction, proactive risk management, and a focus on wealth creation, we seek to deliver maximum returns and sustainable value for our global clientele.`;
const portfolioAdvisoryBody = `Our Portfolio Advisory services provide tailored investment solutions focused on opportunities within the Pakistan Stock Exchange (PSX). Leveraging bespoke analysis combined with market insights and structured portfolio construction, we help investors capitalize on market opportunities and achieve their tactical capital-growth objectives. Our investment philosophy is founded on a strong alignment of interests with our clients. Designed for self-directed investors who execute transactions independently, our advisory approach provides timely market intelligence, actionable recommendations, and strategic guidance to navigate market volatility with confidence.`;
const portfolioManagementBody = `Our Portfolio Management services provide a fully managed, end-to-end investment experience for clients who prefer to delegate investment decisions and execution to our portfolio and wealth managers. Through a discretionary mandate, we oversee portfolio strategy, instrument selection, trade execution, and risk management, ensuring capital is actively managed in line with each client's objectives and risk profile. Access to this white-glove service is subject to a minimum portfolio size requirement; contact our Client Care team for eligibility details.`;
const greenSukuksBody = `Whether our clients seek capital preservation, regular income, or long-term growth, our curated Sukuk offerings provide access to high-quality sovereign and corporate issuers. Combining Shariah compliance with competitive returns, our primary and secondary Sukuk desk serves as an effective platform for building wealth through ethically structured fixed-income alternatives. We are proud to be among the pioneers championing Green Sukuk as a sustainable financing solution for Pakistan. By connecting investors with ESG-aligned opportunities, we facilitate capital deployment into renewable energy, sustainable infrastructure, and climate-resilient projects — delivering attractive outcomes while supporting Pakistan's transition to a more sustainable, resilient economy.`;
const transactionServicesBody = `Our Transaction Services platform provides seamless market access through RAAST ID integration, Special Convertible Rupee Accounts (SCRA), and Roshan Digital Account (RDA)-linked Roshan Equity Investment Accounts (REIA). Designed for both domestic and overseas investors, we offer efficient trade execution, swift settlement, and comprehensive post-trade support across equities, Sukuk, and other products. Combining secure, encrypted infrastructure with dedicated client care, we facilitate transactions for retail, corporate, and institutional clients with speed, transparency, and operational excellence. Supported by strong relationships across Pakistan's leading financial institutions, we deliver a secure and reliable cash-management and settlement experience.`;
const blackstoneIntelBody = `We operate our dedicated WhatsApp channel, Blackstone Intel, to promote financial literacy and awareness of investment opportunities within the PSX. Through educational content, market insights, and investor-awareness initiatives, we help aspiring investors better understand capital markets and make informed decisions. Join free of charge for regular market updates and investor coaching.`;
const blackstoneInvestmentsBody = `For clients and premium members seeking exclusive research, proprietary insights, and market-leading advisory, we invite you to join our dedicated WhatsApp group, Blackstone Investments. Contact our Client Care team to learn about membership benefits and enrolment.`;

// Factual capability rails — every label + descriptor is drawn from the Transaction Services copy above.
const rails = [
  { name: 'RAAST ID', desc: 'Seamless market access' },
  { name: 'SCRA', desc: 'Special Convertible Rupee Accounts' },
  { name: 'RDA', desc: 'Roshan Digital Account' },
  { name: 'REIA', desc: 'Roshan Equity Investment Accounts' },
];
---

<BaseLayout
  title="PSX & Global Markets | Black Stone Islamic Global"
  description="Shariah-compliant equities, green sukuks, and transaction services across the Pakistan Stock Exchange and global markets."
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="relative flex items-start bg-ink" style="min-height: calc(100vh - var(--header-h));">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('https://images.unsplash.com/photo-1761233138997-44d9b002a08f?auto=format&fit=crop&w=2400&q=80');"
      ></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(110deg, rgba(11,11,11,0.55) 0%, rgba(11,11,11,0.18) 55%, rgba(11,11,11,0.02) 100%);"
      ></div>
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-acid"></div>
    </div>

    <div class="relative z-10 container-big w-full pt-12 pb-12">
      <div class="max-w-3xl">
        <p class="label text-acid mb-6">PSX &amp; Global Markets</p>
        <h1
          class="font-serif font-normal text-white mb-6 leading-[1.05]"
          style="font-size: clamp(34px, 5.5vw, 60px);"
        >
          Halal Capital.<br/>Disciplined Research.<br/>Global Markets.
        </h1>
        <p class="font-sans text-white/80 text-lg leading-relaxed mb-8 max-w-xl">
          Our Shariah-compliant boutique equities business delivers tailored halal investment solutions — from bespoke PSX portfolio strategies and Green Sukuk to seamless transaction services for domestic and overseas investors.
        </p>
        <Button variant="acid" href="#shariah-equities">Explore What We Do</Button>
      </div>
    </div>

    <div class="absolute bottom-8 right-16 hidden lg:flex flex-col items-center gap-2 opacity-40" aria-hidden="true">
      <span class="font-sans text-xs text-white tracking-widest uppercase">Scroll</span>
      <div class="w-px h-12 bg-white/60"></div>
    </div>
  </section>


  <!-- ── Pillar intro ─────────────────────────────────────────────────────── -->
  <section class="bg-paper pt-section pb-8" id="psx-global-markets">
    <div class="container-big">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 border-b border-line pb-10">
        <div>
          <p class="label mb-4">What We Do</p>
          <h2 class="font-serif font-normal text-ink" style="font-size: clamp(32px, 4vw, 48px); line-height: 1.1; max-width: 720px;">
            How We Make Things Happen for You
          </h2>
        </div>
        <p class="font-sans text-base text-stone leading-relaxed max-w-md lg:text-right">
          A boutique built on disciplined research, rigorous Islamic screening, and deep PSX and global market expertise — delivering tailored halal solutions for institutional and individual investors.
        </p>
      </div>
    </div>
  </section>


  <!-- ── 01 · Shariah Equities — feature + sub-service cards ───────────────── -->
  <section id="shariah-equities" class="bg-paper pb-20 lg:pb-28 pt-14 lg:pt-16">
    <div class="container-big">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-7">
          <div class="aspect-[16/10] overflow-hidden bg-line">
            <img
              src="https://images.unsplash.com/photo-1612178991541-b48cc8e92a4d?auto=format&fit=crop&w=1400&q=80"
              alt="Analyst reviewing equity research and market charts"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-sans text-xs font-bold tracking-[0.2em] text-ink">01</span>
            <span class="h-px w-10 bg-acid"></span>
          </div>
          <h3 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(28px, 3vw, 40px); line-height: 1.15;">
            Shariah Equities
          </h3>
          <p class="font-sans text-base text-stone leading-relaxed">{shariahEquitiesBody}</p>
        </div>
      </div>

      <!-- Sub-service cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-14 lg:mt-16">
        <div class="border border-line p-8 lg:p-10 hover:border-ink transition-colors">
          <p class="label mb-4">Portfolio Advisory</p>
          <p class="font-sans text-sm text-stone leading-relaxed">{portfolioAdvisoryBody}</p>
        </div>
        <div class="border border-line bg-mist p-8 lg:p-10">
          <p class="label mb-4">Portfolio Management</p>
          <p class="font-sans text-sm text-stone leading-relaxed">{portfolioManagementBody}</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ── 02 · Green Sukuks — full-bleed photographic feature ───────────────── -->
  <section id="green-sukuks" class="relative bg-ink overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1509391366360-2e959784a276?auto=format&fit=crop&w=2000&q=80"
        alt=""
        class="w-full h-full object-cover opacity-55"
        loading="lazy"
      />
      <div class="absolute inset-0" style="background: linear-gradient(100deg, rgba(11,11,11,0.88) 0%, rgba(11,11,11,0.60) 52%, rgba(11,11,11,0.25) 100%);"></div>
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-acid"></div>
    </div>
    <div class="container-big relative py-24 lg:py-32">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-5">
          <span class="font-sans text-xs font-bold tracking-[0.2em] text-white">02</span>
          <span class="h-px w-10 bg-acid"></span>
        </div>
        <h3 class="font-serif font-normal text-white mb-6" style="font-size: clamp(28px, 3.4vw, 44px); line-height: 1.1;">
          Green Sukuks
        </h3>
        <p class="font-sans text-white/85 text-base lg:text-lg leading-relaxed">{greenSukuksBody}</p>
      </div>
    </div>
  </section>


  <!-- ── 03 · Transaction Services — split + capability rails ──────────────── -->
  <section id="transaction-services" class="bg-mist py-20 lg:py-28">
    <div class="container-big">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-6 lg:order-2">
          <div class="aspect-[4/3] overflow-hidden bg-line">
            <img
              src="https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1200&q=80"
              alt="Secure digital banking and mobile transaction technology"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
        <div class="lg:col-span-6 lg:order-1">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-sans text-xs font-bold tracking-[0.2em] text-ink">03</span>
            <span class="h-px w-10 bg-acid"></span>
          </div>
          <h3 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(26px, 2.8vw, 38px); line-height: 1.2;">
            Transaction Services
          </h3>
          <p class="font-sans text-base text-stone leading-relaxed">{transactionServicesBody}</p>
        </div>
      </div>

      <!-- Access rails -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-10 mt-14 lg:mt-16">
        {rails.map((r) => (
          <div>
            <div class="h-0.5 w-10 bg-acid mb-4"></div>
            <p class="font-serif font-normal text-ink text-xl lg:text-2xl mb-1">{r.name}</p>
            <p class="font-sans text-xs text-stone leading-snug">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ── 04 · Blackstone Intel — dark community CTA band ───────────────────── -->
  <section id="blackstone-intel" class="relative bg-ink overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?auto=format&fit=crop&w=1800&q=80"
        alt=""
        class="w-full h-full object-cover opacity-20"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-ink/70"></div>
    </div>
    <div class="container-big relative py-20 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-8">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-sans text-xs font-bold tracking-[0.2em] text-white">04</span>
            <span class="h-px w-10 bg-acid"></span>
          </div>
          <p class="label text-acid mb-4">WhatsApp Channel · Free to Join</p>
          <h3 class="font-serif font-normal text-white mb-6" style="font-size: clamp(26px, 2.8vw, 38px); line-height: 1.2;">
            Blackstone Intel
          </h3>
          <p class="font-sans text-white/80 text-base leading-relaxed max-w-2xl">{blackstoneIntelBody}</p>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <Button variant="acid" href="/contact">Join via Client Care →</Button>
        </div>
      </div>
    </div>
  </section>


  <!-- ── 05 · Blackstone Investments — bordered membership card ─────────────── -->
  <section id="blackstone-investments" class="bg-paper py-20 lg:py-28">
    <div class="container-big">
      <div class="border border-line grid grid-cols-1 lg:grid-cols-12">
        <div class="lg:col-span-5 order-1">
          <div class="aspect-[4/3] lg:h-full lg:min-h-[420px] overflow-hidden bg-line">
            <img
              src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?auto=format&fit=crop&w=1200&q=80"
              alt="Private advisory meeting for premium members"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
        <div class="lg:col-span-7 order-2 p-8 lg:p-14 flex flex-col justify-center">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-sans text-xs font-bold tracking-[0.2em] text-ink">05</span>
            <span class="h-px w-10 bg-acid"></span>
          </div>
          <p class="label mb-4">Premium Membership · WhatsApp Group</p>
          <h3 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(26px, 2.8vw, 38px); line-height: 1.2;">
            Blackstone Investments
          </h3>
          <p class="font-sans text-base text-stone leading-relaxed mb-8">{blackstoneInvestmentsBody}</p>
          <div>
            <Button variant="outline" href="/contact">Enquire About Membership →</Button>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ── About BIG ──────────────────────────────────────────────────────── -->
  <AboutBIG bgClass="bg-mist" />

  <ContactCTA
    headline="Ready to Invest in Halal Markets?"
    subtext="Our PSX and global markets team will design a bespoke Shariah-compliant portfolio strategy aligned with your goals."
    image="https://images.unsplash.com/photo-1651341050677-24dba59ce0fd?auto=format&fit=crop&w=1200&q=80"
    imageAlt="Live trading screens — PSX and global markets"
  />

</BaseLayout>
