---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import CurtainRevealCard from '../../components/CurtainRevealCard.astro';

// Client copy deck — verbatim. Kept as constants so the prose stays byte-identical
// while each section below gets its own bespoke layout.
const shariahEquitiesBody = `Our equities business provides bespoke and Shariah enabled investment solutions for clients seeking sophisticated access to PSX and global capital markets. Combining proprietary strategies, deep-dive research, and market psychology, we identify high-conviction, high-return opportunities.

Through disciplined capital allocation, dynamic portfolio construction, and proactive risk management, our approach is designed to compound wealth, preserve capital, and pursue superior returns, creating sustainable wealth for our growing clientele.`;
const portfolioConsultancyBody = `Our portfolio consultancy services are designed for self-directed investors, providing timely trading and investment calls, and regular follow-ups. Combining market intelligence with actionable insights, we help clients navigate volatility, deploy capital decisively, and pursue growth.`;
const portfolioSupervisionBody = `Our portfolio supervision is designed for trusted clients who prefer professional delegation. We provide bespoke strategies aligned with each client's risk and return objectives.

Our specialists actively monitor and optimise portfolios to preserve and grow capital. This white-glove service is subject to minimum portfolio requirements and eligibility criteria.`;
const greenSukuksBody = `Through primary and secondary markets, our Sukuk desk provides access to high-quality sovereign and corporate issuers, offering faith based fixed income solutions to our respected clients.

We also connect minimum A-rated Green Sukuks with ESG conscious investors, providing direct access to sustainable instruments in energy, and flood control infrastructure of Pakistan.`;
const transactionServicesBody = `Our bank enabled transaction services platform provides seamless and secure market access through RAAST ID, SCRA, IPS and RDA-linked REIA solutions for domestic and overseas investors. We facilitate efficient execution, settlement, and post-trade support across all service lines.`;
const blackstoneIntelBody = `We operate our dedicated WhatsApp channel, Blackstone Intel, to promote financial literacy and intelligent investing in capital markets. We coach and mentor aspiring investors better understand risk and rewards, and make informed decisions.

Join it for free and learn before earn`;

// Factual capability rails — every label is drawn from the Transaction Services copy above.
const rails = [
  { name: 'RAAST ID', desc: 'Seamless market access' },
  { name: 'SCRA', desc: 'Special Convertible Rupee Account' },
  { name: 'IPS', desc: 'Investor Portfolio Securities' },
  { name: 'REIA', desc: 'RDA-linked Roshan Equity Investment Account' },
];
---

<BaseLayout
  title="PSX & Global Markets | Blackstone Islamic Global"
  description="Shariah-compliant equities, green sukuks, and transaction services across the Pakistan Stock Exchange and global markets."
  theme="teal"
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="relative flex items-start bg-ink" style="min-height: calc(100vh - var(--header-h));">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('https://images.unsplash.com/photo-1761233138997-44d9b002a08f?auto=format&fit=crop&w=2400&q=80');"
      ></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(110deg, rgba(11,11,11,0.55) 0%, rgba(11,11,11,0.18) 55%, rgba(11,11,11,0.02) 100%);"
      ></div>
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-acid"></div>
    </div>

    <div class="relative z-10 container-big w-full pt-12 pb-12">
      <div class="max-w-3xl">
        <p class="label text-acid mb-6">PSX &amp; Global Markets</p>
        <h1
          class="font-serif font-normal text-white mb-6 leading-[1.05]"
          style="font-size: clamp(34px, 5.5vw, 60px);"
        >
          Tailored Strategy | Smart Execution | Timely Exist
        </h1>
        <p class="font-sans text-white/80 text-lg leading-relaxed mb-8 max-w-xl">
          Our equities business combines niche research, rigorous analysis, and deep market expertise to deliver tailored, timely and independent investment solutions for our distinguished investors.
        </p>
        <Button variant="acid" href="#shariah-equities">Explore What We Do</Button>
      </div>
    </div>

    <div class="absolute bottom-8 right-16 hidden lg:flex flex-col items-center gap-2 opacity-40" aria-hidden="true">
      <span class="font-sans text-xs text-white tracking-widest uppercase">Scroll</span>
      <div class="w-px h-12 bg-white/60"></div>
    </div>
  </section>


  <!-- ── Pillar intro ─────────────────────────────────────────────────────── -->
  <section class="bg-paper pt-section pb-8" id="psx-global-markets">
    <div class="container-big">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 border-b border-line pb-10">
        <div>
          <p class="label mb-4">What We Do</p>
          <h2 class="font-serif font-normal text-ink" style="font-size: clamp(32px, 4vw, 48px); line-height: 1.1; max-width: 720px;">
            How We Make Things Happen for You
          </h2>
        </div>
        <p class="font-sans text-base text-stone leading-relaxed max-w-md lg:text-right">
          Our equities business combines niche research, rigorous analysis, and deep market expertise to deliver tailored, timely and independent investment solutions for our distinguished investors.
        </p>
      </div>
    </div>
  </section>


  <!-- ── 01 · Shariah Equities — feature + sub-service cards ───────────────── -->
  <section id="shariah-equities" class="bg-paper pb-20 lg:pb-28 pt-14 lg:pt-16">
    <div class="container-big">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-7">
          <div class="aspect-[16/10] overflow-hidden bg-line">
            <img
              src="/images/psx-shariah-equities.jpg"
              alt="Advisors reviewing equity research and market charts together"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-sans text-xs font-bold tracking-[0.2em] text-ink">01</span>
            <span class="h-px w-10 bg-acid"></span>
          </div>
          <h3 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(28px, 3vw, 40px); line-height: 1.15;">
            Shariah Equities
          </h3>
          <p class="font-sans text-base text-stone leading-relaxed">{shariahEquitiesBody}</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ── Portfolio Consultancy — big image + overlapping editorial card ────────── -->
  <section id="portfolio-consultancy" class="bg-paper pb-20 lg:pb-28">
    <div class="container-big">
      <div class="flex items-center gap-3 mb-10">
        <span class="font-sans text-xs font-bold tracking-[0.2em] text-ink">Shariah Equities</span>
        <span class="h-px w-10 bg-acid"></span>
        <span class="font-sans text-xs font-semibold uppercase tracking-widest text-stone">Self-Directed</span>
      </div>
      <div class="relative">
        <div class="lg:w-[62%] lg:ml-auto aspect-[16/10] overflow-hidden bg-line">
          <img
            src="/images/psx-portfolio-consultancy.jpg"
            alt="Investor reviewing live market charts on a tablet during an advisory meeting"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="relative lg:absolute lg:top-1/2 lg:left-0 lg:-translate-y-1/2 lg:w-[46%] bg-paper border border-line p-8 lg:p-12 -mt-12 mx-4 lg:mx-0 lg:mt-0">
          <h3 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(26px, 2.8vw, 38px); line-height: 1.2;">
            Portfolio Consultancy
          </h3>
          <p class="font-sans text-sm lg:text-base text-stone leading-relaxed">{portfolioConsultancyBody}</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ── Portfolio Supervision — curtain-reveal card ────────────────────────── -->
  <section id="portfolio-supervision" class="bg-mist py-20 lg:py-28">
    <div class="container-big">
      <div class="flex items-center gap-3 mb-10">
        <span class="font-sans text-xs font-bold tracking-[0.2em] text-ink">Shariah Equities</span>
        <span class="h-px w-10 bg-acid"></span>
        <span class="font-sans text-xs font-semibold uppercase tracking-widest text-stone">Discretionary Mandate</span>
      </div>
      <CurtainRevealCard
        eyebrow="White-Glove Service"
        title="Portfolio Supervision"
        description={portfolioSupervisionBody}
        image="/images/psx-portfolio-supervision.jpg"
        imageAlt="Portfolio manager discussing performance charts with a client"
        imagePosition="top"
        href="/contact"
        ctaLabel="Enquire"
      />
      <p class="font-sans text-xs text-stone mt-4 lg:hidden">Full details shown below.</p>
      <p class="hidden lg:block font-sans text-xs text-stone mt-4">Hover to reveal the full mandate.</p>
    </div>
  </section>


  <!-- ── 02 · Sukuks and Green Sukuks — full-bleed photographic feature ───────────────── -->
  <section id="green-sukuks" class="relative bg-ink overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1509391366360-2e959784a276?auto=format&fit=crop&w=2000&q=80"
        alt=""
        class="w-full h-full object-cover opacity-55"
        loading="lazy"
      />
      <div class="absolute inset-0" style="background: linear-gradient(100deg, rgba(11,11,11,0.88) 0%, rgba(11,11,11,0.60) 52%, rgba(11,11,11,0.25) 100%);"></div>
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-acid"></div>
    </div>
    <div class="container-big relative py-24 lg:py-32">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-5">
          <span class="font-sans text-xs font-bold tracking-[0.2em] text-white">02</span>
          <span class="h-px w-10 bg-acid"></span>
        </div>
        <h3 class="font-serif font-normal text-white mb-6" style="font-size: clamp(28px, 3.4vw, 44px); line-height: 1.1;">
          Sukuks and Green Sukuks
        </h3>
        <p class="font-sans text-white/85 text-base lg:text-lg leading-relaxed">{greenSukuksBody}</p>
      </div>
    </div>
  </section>


  <!-- ── 03 · Transaction Services — split + capability rails ──────────────── -->
  <section id="transaction-services" class="bg-mist py-20 lg:py-28">
    <div class="container-big">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-6 lg:order-1">
          <div class="aspect-[4/3] overflow-hidden bg-line">
            <img
              src="/images/psx-transaction-services.jpg"
              alt="Interwoven strands of coloured thread — connected settlement and transaction rails"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
        <div class="lg:col-span-6 lg:order-2">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-sans text-xs font-bold tracking-[0.2em] text-ink">03</span>
            <span class="h-px w-10 bg-acid"></span>
          </div>
          <h3 class="font-serif font-normal text-ink mb-6" style="font-size: clamp(26px, 2.8vw, 38px); line-height: 1.2;">
            Transaction Services
          </h3>
          <p class="font-sans text-base text-stone leading-relaxed">{transactionServicesBody}</p>
        </div>
      </div>

      <!-- Access rails -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-10 mt-14 lg:mt-16">
        {rails.map((r) => (
          <div>
            <div class="h-0.5 w-10 bg-acid mb-4"></div>
            <p class="font-serif font-normal text-ink text-xl lg:text-2xl mb-1">{r.name}</p>
            <p class="font-sans text-xs text-stone leading-snug">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ── 04 · Blackstone Intel — dark community CTA band ───────────────────── -->
  <section id="blackstone-intel" class="relative bg-ink overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?auto=format&fit=crop&w=1800&q=80"
        alt=""
        class="w-full h-full object-cover opacity-20"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-ink/70"></div>
    </div>
    <div class="container-big relative py-20 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-8">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-sans text-xs font-bold tracking-[0.2em] text-white">04</span>
            <span class="h-px w-10 bg-acid"></span>
          </div>
          <p class="label text-acid mb-4">WhatsApp Channel · Free to Join</p>
          <h3 class="font-serif font-normal text-white mb-6" style="font-size: clamp(26px, 2.8vw, 38px); line-height: 1.2;">
            Blackstone Intel
          </h3>
          <p class="font-sans text-white/80 text-base leading-relaxed max-w-2xl">{blackstoneIntelBody}</p>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <Button variant="acid" href="/contact">Join via Client Care →</Button>
        </div>
      </div>
    </div>
  </section>


</BaseLayout>
