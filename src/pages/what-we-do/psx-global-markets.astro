---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';

// ── Body section data ──────────────────────────────────────────────────────
// One entry per row, rendered by the shared alternating two-column pattern.
//
// `body` is the client copy deck, verbatim, and `headingLines` carries each
// section's original service-name title. Bullet lists appear only where one
// existed before the layout change.
const sections = [
  {
    id: 'shariah-equities',
    eyebrow: '01',
    headingLines: ['Shariah Equities'],
    body: `Our equities business provides bespoke and Shariah enabled investment solutions for clients seeking sophisticated access to PSX and global capital markets. Combining proprietary strategies, deep-dive research, and market psychology, we identify high-conviction, high-return opportunities.

Through disciplined capital allocation, dynamic portfolio construction, and proactive risk management, our approach is designed to compound wealth, preserve capital, and pursue superior returns, creating sustainable wealth for our growing clientele.`,
    cta: { label: 'Explore Shariah Equities', href: '/contact' },
    image: '/images/psx-shariah-equities.jpg',
    imageAlt: 'Advisors reviewing equity research and market charts together',
  },
  {
    id: 'portfolio-consultancy',
    eyebrow: 'Shariah Equities · Self-Directed',
    headingLines: ['Portfolio Consultancy'],
    body: `Our portfolio consultancy services are designed for self-directed investors, providing timely trading and investment calls, and regular follow-ups. Combining market intelligence with actionable insights, we help clients navigate volatility, deploy capital decisively, and pursue growth.`,
    cta: { label: 'Explore Portfolio Consultancy', href: '/contact' },
    image: '/images/psx-portfolio-consultancy.jpg',
    imageAlt: 'Investor reviewing live market charts on a tablet during an advisory meeting',
  },
  {
    id: 'portfolio-supervision',
    eyebrow: 'Shariah Equities · Discretionary Mandate',
    headingLines: ['Portfolio Supervision'],
    body: `Our portfolio supervision is designed for trusted clients who prefer professional delegation. We provide bespoke strategies aligned with each client's risk and return objectives.

Our specialists actively monitor and optimise portfolios to preserve and grow capital. This white-glove service is subject to minimum portfolio requirements and eligibility criteria.`,
    cta: { label: 'Enquire', href: '/contact' },
    image: '/images/psx-portfolio-supervision.jpg',
    imageAlt: 'Portfolio manager discussing performance charts with a client',
    imageTop: true,
  },
  {
    id: 'green-sukuks',
    eyebrow: '02',
    headingLines: ['Sukuks and Green Sukuks'],
    body: `Through primary and secondary markets, our Sukuk desk provides access to high-quality sovereign and corporate issuers, offering faith based fixed income solutions to our respected clients.

We also connect minimum A-rated Green Sukuks with ESG conscious investors, providing direct access to sustainable instruments in energy, and flood control infrastructure of Pakistan.`,
    cta: { label: 'Explore Sukuks', href: '/contact' },
    image: 'https://images.unsplash.com/photo-1509391366360-2e959784a276?auto=format&fit=crop&w=2000&q=80',
    imageAlt: '',
  },
  {
    id: 'transaction-services',
    eyebrow: '03',
    headingLines: ['Transaction Services'],
    body: `Our bank enabled transaction services platform provides seamless and secure market access through RAAST ID, SCRA, IPS and RDA-linked REIA solutions for domestic and overseas investors. We facilitate efficient execution, settlement, and post-trade support across all service lines.`,
    // Pre-existing capability rails — these four labels were on the page before
    // the layout change, so they stay as the section's bullet list.
    bullets: [
      'RAAST ID',
      'SCRA',
      'IPS',
      'REIA',
    ],
    cta: { label: 'Explore Transaction Services', href: '/contact' },
    image: '/images/psx-transaction-services.jpg',
    imageAlt: 'Interwoven strands of coloured thread — connected settlement and transaction rails',
  },
];


// Blackstone Intel closes the page as a distinct dark full-bleed banner rather
// than an alternating row — copy verbatim from the client deck.
const blackstoneIntelBody = `We operate our dedicated WhatsApp channel, Blackstone Intel, to promote financial literacy and intelligent investing in capital markets. We coach and mentor aspiring investors better understand risk and rewards, and make informed decisions.

Join it for free and learn before earn`;
---

<BaseLayout
  title="PSX & Global Markets | Blackstone Islamic Global"
  description="Shariah-compliant equities, green sukuks, and transaction services across the Pakistan Stock Exchange and global markets."
  theme="teal"
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="relative flex items-start bg-ink" style="min-height: calc(100vh - var(--header-h));">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('https://images.unsplash.com/photo-1761233138997-44d9b002a08f?auto=format&fit=crop&w=2400&q=80');"
      ></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(110deg, rgba(11,11,11,0.55) 0%, rgba(11,11,11,0.18) 55%, rgba(11,11,11,0.02) 100%);"
      ></div>
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-acid"></div>
    </div>

    <div class="relative z-10 container-big w-full pt-12 pb-12">
      <div class="max-w-3xl">
        <p class="label text-acid mb-6">PSX &amp; Global Markets</p>
        <h1
          class="font-serif font-normal text-white mb-6 leading-[1.05]"
          style="font-size: clamp(34px, 5.5vw, 60px);"
        >
          Tailored Strategy | Smart Execution | Timely Exist
        </h1>
        <p class="font-sans text-white/80 text-lg leading-relaxed mb-8 max-w-xl">
          Our equities business combines niche research, rigorous analysis, and deep market expertise to deliver tailored, timely and independent investment solutions for our distinguished investors.
        </p>
        <Button variant="acid" href="#shariah-equities">Explore What We Do</Button>
      </div>
    </div>

    <div class="absolute bottom-8 right-16 hidden lg:flex flex-col items-center gap-2 opacity-40" aria-hidden="true">
      <span class="font-sans text-xs text-white tracking-widest uppercase">Scroll</span>
      <div class="w-px h-12 bg-white/60"></div>
    </div>
  </section>


  <!-- ── Pillar intro ─────────────────────────────────────────────────────── -->
  <section class="bg-paper pt-section pb-8" id="psx-global-markets">
    <div class="container-big">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 border-b border-line pb-10">
        <div>
          <p class="label mb-4">What We Do</p>
          <h2 class="font-serif font-normal text-ink" style="font-size: clamp(32px, 4vw, 48px); line-height: 1.1; max-width: 720px;">
            How We Make Things Happen for You
          </h2>
        </div>
        <p class="font-sans text-base text-stone leading-relaxed max-w-md lg:text-right">
          Our equities business combines niche research, rigorous analysis, and deep market expertise to deliver tailored, timely and independent investment solutions for our distinguished investors.
        </p>
      </div>
    </div>
  </section>


  {/*
    Body rows — one shared alternating two-column pattern.
    The image column is full-bleed: edge-to-edge, full row height, no padding or
    radius. The text column is generously padded, vertically centred and
    left-aligned. Odd rows place the image left (row sits on white); even rows
    place it right (row sits on cream). Each row stacks to one column on mobile,
    image first.
  */}
  {sections.map((s, i) => {
    const imageRight = i % 2 === 1;
    return (
      <section
        id={s.id}
        class:list={['svc-row', imageRight && 'svc-row--reverse', imageRight && 'svc-row--cream']}
      >
        <div class="svc-media">
          <img
            src={s.image}
            alt={s.imageAlt}
            class:list={['svc-img', s.imageTop && 'svc-img--top']}
            loading="lazy"
          />
        </div>
        <div class="svc-copy">
          <div class="svc-copy-inner">
            <p class="svc-eyebrow">{s.eyebrow}</p>
            <h2 class="svc-heading">
              {s.headingLines.map((line, n) => (
                <>{n > 0 && <br />}{line}</>
              ))}
            </h2>
            <p class="svc-para">{s.body}</p>
            {s.bullets && s.bullets.length > 0 && (
              <ul class="svc-list">
                {s.bullets.map((b) => (
                  <li><span class="svc-dot" aria-hidden="true"></span><span>{b}</span></li>
                ))}
              </ul>
            )}
            <a class="svc-btn" href={s.cta.href}>
              {s.cta.label} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    );
  })}


  {/* ── 04 · Blackstone Intel — dark full-bleed closing banner ─────────────
      Deliberately off-pattern: a full-width dark band with the chart image
      behind it, closing the page rather than continuing the alternation. */}
  <section id="blackstone-intel" class="relative bg-ink overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?auto=format&fit=crop&w=1800&q=80"
        alt=""
        class="w-full h-full object-cover opacity-20"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-ink/70"></div>
    </div>
    <div class="container-big relative py-20 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-8">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-sans text-xs font-bold tracking-[0.2em] text-white">04</span>
            <span class="h-px w-10 bg-acid"></span>
          </div>
          <p class="label text-acid mb-4">WhatsApp Channel · Free to Join</p>
          <h2 class="font-serif font-normal text-white mb-6" style="font-size: clamp(26px, 2.8vw, 38px); line-height: 1.2;">
            Blackstone Intel
          </h2>
          <p class="font-sans text-white/80 text-base leading-relaxed max-w-2xl" style="white-space: pre-line;">{blackstoneIntelBody}</p>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <Button variant="acid" href="/contact">Join via Client Care →</Button>
        </div>
      </div>
    </div>
  </section>


</BaseLayout>

<style>
  /* ──────────────────────────────────────────────────────────────────────────
     Alternating full-bleed two-column row.

     Page-scoped (Astro adds a per-component attribute), so the global header,
     footer and every other page are untouched. The reference's lime accent is a
     SEPARATE token (--lime) — the header/footer read --acid and keep their teal.
     ────────────────────────────────────────────────────────────────────────── */
  .svc-row {
    --lime:      #D8FF3C;
    --charcoal:  #2B2B2E;
    --eyebrow:   #8C939E;
    --bodygray:  #9CA0A6;
    --cream:     #F3F4ED;

    display: grid;
    grid-template-columns: 1fr 1fr;   /* ~50/50 */
    align-items: stretch;
    background: #FFFFFF;
  }
  /* Image right → the row sits on cream (matches the reference rhythm). */
  .svc-row--cream { background: var(--cream); }

  /* Source order is image-first so mobile stacks image → text with no extra
     rules; the desktop flip is done with explicit column placement. */
  .svc-row--reverse .svc-media { grid-column: 2; grid-row: 1; }
  .svc-row--reverse .svc-copy  { grid-column: 1; grid-row: 1; }

  /* ── Image column: edge-to-edge, full row height, no padding/radius ─────── */
  .svc-media {
    position: relative;
    overflow: hidden;
    min-height: 560px;
  }
  .svc-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }
  .svc-img--top { object-position: top; }

  /* ── Text column: generous padding, vertically centred, left-aligned ────── */
  .svc-copy {
    display: flex;
    align-items: center;
    text-align: left;
    padding: 88px 6vw;
    min-width: 0;
  }
  .svc-copy-inner { max-width: 560px; width: 100%; }

  /* 1 · Eyebrow — small, uppercase, wide tracking, slate gray */
  .svc-eyebrow {
    font-family: theme('fontFamily.sans');
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--eyebrow);
    margin: 0 0 22px;
  }

  /* 2 · Heading — serif, charcoal, one short phrase per line */
  .svc-heading {
    font-family: theme('fontFamily.serif');
    font-weight: 400;
    color: var(--charcoal);
    font-size: clamp(30px, 3.2vw, 44px);
    line-height: 1.16;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }

  /* 3 · Paragraph — gray, ~90% column width */
  .svc-para {
    font-family: theme('fontFamily.sans');
    font-size: 15px;
    line-height: 1.75;
    color: var(--bodygray);
    max-width: 90%;
    white-space: pre-line;  /* preserves the copy deck's paragraph breaks */
    margin: 0 0 28px;
  }

  /* 4 · Bullet list — small lime dot + gray label, tight spacing */
  .svc-list {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
  }
  .svc-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: theme('fontFamily.sans');
    font-size: 14px;
    line-height: 1.5;
    color: var(--bodygray);
    margin-bottom: 9px;
  }
  .svc-list li:last-child { margin-bottom: 0; }
  .svc-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
    margin-top: 7px;
  }

  /* 5 · CTA — lime fill, charcoal text, no border, trailing arrow */
  .svc-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--lime);
    color: var(--charcoal);
    border: none;
    border-radius: 2px;
    padding: 13px 24px;
    font-family: theme('fontFamily.sans');
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .svc-btn:hover { background: #C6EC2A; }
  .svc-btn:focus-visible { outline: 2px solid var(--charcoal); outline-offset: 3px; }
  .svc-btn span { transition: transform 0.18s ease; }
  .svc-btn:hover span { transform: translateX(3px); }

  /* ── Tablet ────────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .svc-copy { padding: 64px 5vw; }
    .svc-media { min-height: 460px; }
  }

  /* ── Mobile: one column per row, image on top, full width ──────────────── */
  @media (max-width: 820px) {
    .svc-row,
    .svc-row--reverse {
      grid-template-columns: 1fr;
    }
    /* Reset the desktop swap so source order (image → text) wins. */
    .svc-row--reverse .svc-media,
    .svc-row--reverse .svc-copy {
      grid-column: 1;
      grid-row: auto;
    }
    .svc-media { min-height: 300px; }
    .svc-copy { padding: 52px 24px 60px; }
    .svc-copy-inner { max-width: none; }
    .svc-para { max-width: 100%; }
    .svc-btn { width: 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-btn, .svc-btn span { transition: none; }
  }
</style>
