# Blackstone Islamic Global: Apache settings for cPanel hosting.
# Upload this file together with the rest of the site (it is hidden in most file lists).

Options -Indexes
DirectoryIndex index.html index.php

# Compress text assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Browser caching: long for images, video, fonts and the hashed /_astro files; none for pages.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>

# Optional: send everyone to HTTPS. Turn on only after an SSL certificate is active
# on the domain (cPanel > SSL/TLS Status), then remove the leading # on these lines.
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
